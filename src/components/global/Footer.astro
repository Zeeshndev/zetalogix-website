---
// src/components/global/Footer.astro
const currentYear = new Date().getFullYear();
---

<footer class="bg-[#02040a] border-t border-white/10 pt-16 pb-10">
	<div class="max-w-7xl mx-auto px-6 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-12 mb-14">
		<div class="lg:col-span-2">
			<a href="/" class="inline-block mb-5 rounded-md">
				<img
					src="/assets/Logo.webp"
					alt="Zetalogix home"
					width="150"
					height="44"
					loading="lazy"
					decoding="async"
					class="h-10 w-auto object-contain opacity-90 hover:opacity-100 transition-opacity duration-150"
				/>
			</a>
			<p class="text-slate-400 text-sm leading-relaxed mb-6 max-w-md">
				Zetalogix designs and develops web applications, mobile products and practical AI solutions. We help businesses turn complex requirements into software that is clear to use and easier to maintain.
			</p>
			<div class="space-y-1.5 text-sm text-slate-300">
				<p class="font-medium text-white">Pakistan-based. Working with businesses worldwide.</p>
				<address class="not-italic text-slate-400 text-xs leading-relaxed">
					Plot #10 G, Mini Commercial, Phase 7, Bahria Town, Rawalpindi, Pakistan
				</address>
				<p class="pt-1">
					<a
						href="mailto:info@zetalogix.com"
						class="text-cyan-400 hover:text-cyan-300 font-semibold transition-colors duration-150"
					>
						info@zetalogix.com
					</a>
				</p>
			</div>
		</div>

		<div>
			<h2 class="text-white font-bold mb-5 text-xs uppercase tracking-wider">Services</h2>
			<ul class="flex flex-col gap-3 text-slate-400 text-sm">
				<li>
					<a href="/services/web-development" class="hover:text-brand-accent transition-colors duration-150">
						Web Development
					</a>
				</li>
				<li>
					<a href="/services/mobile-development" class="hover:text-brand-accent transition-colors duration-150">
						Mobile App Development
					</a>
				</li>
				<li>
					<a href="/services/ai-solutions" class="hover:text-brand-accent transition-colors duration-150">
						AI &amp; Machine Learning
					</a>
				</li>
				<li>
					<a href="/services/saas-development" class="hover:text-brand-accent transition-colors duration-150">
						SaaS Development
					</a>
				</li>
				<li>
					<a href="/services/custom-software" class="hover:text-brand-accent transition-colors duration-150">
						Custom Software
					</a>
				</li>
				<li>
					<a href="/services/ui-ux-design" class="hover:text-brand-accent transition-colors duration-150">
						UI/UX Design
					</a>
				</li>
			</ul>
		</div>

		<div>
			<h2 class="text-white font-bold mb-5 text-xs uppercase tracking-wider">Company</h2>
			<ul class="flex flex-col gap-3 text-slate-400 text-sm">
				<li>
					<a href="/about" class="hover:text-brand-accent transition-colors duration-150">About</a>
				</li>
				<li>
					<a href="/portfolio" class="hover:text-brand-accent transition-colors duration-150">Our Work</a>
				</li>
				<li>
					<a href="/blog" class="hover:text-brand-accent transition-colors duration-150">Insights</a>
				</li>
				<li>
					<a href="/careers" class="hover:text-brand-accent transition-colors duration-150">Careers</a>
				</li>
				<li>
					<a href="/contact" class="hover:text-brand-accent transition-colors duration-150">Contact</a>
				</li>
			</ul>
		</div>

		<div>
			<h2 class="text-white font-bold mb-5 text-xs uppercase tracking-wider">Work With Us</h2>
			<ul class="flex flex-col gap-3 text-slate-400 text-sm">
				<li>
					<a href="/engagement/fixed-price" class="hover:text-brand-accent transition-colors duration-150">
						Fixed-Scope Projects
					</a>
				</li>
				<li>
					<a href="/engagement/dedicated-team" class="hover:text-brand-accent transition-colors duration-150">
						Dedicated Teams
					</a>
				</li>
				<li>
					<a href="/engagement/offshore" class="hover:text-brand-accent transition-colors duration-150">
						Offshore Delivery
					</a>
				</li>
			</ul>
		</div>
	</div>

	<div class="max-w-7xl mx-auto px-6 border-t border-white/10 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-400">
		<p>&copy; {currentYear} Zetalogix. All rights reserved.</p>
		<div class="flex flex-wrap gap-6">
			<a href="/privacy-policy" class="hover:text-white transition-colors duration-150">Privacy Policy</a>
			<a href="/terms-of-service" class="hover:text-white transition-colors duration-150">Terms of Service</a>
			<a href="/cookie-policy" class="hover:text-white transition-colors duration-150">Cookie Policy</a>
		</div>
	</div>
</footer>