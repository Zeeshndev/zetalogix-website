---
// src/components/global/Navbar.astro
---

<nav class="fixed w-full z-50 top-0 transition-all duration-300 bg-brand-dark/90 backdrop-blur-lg border-b border-white/5">
    <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between relative">
        
        <a href="/" class="font-heading font-bold text-2xl tracking-tighter text-white z-10">
            ZETA<span class="text-brand-accent">LOGIX</span>
        </a>

        <div class="hidden md:flex items-center gap-8 h-full">
            
            <div class="group h-full flex items-center cursor-pointer">
                <a href="/#services" class="text-sm font-semibold text-slate-300 group-hover:text-brand-accent transition-colors flex items-center gap-1">
                    Services
                    <svg class="w-4 h-4 transition-transform duration-300 group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                </a>
                
                <div class="absolute top-20 left-6 right-6 bg-[#0a0f1d] border border-white/10 rounded-2xl shadow-2xl p-10 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 translate-y-4 group-hover:translate-y-0 cursor-default">
                    <div class="grid grid-cols-3 gap-10">
                        <a href="/services/saas-development" class="group/item flex flex-col gap-3">
                            <div class="w-10 h-10 rounded-lg bg-red-500/10 border border-red-500/20 flex items-center justify-center text-red-400 group-hover/item:bg-red-500/20 transition-colors">
                                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" /></svg>
                            </div>
                            <h4 class="text-white font-bold text-sm group-hover/item:text-brand-accent transition-colors">SaaS Application Development</h4>
                            <p class="text-slate-400 text-xs leading-relaxed">We craft standard, reliable & efficient SaaS solutions that are market-ready and highly scalable.</p>
                        </a>
                        <a href="/services/custom-software" class="group/item flex flex-col gap-3">
                            <div class="w-10 h-10 rounded-lg bg-purple-500/10 border border-purple-500/20 flex items-center justify-center text-purple-400 group-hover/item:bg-purple-500/20 transition-colors">
                                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>
                            </div>
                            <h4 class="text-white font-bold text-sm group-hover/item:text-brand-accent transition-colors">Custom Software Development</h4>
                            <p class="text-slate-400 text-xs leading-relaxed">We leverage best software development practices in designing, building, and maintaining robust systems.</p>
                        </a>
                        <a href="/services/mobile-development" class="group/item flex flex-col gap-3">
                            <div class="w-10 h-10 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 group-hover/item:bg-emerald-500/20 transition-colors">
                                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>
                            </div>
                            <h4 class="text-white font-bold text-sm group-hover/item:text-brand-accent transition-colors">Mobile Application Development</h4>
                            <p class="text-slate-400 text-xs leading-relaxed">From pure native iOS/Android to cross-platform solutions, we build seamless and high-performing mobile apps.</p>
                        </a>
                        <a href="/services/web-development" class="group/item flex flex-col gap-3">
                            <div class="w-10 h-10 rounded-lg bg-pink-500/10 border border-pink-500/20 flex items-center justify-center text-pink-400 group-hover/item:bg-pink-500/20 transition-colors">
                                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" /></svg>
                            </div>
                            <h4 class="text-white font-bold text-sm group-hover/item:text-brand-accent transition-colors">Web Development</h4>
                            <p class="text-slate-400 text-xs leading-relaxed">ZetaLogix designs and builds ultra-fast, visually stunning, and highly converting web platforms.</p>
                        </a>
                        <a href="/services/ui-ux-design" class="group/item flex flex-col gap-3">
                            <div class="w-10 h-10 rounded-lg bg-teal-500/10 border border-teal-500/20 flex items-center justify-center text-teal-400 group-hover/item:bg-teal-500/20 transition-colors">
                                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                            </div>
                            <h4 class="text-white font-bold text-sm group-hover/item:text-brand-accent transition-colors">UI/UX Design Services</h4>
                            <p class="text-slate-400 text-xs leading-relaxed">We bring expertise in all stages of design, from deep user research to polished, interactive prototypes.</p>
                        </a>
                        <a href="/services/ai-solutions" class="group/item flex flex-col gap-3">
                            <div class="w-10 h-10 rounded-lg bg-blue-500/10 border border-blue-500/20 flex items-center justify-center text-blue-400 group-hover/item:bg-blue-500/20 transition-colors">
                                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                            </div>
                            <h4 class="text-white font-bold text-sm group-hover/item:text-brand-accent transition-colors">AI Solutions</h4>
                            <p class="text-slate-400 text-xs leading-relaxed">Leverage the power of artificial intelligence and machine learning to automate and scale your business.</p>
                        </a>
                    </div>
                </div>
            </div>

            <div class="group h-full flex items-center cursor-pointer relative">
                <a href="/#engagement" class="text-sm font-semibold text-slate-300 group-hover:text-brand-accent transition-colors flex items-center gap-1">
                    Engagement models
                    <svg class="w-4 h-4 transition-transform duration-300 group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                </a>
                
                <div class="absolute top-20 left-1/2 -translate-x-1/2 w-[700px] bg-[#0a0f1d] border border-white/10 rounded-2xl shadow-2xl p-8 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 translate-y-4 group-hover:translate-y-0 cursor-default">
                    <div class="grid grid-cols-2 gap-8">
                        <div class="space-y-8">
                            <a href="/engagement/fixed-price" class="group/item flex flex-col gap-3">
                                <div class="w-10 h-10 rounded-lg bg-purple-500/10 border border-purple-500/20 flex items-center justify-center text-purple-400 group-hover/item:bg-purple-500/20 transition-colors">
                                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
                                </div>
                                <h4 class="text-white font-bold text-sm group-hover/item:text-brand-accent transition-colors">Fixed Price Projects</h4>
                                <p class="text-slate-400 text-xs leading-relaxed">Fixed Price model is best if you are budget conscious with a tight timeline for delivery.</p>
                            </a>
                            <a href="/engagement/offshore" class="group/item flex flex-col gap-3">
                                <div class="w-10 h-10 rounded-lg bg-orange-500/10 border border-orange-500/20 flex items-center justify-center text-orange-400 group-hover/item:bg-orange-500/20 transition-colors">
                                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                                </div>
                                <h4 class="text-white font-bold text-sm group-hover/item:text-brand-accent transition-colors">Offshore Development Center</h4>
                                <p class="text-slate-400 text-xs leading-relaxed">We provide a dedicated Offshore Development Center (ODC) designed to function as an extension of your in-house team.</p>
                            </a>
                        </div>
                        <div class="space-y-8 flex flex-col">
                            <a href="/engagement/dedicated-team" class="group/item flex flex-col gap-3">
                                <div class="w-10 h-10 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 group-hover/item:bg-emerald-500/20 transition-colors">
                                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
                                </div>
                                <h4 class="text-white font-bold text-sm group-hover/item:text-brand-accent transition-colors">Dedicated Team-model</h4>
                                <p class="text-slate-400 text-xs leading-relaxed">We ensures your product hits the market swiftly and effectively with a dedicated team tailored to your project.</p>
                            </a>
                            <div class="mt-auto p-4 rounded-xl bg-slate-800/30 border border-white/5">
                                <p class="text-slate-300 text-sm leading-relaxed">
                                    Don't know the right engagement model for your project? <a href="/contact" class="text-brand-accent font-bold hover:text-white transition-colors">Learn more</a>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="h-full flex items-center">
                <a href="/portfolio" class="text-sm font-semibold text-slate-300 hover:text-brand-accent transition-colors">Portfolio</a>
            </div>
        </div>

        <div class="hidden md:block">
            <a href="/contact" class="btn-blink px-7 py-3 text-white font-bold text-sm rounded-full transition-all tracking-wide">
                Get a Free Quote
            </a>
        </div>

        <button class="md:hidden text-white focus:outline-none">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>
        </button>
    </div>
</nav>

<style>
    .btn-blink {
        background-image: linear-gradient(to right, #3b82f6, #8b5cf6, #3b82f6);
        background-size: 200% auto;
        animation: pulse-glow 2s infinite, gradient-shift 3s linear infinite;
        box-shadow: 0 4px 15px rgba(139, 92, 246, 0.4);
    }
    .btn-blink:hover {
        background-image: linear-gradient(to right, #2563eb, #7c3aed, #2563eb);
        transform: scale(1.05);
    }
    @keyframes gradient-shift {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
    }
    @keyframes pulse-glow {
        0% { box-shadow: 0 0 0 0 rgba(139, 92, 246, 0.7); }
        70% { box-shadow: 0 0 20px 15px rgba(139, 92, 246, 0); }
        100% { box-shadow: 0 0 0 0 rgba(139, 92, 246, 0); }
    }
</style>