---
// src/components/global/Navbar.astro
const services = [
	{
		title: 'Web Development',
		href: '/services/web-development',
		description: 'Fast websites and useful web applications.',
	},
	{
		title: 'Mobile App Development',
		href: '/services/mobile-development',
		description: 'Mobile experiences built around real user needs.',
	},
	{
		title: 'AI & Machine Learning',
		href: '/services/ai-solutions',
		description: 'Practical AI for search, documents and business workflows.',
	},
	{
		title: 'SaaS Development',
		href: '/services/saas-development',
		description: 'Subscription products with room to grow.',
	},
	{
		title: 'Custom Software',
		href: '/services/custom-software',
		description: 'Software shaped around your operations.',
	},
	{
		title: 'UI/UX Design',
		href: '/services/ui-ux-design',
		description: 'Clear journeys and interfaces people can use.',
	},
];

const engagementOptions = [
	{
		title: 'Fixed-Scope Projects',
		href: '/engagement/fixed-price',
		description: 'A defined outcome, agreed deliverables and milestones.',
	},
	{
		title: 'Dedicated Teams',
		href: '/engagement/dedicated-team',
		description: 'Ongoing engineering capacity for a product roadmap that will evolve.',
	},
	{
		title: 'Offshore Delivery',
		href: '/engagement/offshore',
		description: 'A coordinated remote delivery arrangement with agreed roles and access controls.',
	},
];
---

<header class="fixed w-full z-50 top-0 bg-brand-dark/95 backdrop-blur-md border-b border-white/10">
	<nav aria-label="Primary" class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between relative">
		<a href="/" class="flex items-center z-10 rounded-md">
			<img
				src="/assets/Logo.webp"
				alt="Zetalogix home"
				width="160"
				height="48"
				class="h-9 md:h-12 w-auto object-contain"
			/>
		</a>

		<!-- Desktop Navigation -->
		<div class="hidden lg:flex items-center gap-7 h-full">
			<!-- Services Disclosure Menu -->
			<div class="relative h-full flex items-center" data-nav-dropdown>
				<button
					type="button"
					class="nav-disclosure-btn text-sm font-semibold text-slate-200 hover:text-brand-accent transition-colors duration-150 flex items-center gap-1.5 py-2 px-1 rounded-md"
					aria-expanded="false"
					aria-controls="desktop-services-menu"
				>
					<span>Services</span>
					<svg
						class="w-4 h-4 transition-transform duration-150"
						data-dropdown-icon
						fill="none"
						viewBox="0 0 24 24"
						stroke="currentColor"
						aria-hidden="true"
					>
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
					</svg>
				</button>

				<div
					id="desktop-services-menu"
					class="nav-dropdown-panel hidden opacity-0 transition-opacity duration-150 absolute top-20 left-0 w-[680px] bg-[#0a0f1d] border border-white/10 rounded-2xl shadow-2xl p-6"
				>
					<div class="grid grid-cols-2 gap-4">
						{services.map((item) => (
							<a
								href={item.href}
								class="group/item flex flex-col gap-1.5 p-3.5 rounded-xl hover:bg-white/5 border border-transparent hover:border-white/10 transition-colors duration-150"
							>
								<span class="text-white font-semibold text-sm group-hover/item:text-brand-accent transition-colors">
									{item.title}
								</span>
								<span class="text-slate-400 text-xs leading-relaxed">
									{item.description}
								</span>
							</a>
						))}
					</div>
				</div>
			</div>

			<a
				href="/portfolio"
				class="text-sm font-semibold text-slate-200 hover:text-brand-accent transition-colors duration-150 py-2 px-1 rounded-md"
			>
				Our Work
			</a>

			<a
				href="/about"
				class="text-sm font-semibold text-slate-200 hover:text-brand-accent transition-colors duration-150 py-2 px-1 rounded-md"
			>
				About
			</a>

			<!-- Work With Us Disclosure Menu -->
			<div class="relative h-full flex items-center" data-nav-dropdown>
				<button
					type="button"
					class="nav-disclosure-btn text-sm font-semibold text-slate-200 hover:text-brand-accent transition-colors duration-150 flex items-center gap-1.5 py-2 px-1 rounded-md"
					aria-expanded="false"
					aria-controls="desktop-engagement-menu"
				>
					<span>Work With Us</span>
					<svg
						class="w-4 h-4 transition-transform duration-150"
						data-dropdown-icon
						fill="none"
						viewBox="0 0 24 24"
						stroke="currentColor"
						aria-hidden="true"
					>
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
					</svg>
				</button>

				<div
					id="desktop-engagement-menu"
					class="nav-dropdown-panel hidden opacity-0 transition-opacity duration-150 absolute top-20 left-0 w-[380px] bg-[#0a0f1d] border border-white/10 rounded-2xl shadow-2xl p-5"
				>
					<div class="flex flex-col gap-2">
						{engagementOptions.map((item) => (
							<a
								href={item.href}
								class="group/item flex flex-col gap-1 p-3 rounded-xl hover:bg-white/5 border border-transparent hover:border-white/10 transition-colors duration-150"
							>
								<span class="text-white font-semibold text-sm group-hover/item:text-brand-accent transition-colors">
									{item.title}
								</span>
								<span class="text-slate-400 text-xs leading-relaxed">
									{item.description}
								</span>
							</a>
						))}
					</div>
				</div>
			</div>

			<a
				href="/blog"
				class="text-sm font-semibold text-slate-200 hover:text-brand-accent transition-colors duration-150 py-2 px-1 rounded-md"
			>
				Insights
			</a>

			<a
				href="/contact"
				data-astro-prefetch="hover"
				class="text-sm font-semibold text-slate-200 hover:text-brand-accent transition-colors duration-150 py-2 px-1 rounded-md"
			>
				Contact
			</a>
		</div>

		<!-- Primary Project CTA -->
		<div class="hidden lg:block">
			<a
				href="/contact"
				data-astro-prefetch="hover"
				class="cta-primary inline-flex items-center justify-center px-6 py-2.5 text-slate-950 bg-cyan-400 hover:bg-cyan-300 font-semibold text-sm rounded-full shadow-sm"
			>
				Discuss Your Project
			</a>
		</div>

		<!-- Mobile Menu Trigger -->
		<button
			id="mobile-menu-btn"
			type="button"
			class="lg:hidden text-white p-2 rounded-md relative z-[70]"
			aria-label="Open navigation menu"
			aria-expanded="false"
			aria-controls="mobile-menu"
		>
			<svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
			</svg>
		</button>
	</nav>

	<!-- Mobile Navigation Drawer -->
	<div
		id="mobile-menu"
		class="fixed inset-0 bg-[#050814] z-[100] hidden overflow-y-auto w-full h-screen lg:hidden"
		aria-label="Mobile navigation"
	>
		<div class="flex items-center justify-between px-6 h-20 border-b border-white/10">
			<a href="/" class="flex items-center rounded-md">
				<img
					src="/assets/Logo.webp"
					alt="Zetalogix home"
					width="140"
					height="40"
					class="h-8 w-auto object-contain"
				/>
			</a>
			<button
				id="mobile-close-btn"
				type="button"
				class="text-white p-2 rounded-md"
				aria-label="Close navigation menu"
			>
				<svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
				</svg>
			</button>
		</div>

		<div class="flex flex-col px-6 py-8 space-y-5">
			<div class="border-b border-white/10 pb-4">
				<button
					type="button"
					class="mobile-accordion-btn flex items-center justify-between w-full text-base font-semibold text-white py-1 rounded-md"
					aria-expanded="false"
					aria-controls="mobile-services"
				>
					<span>Services</span>
					<svg
						class="accordion-icon w-5 h-5 transition-transform duration-150"
						fill="none"
						viewBox="0 0 24 24"
						stroke="currentColor"
						aria-hidden="true"
					>
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
					</svg>
				</button>
				<div id="mobile-services" class="hidden flex-col pl-4 space-y-3 mt-3 border-l border-white/15">
					{services.map((item) => (
						<a href={item.href} class="mobile-link text-slate-300 hover:text-brand-accent text-sm py-1 block">
							{item.title}
						</a>
					))}
				</div>
			</div>

			<div class="border-b border-white/10 pb-4">
				<a href="/portfolio" class="mobile-link block text-base font-semibold text-white py-1 rounded-md">
					Our Work
				</a>
			</div>

			<div class="border-b border-white/10 pb-4">
				<a href="/about" class="mobile-link block text-base font-semibold text-white py-1 rounded-md">
					About
				</a>
			</div>

			<div class="border-b border-white/10 pb-4">
				<button
					type="button"
					class="mobile-accordion-btn flex items-center justify-between w-full text-base font-semibold text-white py-1 rounded-md"
					aria-expanded="false"
					aria-controls="mobile-engagement"
				>
					<span>Work With Us</span>
					<svg
						class="accordion-icon w-5 h-5 transition-transform duration-150"
						fill="none"
						viewBox="0 0 24 24"
						stroke="currentColor"
						aria-hidden="true"
					>
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
					</svg>
				</button>
				<div id="mobile-engagement" class="hidden flex-col pl-4 space-y-3 mt-3 border-l border-white/15">
					{engagementOptions.map((item) => (
						<a href={item.href} class="mobile-link text-slate-300 hover:text-brand-accent text-sm py-1 block">
							{item.title}
						</a>
					))}
				</div>
			</div>

			<div class="border-b border-white/10 pb-4">
				<a href="/blog" class="mobile-link block text-base font-semibold text-white py-1 rounded-md">
					Insights
				</a>
			</div>

			<div class="border-b border-white/10 pb-4">
				<a href="/contact" class="mobile-link block text-base font-semibold text-white py-1 rounded-md">
					Contact
				</a>
			</div>

			<div class="pt-4">
				<a
					href="/contact"
					class="cta-primary flex justify-center w-full py-3.5 text-slate-950 bg-cyan-400 hover:bg-cyan-300 font-semibold text-sm rounded-full"
				>
					Discuss Your Project
				</a>
			</div>
		</div>
	</div>
</header>

<script>
	const setupNavigation = () => {
		// 1. Desktop Disclosure Dropdowns (Pointer + Click + Keyboard Accessible)
		const dropdownContainers = document.querySelectorAll('[data-nav-dropdown]');

		const closeDropdown = (container: Element) => {
			const btn = container.querySelector('.nav-disclosure-btn');
			const panel = container.querySelector('.nav-dropdown-panel');
			const icon = container.querySelector('[data-dropdown-icon]');
			if (btn && panel) {
				btn.setAttribute('aria-expanded', 'false');
				panel.classList.remove('opacity-100');
				panel.classList.add('opacity-0', 'hidden');
				icon?.classList.remove('rotate-180');
			}
		};

		const openDropdown = (container: Element) => {
			dropdownContainers.forEach((other) => {
				if (other !== container) closeDropdown(other);
			});
			const btn = container.querySelector('.nav-disclosure-btn');
			const panel = container.querySelector('.nav-dropdown-panel');
			const icon = container.querySelector('[data-dropdown-icon]');
			if (btn && panel) {
				btn.setAttribute('aria-expanded', 'true');
				panel.classList.remove('hidden', 'opacity-0');
				panel.classList.add('opacity-100');
				icon?.classList.add('rotate-180');
			}
		};

		dropdownContainers.forEach((container) => {
			const btn = container.querySelector('.nav-disclosure-btn');
			if (!btn) return;

			btn.addEventListener('click', (e) => {
				e.stopPropagation();
				const isOpen = btn.getAttribute('aria-expanded') === 'true';
				if (isOpen) {
					closeDropdown(container);
				} else {
					openDropdown(container);
				}
			});

			container.addEventListener('mouseenter', () => {
				if (window.matchMedia('(hover: hover)').matches) {
					openDropdown(container);
				}
			});

			container.addEventListener('mouseleave', () => {
				if (window.matchMedia('(hover: hover)').matches) {
					closeDropdown(container);
				}
			});

			container.addEventListener('focusout', (e) => {
				const related = (e as FocusEvent).relatedTarget as Node | null;
				if (related && !container.contains(related)) {
					closeDropdown(container);
				}
			});
		});

		document.addEventListener('click', (e) => {
			const target = e.target as Node;
			dropdownContainers.forEach((container) => {
				if (!container.contains(target)) {
					closeDropdown(container);
				}
			});
		});

		// 2. Mobile Menu Drawer & Accordions
		const menuBtn = document.getElementById('mobile-menu-btn');
		const closeMenuBtn = document.getElementById('mobile-close-btn');
		const mobileMenu = document.getElementById('mobile-menu');
		const mobileLinks = document.querySelectorAll('.mobile-link');
		const accordions = document.querySelectorAll('.mobile-accordion-btn');

		const openMobileMenu = () => {
			if (!mobileMenu || !menuBtn) return;
			mobileMenu.classList.remove('hidden');
			menuBtn.setAttribute('aria-expanded', 'true');
			document.body.style.overflow = 'hidden';
			closeMenuBtn?.focus();
		};

		const closeMobileMenu = () => {
			if (!mobileMenu || !menuBtn) return;
			mobileMenu.classList.add('hidden');
			menuBtn.setAttribute('aria-expanded', 'false');
			document.body.style.overflow = '';
			menuBtn.focus();
		};

		menuBtn?.addEventListener('click', openMobileMenu);
		closeMenuBtn?.addEventListener('click', closeMobileMenu);

		mobileLinks.forEach((link) => {
			link.addEventListener('click', () => {
				if (mobileMenu && !mobileMenu.classList.contains('hidden')) {
					mobileMenu.classList.add('hidden');
					menuBtn?.setAttribute('aria-expanded', 'false');
					document.body.style.overflow = '';
				}
			});
		});

		accordions.forEach((acc) => {
			acc.addEventListener('click', () => {
				const targetId = acc.getAttribute('aria-controls');
				if (!targetId) return;
				const target = document.getElementById(targetId);
				const icon = acc.querySelector('.accordion-icon');
				const isExpanded = acc.getAttribute('aria-expanded') === 'true';

				if (target) {
					acc.setAttribute('aria-expanded', (!isExpanded).toString());
					target.classList.toggle('hidden', isExpanded);
					target.classList.toggle('flex', !isExpanded);
					icon?.classList.toggle('rotate-180', !isExpanded);
				}
			});
		});

		// Global Escape Key Handler
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') {
				dropdownContainers.forEach((container) => {
					if (container.querySelector('[aria-expanded="true"]')) {
						closeDropdown(container);
						(container.querySelector('.nav-disclosure-btn') as HTMLElement | null)?.focus();
					}
				});
				if (mobileMenu && !mobileMenu.classList.contains('hidden')) {
					closeMobileMenu();
				}
			}
		});

		// 3. Intent Prefetching for /contact
		let contactPrefetched = false;
		const prefetchLinks = document.querySelectorAll('a[href="/contact"][data-astro-prefetch]');
		const triggerPrefetch = () => {
			if (contactPrefetched) return;
			contactPrefetched = true;
			const link = document.createElement('link');
			link.rel = 'prefetch';
			link.href = '/contact';
			document.head.appendChild(link);
		};
		prefetchLinks.forEach((el) => {
			el.addEventListener('mouseenter', triggerPrefetch, { once: true });
			el.addEventListener('focus', triggerPrefetch, { once: true });
		});
	};

	setupNavigation();
</script>