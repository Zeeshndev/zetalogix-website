---
// src/components/global/Navbar.astro
import ContactForm from '../sections/ContactForm.astro';
---

<style is:global>
    html, body {
        overflow-x: hidden !important;
        max-width: 100vw !important;
        width: 100% !important;
        position: relative;
    }
</style>

<nav class="fixed w-full z-50 top-0 transition-all duration-300 bg-brand-dark/90 backdrop-blur-lg border-b border-white/5">
    <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between relative">
        
     <a href="/" class="flex items-center z-10 group focus:outline-none">
            <img 
                src="/assets/Logo.png" 
                alt="ZetaLogix Logo" 
                class="h-8 md:h-18 lg:h-20 w-auto object-contain transition-transform duration-300 group-hover:scale-105"
            />
        </a>

        <div class="hidden md:flex items-center gap-8 h-full">
            
            {/* 1. Services Dropdown (Reordered to prioritize Web, Mobile, AI) */}
            <div class="group h-full flex items-center cursor-pointer">
                <a href="/#services" class="text-sm font-semibold text-slate-300 group-hover:text-brand-accent transition-colors flex items-center gap-1 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-accent rounded-md px-2 py-1">
                    Services
                    <svg class="w-4 h-4 transition-transform duration-300 group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                </a>
                
                <div class="absolute top-20 left-6 right-6 bg-[#0a0f1d] border border-white/10 rounded-2xl shadow-2xl p-10 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 translate-y-4 group-hover:translate-y-0 cursor-default">
                    <div class="grid grid-cols-3 gap-10">
                        <a href="/services/web-development" class="group/item flex flex-col gap-3 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-accent rounded-lg p-2 -m-2">
                            <div class="w-10 h-10 rounded-lg bg-pink-500/10 border border-pink-500/20 flex items-center justify-center text-pink-400 group-hover/item:bg-pink-500/20 transition-colors">
                                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" /></svg>
                            </div>
                            <h4 class="text-white font-bold text-sm group-hover/item:text-brand-accent transition-colors">Web Applications</h4>
                            <p class="text-slate-400 text-xs leading-relaxed">Secure, high-conversion SaaS platforms and enterprise portals engineered for scale.</p>
                        </a>
                        <a href="/services/mobile-development" class="group/item flex flex-col gap-3 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-accent rounded-lg p-2 -m-2">
                            <div class="w-10 h-10 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 group-hover/item:bg-emerald-500/20 transition-colors">
                                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>
                            </div>
                            <h4 class="text-white font-bold text-sm group-hover/item:text-brand-accent transition-colors">Mobile Applications</h4>
                            <p class="text-slate-400 text-xs leading-relaxed">Native iOS/Android and cross-platform solutions delivering seamless mobile experiences.</p>
                        </a>
                        <a href="/services/ai-solutions" class="group/item flex flex-col gap-3 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-accent rounded-lg p-2 -m-2">
                            <div class="w-10 h-10 rounded-lg bg-blue-500/10 border border-blue-500/20 flex items-center justify-center text-blue-400 group-hover/item:bg-blue-500/20 transition-colors">
                                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                            </div>
                            <h4 class="text-white font-bold text-sm group-hover/item:text-brand-accent transition-colors">AI Solutions</h4>
                            <p class="text-slate-400 text-xs leading-relaxed">Integrate intelligent automation and custom machine learning into your workflows.</p>
                        </a>
                        <a href="/services/saas-development" class="group/item flex flex-col gap-3 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-accent rounded-lg p-2 -m-2">
                            <div class="w-10 h-10 rounded-lg bg-red-500/10 border border-red-500/20 flex items-center justify-center text-red-400 group-hover/item:bg-red-500/20 transition-colors">
                                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" /></svg>
                            </div>
                            <h4 class="text-white font-bold text-sm group-hover/item:text-brand-accent transition-colors">SaaS Development</h4>
                            <p class="text-slate-400 text-xs leading-relaxed">End-to-end architecture for multi-tenant cloud applications and subscription billing.</p>
                        </a>
                        <a href="/services/custom-software" class="group/item flex flex-col gap-3 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-accent rounded-lg p-2 -m-2">
                            <div class="w-10 h-10 rounded-lg bg-purple-500/10 border border-purple-500/20 flex items-center justify-center text-purple-400 group-hover/item:bg-purple-500/20 transition-colors">
                                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>
                            </div>
                            <h4 class="text-white font-bold text-sm group-hover/item:text-brand-accent transition-colors">Custom Software</h4>
                            <p class="text-slate-400 text-xs leading-relaxed">Bespoke software engineered to solve your unique business challenges.</p>
                        </a>
                        <a href="/services/ui-ux-design" class="group/item flex flex-col gap-3 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-accent rounded-lg p-2 -m-2">
                            <div class="w-10 h-10 rounded-lg bg-teal-500/10 border border-teal-500/20 flex items-center justify-center text-teal-400 group-hover/item:bg-teal-500/20 transition-colors">
                                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                            </div>
                            <h4 class="text-white font-bold text-sm group-hover/item:text-brand-accent transition-colors">UI/UX Design</h4>
                            <p class="text-slate-400 text-xs leading-relaxed">Data-driven, aesthetic interfaces focused on maximizing user engagement.</p>
                        </a>
                    </div>
                </div>
            </div>

            {/* 2. Our Work */}
            <div class="h-full flex items-center">
                <a href="/portfolio" class="text-sm font-semibold text-slate-300 hover:text-brand-accent transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-accent rounded-md px-2 py-1">Our Work</a>
            </div>

            {/* 3. About Us */}
            <div class="h-full flex items-center">
                <a href="/about" class="text-sm font-semibold text-slate-300 hover:text-brand-accent transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-accent rounded-md px-2 py-1">About Us</a>
            </div>

            {/* 4. Insights */}
            <div class="h-full flex items-center">
                <a href="/blog" class="text-sm font-semibold text-slate-300 hover:text-brand-accent transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-accent rounded-md px-2 py-1">Insights</a>
            </div>

            {/* 5. Contact */}
            <div class="h-full flex items-center">
                <a href="/contact" class="text-sm font-semibold text-slate-300 hover:text-brand-accent transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-accent rounded-md px-2 py-1">Contact</a>
            </div>
        </div>

        {/* 6. Discuss Your Project CTA */}
        <div class="hidden md:block">
            <button id="quote-btn-desktop" class="btn-blink px-7 py-3 text-white font-bold text-sm rounded-full transition-all tracking-wide cursor-pointer focus:outline-none focus-visible:ring-4 focus-visible:ring-brand-accent">
                Discuss Your Project
            </button>
        </div>

        <button id="mobile-menu-btn" aria-label="Open Mobile Menu" class="md:hidden text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-accent rounded-md p-2 relative z-[70]">
            <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>
        </button>
    </div>
</nav>

{/* Mobile Menu */}
<div id="mobile-menu" class="fixed inset-0 bg-[#050814]/95 backdrop-blur-2xl z-[100] transform translate-x-full transition-transform duration-300 overflow-y-auto w-full h-full md:hidden">
    <div class="flex items-center justify-between px-6 h-20 border-b border-white/10">
       <a href="/" class="flex items-center group focus:outline-none">
            <img 
                src="/assets/Logo.png" 
                alt="ZetaLogix Logo" 
                class="h-8 w-auto object-contain transition-transform duration-300 group-hover:scale-105"
            />
        </a>
        <button id="mobile-close-btn" aria-label="Close Mobile Menu" class="text-white p-2 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-accent rounded-md">
            <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
    </div>

    <div class="flex flex-col px-6 py-8 space-y-6">
        
        <div class="border-b border-white/10 pb-4">
            <button class="mobile-accordion-btn flex items-center justify-between w-full text-lg font-bold text-white mb-2 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-accent rounded-md p-1" aria-controls="mobile-services" aria-expanded="false">
                Services
                <svg class="accordion-icon w-5 h-5 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
            </button>
            <div id="mobile-services" class="hidden flex-col pl-4 space-y-4 mt-4 border-l border-brand-accent/30">
                <a href="/services/web-development" class="mobile-link text-slate-400 hover:text-brand-accent text-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-accent rounded-sm px-1">Web Applications</a>
                <a href="/services/mobile-development" class="mobile-link text-slate-400 hover:text-brand-accent text-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-accent rounded-sm px-1">Mobile Applications</a>
                <a href="/services/ai-solutions" class="mobile-link text-slate-400 hover:text-brand-accent text-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-accent rounded-sm px-1">AI Solutions</a>
                <a href="/services/saas-development" class="mobile-link text-slate-400 hover:text-brand-accent text-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-accent rounded-sm px-1">SaaS Development</a>
                <a href="/services/custom-software" class="mobile-link text-slate-400 hover:text-brand-accent text-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-accent rounded-sm px-1">Custom Software</a>
                <a href="/services/ui-ux-design" class="mobile-link text-slate-400 hover:text-brand-accent text-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-accent rounded-sm px-1">UI/UX Design</a>
            </div>
        </div>

        <div class="border-b border-white/10 pb-4">
            <a href="/portfolio" class="mobile-link block text-lg font-bold text-white w-full focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-accent rounded-md p-1">Our Work</a>
        </div>

        <div class="border-b border-white/10 pb-4">
            <a href="/about" class="mobile-link block text-lg font-bold text-white w-full focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-accent rounded-md p-1">About Us</a>
        </div>

        <div class="border-b border-white/10 pb-4">
            <a href="/blog" class="mobile-link block text-lg font-bold text-white w-full focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-accent rounded-md p-1">Insights</a>
        </div>

        <div class="border-b border-white/10 pb-4">
            <a href="/contact" class="mobile-link block text-lg font-bold text-white w-full focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-accent rounded-md p-1">Contact</a>
        </div>
        
        <div class="pt-6">
            <button id="quote-btn-mobile" class="btn-blink flex justify-center w-full py-4 text-white font-bold text-sm rounded-full transition-all tracking-wide outline-none focus:ring-4 focus:ring-brand-accent">
                Discuss Your Project
            </button>
        </div>

    </div>
</div>

{/* Quote Modal */}
<div id="quote-modal" class="fixed inset-0 z-[200] flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-300 p-4" aria-modal="true" role="dialog">
    <div id="quote-modal-backdrop" class="absolute inset-0 bg-[#02040a]/90 backdrop-blur-sm cursor-pointer"></div>
    <div id="quote-modal-card" class="relative w-full max-w-5xl transform scale-95 transition-transform duration-300 z-10 max-h-[95vh] overflow-y-auto custom-scrollbar rounded-3xl bg-brand-dark border border-white/10">
        <button id="quote-modal-close" aria-label="Close modal" class="absolute top-6 right-6 text-slate-400 hover:text-white transition-colors z-[210] focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-accent bg-white/5 hover:bg-white/10 rounded-full p-2">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
        <div class="modal-embedded-form">
            <ContactForm />
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const menuBtn = document.getElementById('mobile-menu-btn');
        const closeMenuBtn = document.getElementById('mobile-close-btn');
        const mobileMenu = document.getElementById('mobile-menu') as HTMLElement;
        const mobileLinks = document.querySelectorAll('.mobile-link');
        const accordions = document.querySelectorAll('.mobile-accordion-btn');

        const modal = document.getElementById('quote-modal') as HTMLElement;
        const modalBackdrop = document.getElementById('quote-modal-backdrop');
        const modalCard = document.getElementById('quote-modal-card') as HTMLElement;
        const modalCloseBtn = document.getElementById('quote-modal-close');
        const triggerDesktop = document.getElementById('quote-btn-desktop');
        const triggerMobile = document.getElementById('quote-btn-mobile');

        // 1. Mobile Menu Logic
        if(menuBtn && mobileMenu) {
            menuBtn.addEventListener('click', () => {
                mobileMenu.classList.remove('translate-x-full');
            });
        }
        if(closeMenuBtn && mobileMenu) {
            closeMenuBtn.addEventListener('click', () => {
                mobileMenu.classList.add('translate-x-full');
            });
        }
        mobileLinks.forEach(link => {
            link.addEventListener('click', () => {
                mobileMenu.classList.add('translate-x-full');
            });
        });

        accordions.forEach(acc => {
            acc.addEventListener('click', (e) => {
                e.preventDefault();
                const targetId = acc.getAttribute('aria-controls');
                if(!targetId) return;
                const target = document.getElementById(targetId);
                const icon = acc.querySelector('.accordion-icon');
                if(target && icon) {
                    target.classList.toggle('hidden');
                    target.classList.toggle('flex');
                    icon.classList.toggle('rotate-180');
                    const isExpanded = acc.getAttribute('aria-expanded') === 'true';
                    acc.setAttribute('aria-expanded', String(!isExpanded));
                }
            });
        });

        // 2. Modal Logic
        const openModal = () => {
            modal.classList.remove('opacity-0', 'pointer-events-none');
            modalCard.classList.remove('scale-95');
            modalCard.classList.add('scale-100');
            if(mobileMenu) mobileMenu.classList.add('translate-x-full');
            document.body.style.overflow = 'hidden'; 
            document.getElementById('quote-modal-close')?.focus();
        };

        const closeModal = () => {
            modal.classList.add('opacity-0', 'pointer-events-none');
            modalCard.classList.remove('scale-100');
            modalCard.classList.add('scale-95');
            document.body.style.overflow = ''; 
        };

        if(triggerDesktop) triggerDesktop.addEventListener('click', openModal);
        if(triggerMobile) {
            triggerMobile.addEventListener('click', (e) => {
                e.preventDefault();
                openModal();
            });
        }

        if(modalCloseBtn) modalCloseBtn.addEventListener('click', closeModal);
        if(modalBackdrop) modalBackdrop.addEventListener('click', closeModal);

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && !modal.classList.contains('opacity-0')) {
                closeModal();
            }
        });
    });
</script>

<style>
    .btn-blink {
        background-image: linear-gradient(to right, #3b82f6, #8b5cf6, #3b82f6);
        background-size: 200% auto;
        animation: pulse-glow 2s infinite, gradient-shift 3s linear infinite;
        box-shadow: 0 4px 15px rgba(139, 92, 246, 0.4);
    }
    .btn-blink:hover {
        background-image: linear-gradient(to right, #2563eb, #7c3aed, #2563eb);
        transform: scale(1.05);
    }
    @keyframes gradient-shift {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
    }
    @keyframes pulse-glow {
        0% { box-shadow: 0 0 0 0 rgba(139, 92, 246, 0.7); }
        70% { box-shadow: 0 0 20px 15px rgba(139, 92, 246, 0); }
        100% { box-shadow: 0 0 0 0 rgba(139, 92, 246, 0); }
    }

    .custom-scrollbar::-webkit-scrollbar { width: 8px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: #0a0f1d; border-radius: 8px; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.1); border-radius: 8px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: rgba(255, 255, 255, 0.2); }

    .modal-embedded-form > section {
        padding-top: 3rem !important;
        padding-bottom: 3rem !important;
        border-top: none !important;
        background-color: transparent !important;
    }
</style>