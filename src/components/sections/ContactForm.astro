---
// src/components/sections/ContactForm.astro

const countries = [
  { n: "United States", c: "+1", f: "🇺🇸" }, { n: "United Kingdom", c: "+44", f: "🇬🇧" }, { n: "Canada", c: "+1", f: "🇨🇦" }, { n: "Australia", c: "+61", f: "🇦🇺" }, { n: "Pakistan", c: "+92", f: "🇵🇰" }, { n: "UAE", c: "+971", f: "🇦🇪" }, { n: "Saudi Arabia", c: "+966", f: "🇸🇦" }, { n: "Germany", c: "+49", f: "🇩🇪" }, { n: "France", c: "+33", f: "🇫🇷" }, { n: "Singapore", c: "+65", f: "🇸🇬" }
];
const sortedCountries = countries.sort((a, b) => a.n.localeCompare(b.n));
---

<section id="contact" class="py-24 lg:py-32 bg-brand-dark relative border-t border-white/5 scroll-mt-20">
    <div class="max-w-7xl mx-auto px-6">
        
        <div class="text-center mb-16">
            <div class="text-4xl mb-4" aria-hidden="true">💼</div>
            <h2 class="font-heading text-4xl md:text-5xl font-bold text-white tracking-tight">Let's Work Together</h2>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
            
            <div class="lg:col-span-7 bg-[#0a0f1d] border border-white/10 rounded-2xl p-8 md:p-10 shadow-2xl relative z-10">
                <form class="zeta-contact-form flex flex-col gap-6" novalidate>
                    
                    {/* Honeypot Spam Protection */}
                    <input type="text" name="_honeypot" class="hidden" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />
                    
                    <input type="text" name="name" placeholder="Full Name*" required aria-label="Full Name" aria-required="true" class="validation-target w-full bg-brand-dark border border-white/10 rounded-lg px-4 py-3.5 text-slate-300 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-brand-accent transition-colors" />
                    <input type="email" name="email" placeholder="Work Email*" required aria-label="Work Email" aria-required="true" class="validation-target w-full bg-brand-dark border border-white/10 rounded-lg px-4 py-3.5 text-slate-300 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-brand-accent transition-colors" />
                    
                    <div class="flex items-center w-full bg-brand-dark border border-white/10 rounded-lg focus-within:ring-2 focus-within:ring-brand-accent transition-colors relative z-50 group-country">
                        
                        <button type="button" aria-haspopup="listbox" aria-expanded="false" aria-label="Select Country Code" class="custom-select-btn flex items-center justify-between gap-1.5 px-4 py-3.5 border-r border-white/10 bg-white/[0.02] hover:bg-white/[0.05] transition-colors text-slate-300 min-w-[105px] h-full rounded-l-lg cursor-pointer focus:outline-none">
                            <div class="flex items-center gap-1.5 pointer-events-none">
                                <span class="selected-flag text-base" aria-hidden="true">🇺🇸</span>
                                <span class="selected-code text-sm font-medium">+1</span>
                            </div>
                            <svg class="w-3 h-3 text-slate-500 transition-transform duration-200 pointer-events-none icon-arrow" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                        </button>

                        <div role="listbox" class="custom-select-list absolute left-0 top-[110%] w-72 max-h-80 overflow-hidden bg-[#0f172a] border border-white/10 rounded-lg shadow-2xl opacity-0 invisible transition-all duration-200 z-50 flex flex-col">
                            
                            <div class="p-3 border-b border-white/10 bg-[#0f172a] sticky top-0 z-20">
                                <div class="relative">
                                    <svg class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-slate-500" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                                    <input type="text" class="country-search w-full bg-brand-dark border border-white/10 rounded-md pl-9 pr-3 py-2 text-sm text-slate-300 placeholder-slate-500 focus:outline-none focus:border-brand-accent transition-colors" placeholder="Search country..." aria-label="Search countries" />
                                </div>
                            </div>

                            <div class="overflow-y-auto flex-1 custom-scrollbar">
                                {sortedCountries.map((country) => (
                                    <div 
                                        role="option"
                                        tabindex="0"
                                        class="country-option px-4 py-2.5 text-slate-300 hover:bg-brand-accent/10 hover:text-white focus:bg-brand-accent/10 cursor-pointer transition-colors flex items-center gap-3 text-sm border-b border-white/5 last:border-0"
                                        data-code={country.c}
                                        data-flag={country.f}
                                        data-name={country.n.toLowerCase()}
                                    >
                                        <span class="text-base" aria-hidden="true">{country.f}</span>
                                        <span class="country-name font-medium">{country.n}</span>
                                        <span class="text-slate-500 ml-auto">{country.c}</span>
                                    </div>
                                ))}
                            </div>
                        </div>

                        <input type="hidden" name="country_code" class="hidden-input" value="+1" />
                        <input type="tel" name="phone" placeholder="Phone Number (Optional)" aria-label="Phone Number" class="w-full bg-transparent px-4 py-3.5 text-slate-300 placeholder-slate-500 focus:outline-none h-full" />
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 relative z-40">
                        <div class="relative custom-dropdown">
                            <button type="button" aria-haspopup="listbox" aria-expanded="false" aria-label="Select Service Type" class="validation-target custom-select-btn w-full bg-brand-dark border border-white/10 rounded-lg px-4 py-3.5 flex items-center justify-between text-slate-500 focus:outline-none focus:ring-2 focus:ring-brand-accent transition-colors hover:border-white/20">
                                <span class="selected-text truncate">Service Type (Optional)</span>
                                <svg class="w-4 h-4 shrink-0 transition-transform duration-200 icon-arrow" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                            </button>
                            <div role="listbox" class="custom-select-list absolute left-0 top-[105%] w-full bg-[#0f172a] border border-white/10 rounded-lg shadow-2xl opacity-0 invisible transition-all duration-200 z-40 overflow-hidden">
                                <div role="option" tabindex="0" class="custom-option px-4 py-3 text-slate-300 hover:bg-brand-accent hover:text-[#0a0f1d] cursor-pointer text-sm border-b border-white/5" data-value="web">Web Application</div>
                                <div role="option" tabindex="0" class="custom-option px-4 py-3 text-slate-300 hover:bg-brand-accent hover:text-[#0a0f1d] cursor-pointer text-sm border-b border-white/5" data-value="mobile">Mobile Application</div>
                                <div role="option" tabindex="0" class="custom-option px-4 py-3 text-slate-300 hover:bg-brand-accent hover:text-[#0a0f1d] cursor-pointer text-sm border-b border-white/5" data-value="ai">AI Solution</div>
                                <div role="option" tabindex="0" class="custom-option px-4 py-3 text-slate-300 hover:bg-brand-accent hover:text-[#0a0f1d] cursor-pointer text-sm" data-value="other">Other</div>
                            </div>
                            <input type="hidden" name="source" class="hidden-input" />
                        </div>

                        <div class="relative custom-dropdown">
                            <button type="button" aria-haspopup="listbox" aria-expanded="false" aria-label="Select Budget" class="validation-target custom-select-btn w-full bg-brand-dark border border-white/10 rounded-lg px-4 py-3.5 flex items-center justify-between text-slate-500 focus:outline-none focus:ring-2 focus:ring-brand-accent transition-colors hover:border-white/20">
                                <span class="selected-text truncate">Budget (Optional)</span>
                                <svg class="w-4 h-4 shrink-0 transition-transform duration-200 icon-arrow" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                            </button>
                            <div role="listbox" class="custom-select-list absolute left-0 top-[105%] w-full bg-[#0f172a] border border-white/10 rounded-lg shadow-2xl opacity-0 invisible transition-all duration-200 z-40 overflow-hidden">
                                <div role="option" tabindex="0" class="custom-option px-4 py-3 text-slate-300 hover:bg-brand-accent hover:text-[#0a0f1d] cursor-pointer text-sm border-b border-white/5" data-value="5k-10k">$5k - $10k</div>
                                <div role="option" tabindex="0" class="custom-option px-4 py-3 text-slate-300 hover:bg-brand-accent hover:text-[#0a0f1d] cursor-pointer text-sm border-b border-white/5" data-value="10k-25k">$10k - $25k</div>
                                <div role="option" tabindex="0" class="custom-option px-4 py-3 text-slate-300 hover:bg-brand-accent hover:text-[#0a0f1d] cursor-pointer text-sm border-b border-white/5" data-value="25k-50k">$25k - $50k</div>
                                <div role="option" tabindex="0" class="custom-option px-4 py-3 text-slate-300 hover:bg-brand-accent hover:text-[#0a0f1d] cursor-pointer text-sm border-b border-white/5" data-value="50k+">$50k+</div>
                                <div role="option" tabindex="0" class="custom-option px-4 py-3 text-brand-accent hover:bg-brand-accent hover:text-[#0a0f1d] cursor-pointer text-sm font-semibold" data-value="custom">Custom / Unsure</div>
                            </div>
                            <input type="hidden" name="budget" class="hidden-input" />
                        </div>
                    </div>

                    <div class="relative z-30 custom-dropdown">
                        <button type="button" aria-haspopup="listbox" aria-expanded="false" aria-label="Select Engagement Model" class="custom-select-btn w-full bg-brand-dark border border-white/10 rounded-lg px-4 py-3.5 flex items-center justify-between text-slate-500 focus:outline-none focus:ring-2 focus:ring-brand-accent transition-colors hover:border-white/20">
                            <span class="selected-text truncate">Engagement Model (Optional)</span>
                            <svg class="w-4 h-4 shrink-0 transition-transform duration-200 icon-arrow" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                        </button>
                        
                        <div role="listbox" class="custom-select-list absolute left-0 top-[105%] w-full bg-[#0f172a] border border-white/10 rounded-lg shadow-2xl opacity-0 invisible transition-all duration-200 z-30 overflow-hidden">
                            <div role="option" tabindex="0" class="custom-option px-4 py-3 text-slate-300 hover:bg-brand-accent hover:text-[#0a0f1d] cursor-pointer transition-colors text-sm border-b border-white/5" data-value="fixed">Fixed Price Project</div>
                            <div role="option" tabindex="0" class="custom-option px-4 py-3 text-slate-300 hover:bg-brand-accent hover:text-[#0a0f1d] cursor-pointer transition-colors text-sm border-b border-white/5" data-value="dedicated">Dedicated Team</div>
                            <div role="option" tabindex="0" class="custom-option px-4 py-3 text-slate-300 hover:bg-brand-accent hover:text-[#0a0f1d] cursor-pointer transition-colors text-sm" data-value="time">Time & Material</div>
                        </div>
                        <input type="hidden" name="engagement" class="hidden-input" />
                    </div>

                    <textarea name="message" rows="4" placeholder="Project Description*" aria-label="Project Description" aria-required="true" required class="validation-target w-full bg-brand-dark border border-white/10 rounded-lg px-4 py-3.5 text-slate-300 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-brand-accent transition-colors resize-none"></textarea>

                    <div class="flex flex-col sm:flex-row items-center justify-between gap-6 pt-4 border-t border-white/5">
                        <label class="flex items-center gap-2 text-sm text-slate-400 cursor-pointer hover:text-brand-accent transition-colors w-full sm:w-auto focus-within:ring-2 focus-within:ring-brand-accent rounded p-1">
                            <svg class="w-5 h-5 shrink-0" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" /></svg>
                            <span class="truncate file-name-display">Attach files (Max 2 - 5MB)</span>
                            <input type="file" name="files" class="sr-only" aria-label="Attach files" multiple accept="image/*,.pdf,.doc,.docx" />
                        </label>
                        
                        <button type="submit" aria-label="Submit Enquiry" class="submit-btn w-full sm:w-auto px-10 py-3.5 bg-brand-accent text-brand-dark font-bold rounded-lg hover:bg-white focus:outline-none focus:ring-4 focus:ring-white transition-colors duration-300 shadow-lg flex items-center justify-center gap-2 disabled:opacity-70 disabled:cursor-not-allowed">
                            <span class="btn-text">Submit Enquiry</span>
                            <svg class="loading-spinner hidden w-5 h-5 animate-spin text-brand-dark" aria-hidden="true" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                        </button>
                    </div>
                    
                    <p class="form-error-msg hidden text-red-400 text-sm font-medium text-center sm:text-right mt-1 w-full" role="alert">Please complete all required fields.</p>
                </form>
            </div>

            <div class="lg:col-span-5 flex flex-col">
                <div class="w-full h-64 rounded-2xl overflow-hidden mb-8 border border-white/5">
                    <img 
                        src="https://images.unsplash.com/photo-1497366216548-37526070297c?q=80&w=1200&auto=format&fit=crop" 
                        alt="ZetaLogix Engineering Team in Office Discussion" 
                        class="w-full h-full object-cover"
                        loading="lazy"
                    />
                </div>

                <h3 class="font-heading text-2xl font-bold text-white mb-6">What happens next?</h3>
                
                <ol class="flex flex-col gap-5 text-slate-400 text-sm md:text-base leading-relaxed">
                    <li class="flex gap-3">
                        <span class="font-bold text-brand-accent" aria-hidden="true">1.</span>
                        <span>We will review your requirements and respond within 1 business day.</span>
                    </li>
                    <li class="flex gap-3">
                        <span class="font-bold text-brand-accent" aria-hidden="true">2.</span>
                        <span>In the meantime, please review our portfolio and Blog.</span>
                    </li>
                    <li class="flex gap-3">
                        <span class="font-bold text-brand-accent" aria-hidden="true">3.</span>
                        <span>If necessary, we will sign the NDA and begin the project discussion.</span>
                    </li>
                    <li class="flex gap-3">
                        <span class="font-bold text-brand-accent" aria-hidden="true">4.</span>
                        <span>Our software development experts will analyze your requirements and make recommendations on the best ways to bring your concept to life.</span>
                    </li>
                </ol>
            </div>

        </div>
    </div>
</section>

<style>
    .custom-scrollbar::-webkit-scrollbar { width: 6px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: #0f172a; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.1); border-radius: 10px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: rgba(34, 211, 238, 0.5); }
    .modal-embedded-form > section { padding-top: 3rem !important; padding-bottom: 3rem !important; border-top: none !important; background-color: transparent !important; }
    
    /* Accessibility Focus Ring */
    .zeta-contact-form input:focus, 
    .zeta-contact-form textarea:focus {
        outline: none;
        box-shadow: 0 0 0 2px #22d3ee; /* brand-accent */
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const contactForms = document.querySelectorAll('.zeta-contact-form');

        function closeAllDropdowns(exceptList: Element | null = null) {
            document.querySelectorAll('.custom-select-list').forEach(list => {
                if(list !== exceptList) {
                    list.classList.add('opacity-0', 'invisible');
                }
            });
            document.querySelectorAll('.icon-arrow').forEach(arrow => {
                arrow.classList.remove('rotate-180');
            });
            document.querySelectorAll('.custom-select-btn').forEach(btn => {
                btn.setAttribute('aria-expanded', 'false');
            });
        }

        document.addEventListener('click', () => closeAllDropdowns());

        contactForms.forEach(form => {
            const fileInput = form.querySelector('input[type="file"]') as HTMLInputElement;
            const fileDisplay = form.querySelector('.file-name-display');
            if(fileInput && fileDisplay) {
                fileInput.addEventListener('change', () => {
                    if (fileInput.files && fileInput.files.length > 0) {
                        const fileCount = fileInput.files.length;
                        if(fileCount > 2) {
                            fileDisplay.textContent = "Maximum 2 files allowed";
                            fileDisplay.classList.add('text-red-400');
                            fileInput.value = ""; 
                        } else {
                            fileDisplay.textContent = `${fileCount} file(s) selected`;
                            fileDisplay.classList.remove('text-red-400');
                            fileDisplay.classList.add('text-white');
                        }
                    } else {
                        fileDisplay.textContent = "Attach files (Max 2 - 5MB)";
                        fileDisplay.classList.remove('text-white', 'text-red-400');
                    }
                });
            }

            const standardDropdowns = form.querySelectorAll('.custom-dropdown, .group-country');
            standardDropdowns.forEach(dropdown => {
                const btn = dropdown.querySelector('.custom-select-btn');
                const list = dropdown.querySelector('.custom-select-list');
                const arrow = dropdown.querySelector('.icon-arrow');
                const textSpan = dropdown.querySelector('.selected-text');
                const codeSpan = dropdown.querySelector('.selected-code');
                const flagSpan = dropdown.querySelector('.selected-flag');
                const hiddenInput = dropdown.querySelector('.hidden-input') as HTMLInputElement;
                const options = dropdown.querySelectorAll('.custom-option, .country-option');

                if(btn && list) {
                    btn.addEventListener('click', (e) => {
                        e.stopPropagation();
                        const isExpanded = btn.getAttribute('aria-expanded') === 'true';
                        closeAllDropdowns(list);
                        
                        if(!isExpanded) {
                            list.classList.remove('opacity-0', 'invisible');
                            arrow?.classList.add('rotate-180');
                            btn.setAttribute('aria-expanded', 'true');
                        }
                    });

                    // Keyboard Accessibility for Dropdowns
                    btn.addEventListener('keydown', (e) => {
                        const event = e as KeyboardEvent;
                        if (event.key === 'Enter' || event.key === ' ') {
                            event.preventDefault();
                            btn.dispatchEvent(new Event('click'));
                        }
                    });

                    options.forEach(option => {
                        // Click selection
                        option.addEventListener('click', () => {
                            if (option.classList.contains('country-option')) {
                                if(codeSpan && flagSpan && hiddenInput) {
                                    codeSpan.textContent = option.getAttribute('data-code');
                                    flagSpan.textContent = option.getAttribute('data-flag');
                                    hiddenInput.value = option.getAttribute('data-code') || '';
                                }
                            } else {
                                if(textSpan && hiddenInput) {
                                    textSpan.textContent = option.textContent;
                                    textSpan.classList.remove('text-slate-500');
                                    textSpan.classList.add('text-slate-300'); 
                                    hiddenInput.value = option.getAttribute('data-value') || '';
                                }
                            }
                            closeAllDropdowns();
                        });
                        
                        // Keyboard selection
                        option.addEventListener('keydown', (e) => {
                            const event = e as KeyboardEvent;
                            if (event.key === 'Enter') {
                                event.preventDefault();
                                option.dispatchEvent(new Event('click'));
                                (btn as HTMLElement).focus();
                            }
                        });
                    });
                }
            });

            form.querySelectorAll('input.validation-target, textarea.validation-target').forEach(input => {
                input.addEventListener('input', () => {
                    if((input as HTMLInputElement).value.trim() !== '') {
                        input.classList.remove('border-red-500', 'bg-red-500/10');
                        input.classList.add('border-white/10', 'bg-brand-dark');
                        form.querySelector('.form-error-msg')?.classList.add('hidden');
                    }
                });
            });

            const submitBtn = form.querySelector('.submit-btn');

            if (submitBtn) {
                form.addEventListener('submit', async (e) => {
                    e.preventDefault(); 
                    let isValid = true;
                    const errorMsg = form.querySelector('.form-error-msg');
                    
                    ['name', 'email', 'message'].forEach(fieldName => {
                        const input = form.querySelector(`[name="${fieldName}"]`) as HTMLInputElement | HTMLTextAreaElement;
                        if (input && !input.value.trim()) {
                            isValid = false;
                            input.classList.remove('border-white/10', 'bg-brand-dark');
                            input.classList.add('border-red-500', 'bg-red-500/10');
                        }
                    });

                    if (!isValid) {
                        errorMsg?.classList.remove('hidden');
                        return; 
                    }

                    const btnText = submitBtn.querySelector('.btn-text') as HTMLElement;
                    const spinner = submitBtn.querySelector('.loading-spinner');
                    const originalText = btnText.innerText;
                    btnText.innerText = 'Sending...';
                    spinner?.classList.remove('hidden');
                    (submitBtn as HTMLButtonElement).disabled = true;
                    const formData = new FormData(form as HTMLFormElement);

                    try {
                        const response = await fetch('/api/contact', { method: 'POST', body: formData });
                        const result = await response.json();
                        if (response.ok) { window.location.href = '/thank-you'; } 
                        else {
                            alert(`Error: ${result.error || 'Failed to submit.'}`);
                            btnText.innerText = originalText;
                            spinner?.classList.add('hidden');
                            (submitBtn as HTMLButtonElement).disabled = false;
                        }
                    } catch (error) {
                        alert('Network error sending message. Please email hello@zetalogix.com directly.');
                        btnText.innerText = originalText;
                        spinner?.classList.add('hidden');
                        (submitBtn as HTMLButtonElement).disabled = false;
                    }
                });
            }
        });
    });
</script>