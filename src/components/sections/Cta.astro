---
// src/components/sections/Cta.astro
---

<section class="relative py-24 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-dark via-[#09122b] to-[#052b30] -z-10"></div>
    
    <div class="absolute top-0 right-0 -translate-y-12 translate-x-1/3 w-96 h-96 bg-brand-accent/20 rounded-full blur-[100px] -z-10"></div>

    <div class="max-w-4xl mx-auto px-6 text-center z-10">
        <h2 class="font-heading text-4xl md:text-6xl font-bold text-white mb-6 tracking-tight">
            Ready to scale your <br class="hidden md:block" /> digital presence?
        </h2>
        <p class="text-xl text-slate-300 mb-10 max-w-2xl mx-auto">
            Partner with ZetaLogix to build high-performance software, intuitive apps, and powerful AI integrations. Let's discuss your next big idea.
        </p>
        
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a href="/contact" class="w-full sm:w-auto px-8 py-4 bg-brand-accent text-brand-dark font-bold rounded-full hover:bg-white transition-all duration-300 shadow-[0_0_20px_rgba(34,211,238,0.2)]">
                Start a Conversation
            </a>
            <a href="mailto:contact@zetalogix.com" class="w-full sm:w-auto px-8 py-4 bg-transparent text-white font-semibold rounded-full border border-white/20 hover:bg-white/10 transition-all duration-300">
                contact@zetalogix.com
            </a>
        </div>
    </div>
</section>