---
// src/components/sections/CtaBand.astro
interface Props {
	heading?: string;
	body?: string;
	primaryText?: string;
	primaryHref?: string;
}

const {
	heading = 'What would you like your software to do better?',
	body = 'Tell us what you are building, what is getting in the way and what a useful first release would look like. We will help you explore the next step.',
	primaryText = 'Discuss Your Project',
	primaryHref = '/contact',
} = Astro.props;
---

<section class="py-20 px-6 border-t border-white/10 bg-[#070b16]">
	<div class="max-w-4xl mx-auto rounded-3xl border border-white/10 bg-slate-900/60 p-8 md:p-12 text-center">
		<h2 class="text-2xl md:text-4xl font-bold text-white tracking-tight mb-4">
			{heading}
		</h2>
		<p class="text-slate-300 text-base md:text-lg leading-relaxed max-w-2xl mx-auto mb-8">
			{body}
		</p>
		<div class="flex flex-col sm:flex-row items-center justify-center gap-4">
			<a
				href={primaryHref}
				data-astro-prefetch="hover"
				class="cta-primary inline-flex items-center justify-center px-7 py-3.5 rounded-full bg-cyan-400 hover:bg-cyan-300 text-slate-950 font-semibold text-sm"
			>
				{primaryText}
			</a>
			<a
				href="mailto:info@zetalogix.com"
				class="inline-flex items-center justify-center px-6 py-3.5 rounded-full border border-white/15 hover:border-white/30 text-slate-200 hover:text-white font-medium text-sm transition-colors duration-150"
			>
				Email info@zetalogix.com
			</a>
		</div>
	</div>
</section>