---
// src/components/sections/Hero.astro
---

<section class="relative pt-32 pb-20 lg:pt-40 lg:pb-28 overflow-hidden bg-brand-dark bg-grid-pattern border-b border-white/10">
	<!-- Ambient Mesh Lighting -->
	<div
		class="absolute -top-24 left-1/4 w-[550px] h-[550px] bg-cyan-500/15 rounded-full blur-[130px] -z-10 pointer-events-none"
		aria-hidden="true"
	></div>
	<div
		class="absolute top-1/3 right-10 w-[450px] h-[450px] bg-violet-600/15 rounded-full blur-[130px] -z-10 pointer-events-none"
		aria-hidden="true"
	></div>

	<div class="max-w-7xl mx-auto px-6 relative z-10">
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-10 items-center">
			<!-- Left Column: Immediate H1 & Primary Actions (Never reveal-gated per Section A.7) -->
			<div class="lg:col-span-7 text-left">
				<div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-white/[0.04] border border-cyan-400/30 mb-7 backdrop-blur-md shadow-[0_0_20px_rgba(34,211,238,0.1)]">
					<span class="w-2 h-2 rounded-full bg-cyan-400"></span>
					<span class="text-xs font-mono font-bold text-cyan-300 uppercase tracking-widest">
						Web. Mobile. Applied AI.
					</span>
				</div>

				<h1 class="font-heading text-4xl sm:text-5xl lg:text-6xl xl:text-[4rem] font-bold text-white tracking-tight mb-6 leading-[1.08]">
					Software built around your{' '}
					<span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-sky-300 to-violet-400">
						next business move.
					</span>
				</h1>

				<p class="text-base sm:text-lg text-slate-300 mb-10 leading-relaxed prose-measure">
					Zetalogix helps businesses design, build and improve digital products. From customer-facing websites and mobile apps to internal platforms and AI tools, we turn your requirements into a clear plan and a focused delivery process.
				</p>

				<div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 mb-12">
					<a
						href="/contact"
						data-astro-prefetch="hover"
						class="cta-primary inline-flex items-center justify-center px-8 py-4 bg-cyan-400 hover:bg-cyan-300 text-slate-950 font-bold rounded-full text-sm tracking-wide"
					>
						Discuss Your Project
						<svg class="w-4 h-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
						</svg>
					</a>
					<a
						href="#services"
						class="inline-flex items-center justify-center px-8 py-4 bg-white/[0.04] text-white font-semibold rounded-full border border-white/15 hover:bg-white/10 hover:border-white/30 transition-colors duration-150 text-sm"
					>
						Explore Our Services
					</a>
				</div>

				<!-- Architectural Capability Strip -->
				<div class="grid grid-cols-3 gap-4 pt-8 border-t border-white/10">
					<div>
						<span class="block text-xs font-mono uppercase tracking-wider text-cyan-400 mb-1">01 / Web</span>
						<span class="text-xs sm:text-sm font-medium text-slate-300">Responsive Portals &amp; Apps</span>
					</div>
					<div>
						<span class="block text-xs font-mono uppercase tracking-wider text-violet-400 mb-1">02 / Mobile</span>
						<span class="text-xs sm:text-sm font-medium text-slate-300">iOS &amp; Android Journeys</span>
					</div>
					<div>
						<span class="block text-xs font-mono uppercase tracking-wider text-emerald-400 mb-1">03 / Applied AI</span>
						<span class="text-xs sm:text-sm font-medium text-slate-300">Search &amp; Document Systems</span>
					</div>
				</div>
			</div>

			<!-- Right Column: Layered Multi-Device Visual Composition -->
			<div class="lg:col-span-5 relative group">
				<div
					class="absolute -inset-4 bg-gradient-to-tr from-cyan-500/20 via-transparent to-violet-500/20 rounded-3xl blur-2xl opacity-70 pointer-events-none"
					aria-hidden="true"
				></div>

				<!-- Primary Architectural Frame -->
				<div class="device-frame-hover device-frame-desktop relative rounded-2xl overflow-hidden border border-white/15 bg-[#0a0f1d] shadow-[0_25px_70px_rgba(0,0,0,0.75)]">
					<div class="h-8 bg-[#0f172a] border-b border-white/10 flex items-center justify-between px-4">
						<div class="flex items-center gap-1.5">
							<span class="w-2.5 h-2.5 rounded-full bg-rose-500/80"></span>
							<span class="w-2.5 h-2.5 rounded-full bg-amber-500/80"></span>
							<span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80"></span>
						</div>
						<span class="text-[11px] font-mono text-slate-400">zetalogix // modular-architecture</span>
						<span class="w-8"></span>
					</div>

					<img
						src="/assets/zetalogix-v1/custom-software-800.webp"
						srcset="/assets/zetalogix-v1/custom-software-480.webp 480w, /assets/zetalogix-v1/custom-software-800.webp 800w, /assets/zetalogix-v1/custom-software-1200.webp 1200w"
						sizes="(min-width: 1024px) 42vw, 100vw"
						width="1200"
						height="800"
						fetchpriority="high"
						decoding="async"
						alt="Modular components representing connected business software."
						class="w-full aspect-[3/2] object-cover"
					/>
				</div>

				<!-- Floating Secondary Concept Overlay -->
				<div class="device-frame-hover device-frame-mobile hidden sm:block absolute -bottom-6 -left-6 w-56 rounded-2xl overflow-hidden border border-cyan-400/30 bg-[#070b16]/95 backdrop-blur-xl p-4 shadow-2xl">
					<div class="flex items-center gap-2 mb-2">
						<span class="w-2 h-2 rounded-full bg-cyan-400"></span>
						<span class="text-[11px] font-mono uppercase tracking-wider text-cyan-300">Staged Delivery</span>
					</div>
					<p class="text-xs text-slate-300 leading-snug">
						Clear scope, reviewable milestones and documented handover.
					</p>
				</div>
			</div>
		</div>
	</div>
</section>