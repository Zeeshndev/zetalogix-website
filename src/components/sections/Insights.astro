---
// src/components/sections/Insights.astro
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

const allPosts = await getCollection('blog');

const latestPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

// NEW: Helper function stops VS Code from crashing in the map loop
const formatDate = (date: Date) => {
    return new Date(date).toLocaleDateString('en-US', {
        month: 'short',
        day: '2-digit',
        year: 'numeric',
    });
};
---

<section class="py-24 lg:py-32 bg-[#02040a] relative border-t border-white/5">
    <div class="max-w-7xl mx-auto px-6">
        
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-20 gap-8">
            <div class="max-w-2xl">
                <h2 class="font-heading text-sm font-bold tracking-widest text-brand-glow uppercase mb-3">Engineering Blog</h2>
                <h3 class="font-heading text-4xl md:text-5xl font-bold text-white">Latest <span class="text-brand-accent">Insights.</span></h3>
            </div>
            <a href="/blog" class="inline-flex items-center text-brand-accent font-bold hover:text-white transition-colors">
                Read All Articles <svg class="w-5 h-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
            </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {latestPosts.map((post) => (
                <a href={`/blog/${post.id}`} class="group cursor-pointer block">
                    <article>
                        <div class="w-full h-60 rounded-2xl overflow-hidden mb-6 relative">
                            <div class="absolute inset-0 bg-brand-dark/20 group-hover:bg-transparent transition-colors duration-500 z-10"></div>
                            <img 
                                src={post.data.image} 
                                alt={post.data.title} 
                                class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700" 
                                loading="lazy" 
                            />
                        </div>
                        <div class="flex items-center gap-4 mb-4">
                            <span class="text-xs font-bold text-brand-accent uppercase tracking-wider">
                                {post.data.category}
                            </span>
                            <span class="text-slate-500 text-sm">
                                {formatDate(post.data.pubDate)}
                            </span>
                        </div>
                        <h4 class="font-heading text-xl font-bold text-white mb-3 group-hover:text-brand-glow transition-colors">
                            {post.data.title}
                        </h4>
                        <p class="text-slate-400 text-sm leading-relaxed line-clamp-2">
                            {post.data.description}
                        </p>
                    </article>
                </a>
            ))}
        </div>
    </div>
</section>