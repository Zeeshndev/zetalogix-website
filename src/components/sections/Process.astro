---
// src/components/sections/Process.astro
const steps = [
	{
		step: '01',
		title: 'Understand the problem',
		description:
			'We identify the users, essential workflows and constraints. The output is a shared definition of what the first release needs to achieve.',
	},
	{
		step: '02',
		title: 'Make the product tangible',
		description:
			'We map user journeys and test key screens before development. Early feedback helps resolve uncertainty while changes are still inexpensive.',
	},
	{
		step: '03',
		title: 'Build in reviewable stages',
		description:
			'We break the work into milestones and demonstrate progress. You can review what is working and discuss changes with context.',
	},
	{
		step: '04',
		title: 'Prepare for real use',
		description:
			'We check the agreed journeys, error states and deployment requirements. Performance, accessibility and security checks are scoped to the product.',
	},
	{
		step: '05',
		title: 'Support the next iteration',
		description:
			'We document the handover and agree what happens after launch, including maintenance responsibilities and future improvements.',
	},
];

const reasons = [
	{
		number: 'I',
		title: 'Practical scope',
		description:
			'We help separate launch essentials from later improvements, so the project starts with a useful, achievable goal.',
	},
	{
		number: 'II',
		title: 'Visible progress',
		description:
			'Clear deliverables and regular reviews make it easier to understand where the work stands.',
	},
	{
		number: 'III',
		title: 'Maintainable foundations',
		description:
			'Technology choices should fit your product, your budget and the people who will maintain it.',
	},
];
---

<section class="py-24 lg:py-32 bg-brand-dark relative border-b border-white/10">
	<div class="max-w-7xl mx-auto px-6">
		<!-- Sticky Split-Screen Delivery Process -->
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start mb-28">
			<!-- Left Column: Sticky Narrative Anchor -->
			<div class="reveal lg:col-span-5 lg:sticky lg:top-32">
				<span class="font-mono text-xs font-bold tracking-widest text-cyan-400 uppercase mb-4 flex items-center gap-2">
					<span class="w-8 h-px bg-cyan-400"></span> Staged Delivery
				</span>
				<h2 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight leading-tight mb-6">
					A clear route from idea to release
				</h2>
				<p class="text-slate-300 text-base leading-relaxed mb-8 prose-measure">
					Every stage produces a practical output you can inspect—from defining the initial scope and testing key journeys to milestone demonstrations and documented handover.
				</p>

				<div class="rounded-2xl overflow-hidden border border-white/10 bg-[#0a0f1d]">
					<img
						src="/assets/zetalogix-v1/ui-ux-design-800.webp"
						srcset="/assets/zetalogix-v1/ui-ux-design-480.webp 480w, /assets/zetalogix-v1/ui-ux-design-800.webp 800w, /assets/zetalogix-v1/ui-ux-design-1200.webp 1200w"
						sizes="(min-width: 1024px) 38vw, 100vw"
						width="800"
						height="533"
						loading="lazy"
						decoding="async"
						alt="Illustrative design workspace with wireframes and a tablet prototype."
						class="w-full aspect-[16/10] object-cover"
					/>
					<div class="px-5 py-3 bg-[#070b16] border-t border-white/10 text-xs text-slate-400">
						Illustrative design scene; wireframes and prototypes help resolve uncertainty before full implementation.
					</div>
				</div>
			</div>

			<!-- Right Column: Vertical Glowing Timeline with Oversized Ghost Numbers -->
			<div class="lg:col-span-7 relative pl-6 sm:pl-10 border-l border-white/15 space-y-12">
				{steps.map((item) => (
					<div class="reveal relative group">
						<!-- Timeline Node -->
						<div
							class="absolute -left-[31px] sm:-left-[47px] top-2 w-3.5 h-3.5 rounded-full bg-[#050814] border-2 border-cyan-400 group-hover:scale-125 transition-transform duration-150 shadow-[0_0_12px_rgba(34,211,238,0.6)]"
							aria-hidden="true"
						></div>

						<div class="p-7 sm:p-8 rounded-3xl bg-[#0a0f1d]/90 border border-white/10 group-hover:border-cyan-400/30 transition-colors duration-200">
							<div class="flex items-baseline gap-4 mb-3">
								<span class="font-heading text-4xl sm:text-5xl font-bold text-white/10 group-hover:text-cyan-400/25 transition-colors select-none tracking-tighter">
									{item.step}
								</span>
								<h3 class="font-heading text-xl sm:text-2xl font-bold text-white group-hover:text-cyan-400 transition-colors duration-150">
									{item.title}
								</h3>
							</div>
							<p class="text-slate-300 text-sm sm:text-base leading-relaxed prose-measure">
								{item.description}
							</p>
						</div>
					</div>
				))}
			</div>
		</div>

		<!-- Decisions You Can Understand (Asymmetric Architectural Highlight) -->
		<div class="reveal rounded-[2.25rem] bg-gradient-to-br from-slate-900/90 via-[#0a0f1d] to-[#070b16] border border-white/15 p-8 sm:p-12 lg:p-14 relative overflow-hidden">
			<div
				class="absolute -right-20 -bottom-20 w-96 h-96 bg-cyan-500/10 rounded-full blur-[100px] pointer-events-none"
				aria-hidden="true"
			></div>

			<div class="max-w-2xl mb-12">
				<span class="font-mono text-xs font-bold tracking-widest text-violet-400 uppercase block mb-3">
					Working Practices
				</span>
				<h2 class="font-heading text-3xl sm:text-4xl font-bold text-white tracking-tight">
					Decisions you can understand
				</h2>
			</div>

			<div class="grid grid-cols-1 lg:grid-cols-3 gap-8 divide-y lg:divide-y-0 lg:divide-x divide-white/10">
				{reasons.map((reason, index) => (
					<div class={index === 0 ? 'pt-0 lg:pr-8' : 'pt-8 lg:pt-0 lg:px-8'}>
						<span class="inline-block font-mono text-xs font-bold text-cyan-400 px-2.5 py-1 rounded bg-cyan-400/10 border border-cyan-400/20 mb-4">
							Principle {reason.number}
						</span>
						<h3 class="font-heading text-xl font-bold text-white mb-3">
							{reason.title}
						</h3>
						<p class="text-slate-300 text-sm sm:text-base leading-relaxed">
							{reason.description}
						</p>
					</div>
				))}
			</div>
		</div>
	</div>
</section>