---

<section class="py-24 lg:py-32 bg-brand-dark relative border-b border-white/10">
	<div class="max-w-7xl mx-auto px-6">
		<!-- Editorial Header -->
		<div class="reveal flex flex-col md:flex-row md:items-end justify-between mb-20 gap-8">
			<div class="max-w-2xl">
				<span class="font-mono text-xs font-bold tracking-widest text-cyan-400 uppercase mb-4 flex items-center gap-2">
					<span class="w-8 h-px bg-cyan-400"></span> Product Explorations
				</span>
				<h2 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-bold text-white leading-tight mb-4">
					See the thinking behind the <span class="text-cyan-400">product.</span>
				</h2>
				<p class="text-slate-300 text-base sm:text-lg leading-relaxed prose-measure">
					Explore original interface concepts for business software. These examples illustrate product and design ideas; they are not client projects or claims of commercial results.
				</p>
			</div>
			<a
				href="/portfolio"
				class="inline-flex items-center pb-1 border-b border-cyan-400 text-cyan-400 hover:text-white hover:border-white transition-colors duration-150 text-base font-semibold shrink-0"
			>
				Explore All Work &amp; Concepts
				<svg class="w-5 h-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
				</svg>
			</a>
		</div>

		<!-- Signature 2-Column Layered Device Frame Showcases (Restored from Original Design) -->
		<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-14 mb-14">
			{concepts.map((concept, idx) => (
				<article
					class={`reveal reveal-delay-${idx + 1} group bg-[#0a0f1d] border border-white/10 rounded-[2.25rem] p-8 md:p-10 hover:border-cyan-400/30 transition-colors duration-200 shadow-2xl flex flex-col h-full overflow-hidden`}
				>
					<!-- Layered Browser + Mobile Phone Mockup Frame -->
					<div class="relative w-full aspect-video flex items-center justify-center mb-10 mt-2">
						<!-- Desktop Browser Window Frame -->
						<div class="device-frame-hover device-frame-desktop absolute top-0 left-0 w-[84%] h-[86%] rounded-xl overflow-hidden border border-white/15 shadow-[0_20px_50px_rgba(0,0,0,0.65)] bg-[#1e293b]">
							<div class="h-6 w-full bg-[#0f172a] border-b border-white/10 flex items-center justify-between px-3">
								<div class="flex items-center gap-1.5">
									<div class="w-2 h-2 rounded-full bg-rose-500/80"></div>
									<div class="w-2 h-2 rounded-full bg-amber-500/80"></div>
									<div class="w-2 h-2 rounded-full bg-emerald-500/80"></div>
								</div>
								<span class="text-[10px] font-mono text-slate-400">Design Concept</span>
							</div>
							<img
								src={`/assets/zetalogix-v1/${concept.stem}-800.webp`}
								srcset={`/assets/zetalogix-v1/${concept.stem}-480.webp 480w, /assets/zetalogix-v1/${concept.stem}-800.webp 800w, /assets/zetalogix-v1/${concept.stem}-1200.webp 1200w`}
								sizes="(min-width: 1024px) 42vw, 90vw"
								width="800"
								height="533"
								loading="lazy"
								decoding="async"
								alt={concept.alt}
								class="w-full h-full object-cover object-top"
							/>
						</div>

						<!-- Overlapping Mobile Phone Frame -->
						<div class="device-frame-hover device-frame-mobile absolute -bottom-3 right-2 w-[28%] aspect-[9/19] rounded-[1.5rem] overflow-hidden border-[4px] border-[#020617] shadow-[0_30px_60px_rgba(0,0,0,0.9)] bg-[#020617] z-20">
							<div class="absolute top-0 left-1/2 -translate-x-1/2 w-1/3 h-3 bg-[#020617] rounded-b-lg z-30"></div>
							<img
								src={`/assets/zetalogix-v1/${concept.stem}-480.webp`}
								width="480"
								height="320"
								loading="lazy"
								decoding="async"
								alt=""
								class="w-full h-full object-cover object-center"
							/>
						</div>
					</div>

					<!-- Showcase Details -->
					<div class="flex flex-col flex-grow">
						<div class="flex flex-wrap items-center gap-2.5 text-xs font-bold uppercase tracking-wider mb-4">
							<span class="px-2.5 py-1 rounded-md bg-amber-500/10 border border-amber-400/30 text-amber-300 font-mono text-[11px] normal-case">
								{concept.badge}
							</span>
							<span class="text-cyan-400">{concept.category}</span>
							<span class="text-slate-600">&bull;</span>
							<span class="text-slate-400">{concept.type}</span>
						</div>

						<h3 class="font-heading text-2xl md:text-3xl font-bold text-white mb-3 leading-tight group-hover:text-cyan-400 transition-colors duration-150">
							<a href={concept.href}>{concept.title}</a>
						</h3>

						<p class="text-slate-300 leading-relaxed text-base mb-8 flex-grow">
							{concept.description}
						</p>

						<div class="flex items-center justify-between mt-auto pt-6 border-t border-white/10">
							<div class="flex -space-x-2" aria-label="Representative technologies">
								{concept.techStack.map((tech) => (
									<div
										class="w-9 h-9 rounded-full bg-white flex items-center justify-center shadow-md border-2 border-[#0a0f1d] relative z-10"
										title={tech.name}
									>
										<div class="w-4 h-4 flex items-center justify-center" set:html={tech.svg} />
									</div>
								))}
							</div>

							<a
								href={concept.href}
								class="inline-flex items-center text-sm font-bold text-cyan-400 hover:text-white transition-colors duration-150"
							>
								Explore the Concept
								<svg class="w-4 h-4 ml-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
								</svg>
							</a>
						</div>
					</div>
				</article>
			))}
		</div>

		<!-- Full-Width Featured Split Showcase for 3rd Concept (Breaks 2-Col Grid Monotony) -->
		<article class="reveal group bg-gradient-to-br from-[#0a0f1d] via-[#0c1326] to-[#0a0f1d] border border-white/10 hover:border-cyan-400/30 rounded-[2.25rem] p-8 md:p-12 shadow-2xl">
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
				<div class="lg:col-span-6 order-2 lg:order-1 flex flex-col justify-center">
					<div class="flex flex-wrap items-center gap-2.5 text-xs font-bold uppercase tracking-wider mb-4">
						<span class="px-2.5 py-1 rounded-md bg-amber-500/10 border border-amber-400/30 text-amber-300 font-mono text-[11px] normal-case">
							{featuredConcept.badge}
						</span>
						<span class="text-cyan-400">{featuredConcept.category}</span>
					</div>

					<h3 class="font-heading text-2xl sm:text-3xl lg:text-4xl font-bold text-white mb-4 leading-tight group-hover:text-cyan-400 transition-colors duration-150">
						<a href={featuredConcept.href}>{featuredConcept.title}</a>
					</h3>

					<p class="text-slate-300 text-base sm:text-lg leading-relaxed mb-8 prose-measure">
						{featuredConcept.description}
					</p>

					<div class="flex items-center justify-between pt-6 border-t border-white/10">
						<div class="flex -space-x-2" aria-label="Representative technologies">
							{featuredConcept.techStack.map((tech) => (
								<div
									class="w-9 h-9 rounded-full bg-white flex items-center justify-center shadow-md border-2 border-[#0a0f1d] relative z-10"
									title={tech.name}
								>
									<div class="w-4 h-4 flex items-center justify-center" set:html={tech.svg} />
								</div>
							))}
						</div>

						<a
							href={featuredConcept.href}
							class="inline-flex items-center text-sm font-bold text-cyan-400 hover:text-white transition-colors duration-150"
						>
							Explore the Concept
							<svg class="w-4 h-4 ml-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
							</svg>
						</a>
					</div>
				</div>

				<div class="lg:col-span-6 order-1 lg:order-2">
					<div class="device-frame-hover device-frame-desktop rounded-2xl overflow-hidden border border-white/15 shadow-[0_20px_50px_rgba(0,0,0,0.65)] bg-[#0f172a]">
						<div class="h-7 w-full bg-[#0f172a] border-b border-white/10 flex items-center justify-between px-4">
							<div class="flex items-center gap-1.5">
								<div class="w-2 h-2 rounded-full bg-rose-500/80"></div>
								<div class="w-2 h-2 rounded-full bg-amber-500/80"></div>
								<div class="w-2 h-2 rounded-full bg-emerald-500/80"></div>
							</div>
							<span class="text-[10px] font-mono text-slate-400">Knowledge Retrieval Study</span>
						</div>
						<img
							src={`/assets/zetalogix-v1/${featuredConcept.stem}-800.webp`}
							srcset={`/assets/zetalogix-v1/${featuredConcept.stem}-480.webp 480w, /assets/zetalogix-v1/${featuredConcept.stem}-800.webp 800w, /assets/zetalogix-v1/${featuredConcept.stem}-1200.webp 1200w`}
							sizes="(min-width: 1024px) 48vw, 100vw"
							width="1200"
							height="800"
							loading="lazy"
							decoding="async"
							alt={featuredConcept.alt}
							class="w-full aspect-[3/2] object-cover"
						/>
					</div>
				</div>
			</div>
		</article>
	</div>
</section>