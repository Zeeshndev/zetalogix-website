const featuredConcept = {
	title: 'Document Search Concept',
	badge: 'Design concept — not client work',
	category: 'Applied AI & Retrieval',
	type: 'Knowledge System Concept',
	description:
		'An illustration of organizing business information for a permission-aware search and review experience.',
	href: '/concepts/document-search',
	stem: 'ai-solutions',
	alt: 'Conceptual illustration of unstructured information becoming organized.',
	techStack: [
		{
			name: 'Python',
			svg: `<svg viewBox="0 0 24 24" fill="#3776AB"><path d="M14.25.18l.9.2.73.26.59.3.45.32.34.34.25.34.16.33.1.3.04.26.02.2-.01.13V8.5l-.05.63-.13.55-.21.46-.26.38-.3.31-.33.25-.35.19-.35.14-.36.1-.37.04h-3.36l.6 1.15.38 1.12.16 1.05.02 1v2.85l-.05.64-.14.56-.21.47-.27.38-.3.32-.34.24-.35.19-.36.14-.36.1-.37.04H5.46l-.54-.04-.5-.14-.44-.24-.36-.33-.27-.42-.16-.5-.04-.54v-3.76l.04-.54.16-.5.27-.42.36-.33.44-.24.5-.14.54-.04h1.76v-2.3h-3.6l-.64-.05-.56-.14-.47-.21-.38-.27-.32-.3-.24-.34-.19-.35-.14-.36-.1-.36-.04-.37v-3.36l1.15.6 1.12.38 1.05.16 1 .02h2.85l.64-.05.56-.14.47-.21.38-.27.32-.3.24-.34.19-.35.14-.36.1-.36.04-.37V.18z"/></svg>`,
		},
		{
			name: 'Vector Search',
			svg: `<svg viewBox="0 0 24 24" fill="#22D3EE"><path d="M12 2L2 7l10 5 10-5-10-5zm0 7.5l-6-3 6-3 6 3-6 3zm0 2.5l-10-5v5l10 5 10-5v-5l-10 5zm0 5l-10-5v5l10 5 10-5v-5l-10 5z"/></svg>`,
		},
		{
			name: 'TypeScript',
			svg: `<svg viewBox="0 0 24 24" fill="#3178C6"><path d="M2.2 0h19.6C23 0 24 1 24 2.2v19.6c0 1.2-1 2.2-2.2 2.2H2.2C1 24 0 23 0 21.8V2.2C0 1 1 0 2.2 0zm14.3 17.6c.4 0 .9-.1 1.3-.3.4-.2.7-.5.9-.9.2-.4.3-1 .3-1.7V9.5h-2.2v5.2c0 .4-.1.7-.3.8-.2.1-.4.2-.7.2-.3 0-.5-.1-.7-.2-.2-.1-.3-.4-.3-.8V9.5H12.7v5.5c0 1.2.3 2.1 1 2.7.7.5 1.6.7 2.8.7zm-6.1-.2v-6.1H7.8V9.5h7.2v1.8h-2.5v6.1H10.4z"/></svg>`,
