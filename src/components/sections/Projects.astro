---
// src/components/sections/Projects.astro
const concepts = [
	{
		title: 'Appointment Booking Concept',
		badge: 'Design concept — not client work',
		description: 'A mobile journey for finding a service, choosing an available time and reviewing a booking.',
		href: '/concepts/appointment-booking',
		stem: 'mobile-development',
		alt: 'Original mobile booking interface concept on two phones.',
	},
	{
		title: 'Team Workspace Concept',
		badge: 'Design concept — not client work',
		description: 'A dashboard direction for organizing work, viewing project cards and managing account roles.',
		href: '/concepts/team-workspace',
		stem: 'saas-development',
		alt: 'Original dashboard concept with project cards and account controls.',
	},
	{
		title: 'Document Search Concept',
		badge: 'Design concept — not client work',
		description:
			'An illustration of organizing business information for a permission-aware search and review experience.',
		href: '/concepts/document-search',
		stem: 'ai-solutions',
		alt: 'Conceptual illustration of unstructured information becoming organized.',
	},
];
---

<section class="py-20 lg:py-28 bg-brand-dark border-b border-white/5">
	<div class="max-w-7xl mx-auto px-6">
		<div class="flex flex-col md:flex-row md:items-end justify-between mb-14 gap-6">
			<div class="max-w-2xl">
				<h2 class="font-heading text-3xl md:text-4xl font-bold text-white tracking-tight mb-4">
					See the thinking behind the product
				</h2>
				<p class="text-slate-300 text-base leading-relaxed prose-measure">
					Explore original interface concepts for business software. These examples illustrate product and design ideas; they are not client projects or claims of commercial results.
				</p>
			</div>
			<a
				href="/portfolio"
				class="inline-flex items-center text-sm font-semibold text-cyan-400 hover:text-cyan-300 transition-colors duration-150 shrink-0"
			>
				View All Concepts
				<svg class="w-4 h-4 ml-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
				</svg>
			</a>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
			{concepts.map((concept) => (
				<article class="interactive-card bg-[#0a0f1d] border border-white/10 hover:border-cyan-400/40 rounded-2xl overflow-hidden flex flex-col">
					<div class="aspect-[3/2] w-full bg-slate-900 overflow-hidden border-b border-white/5">
						<img
							src={`/assets/zetalogix-v1/${concept.stem}-800.webp`}
							srcset={`/assets/zetalogix-v1/${concept.stem}-480.webp 480w, /assets/zetalogix-v1/${concept.stem}-800.webp 800w, /assets/zetalogix-v1/${concept.stem}-1200.webp 1200w`}
							sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
							width="800"
							height="533"
							loading="lazy"
							decoding="async"
							alt={concept.alt}
							class="w-full h-full object-cover"
						/>
					</div>

					<div class="p-6 flex flex-col flex-grow">
						<div class="mb-3">
							<span class="inline-block px-2.5 py-1 rounded-md bg-amber-500/10 border border-amber-400/30 text-amber-300 text-xs font-medium">
								{concept.badge}
							</span>
						</div>

						<h3 class="font-heading text-xl font-bold text-white mb-2.5">
							<a href={concept.href} class="hover:text-cyan-400 transition-colors duration-150">
								{concept.title}
							</a>
						</h3>

						<p class="text-slate-300 text-sm leading-relaxed mb-6 flex-grow">
							{concept.description}
						</p>

						<a
							href={concept.href}
							class="inline-flex items-center text-sm font-semibold text-cyan-400 hover:text-cyan-300 transition-colors duration-150 mt-auto"
						>
							Explore the Concept
							<svg class="w-4 h-4 ml-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
							</svg>
						</a>
					</div>
				</article>
			))}
		</div>
	</div>
</section>