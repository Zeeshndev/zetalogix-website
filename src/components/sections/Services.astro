---
// src/components/sections/Services.astro

const services = [
  {
    title: "Mobile App Development",
    description: "Native iOS, Android, and cross-platform applications built for speed, security, and seamless user experiences.",
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>`,
    link: "/services/mobile-development"
  },
  {
    title: "Custom Software Dev",
    description: "Bespoke software solutions engineered from the ground up to solve your unique business challenges and streamline operations.",
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>`,
    link: "/services/custom-software"
  },
  {
    title: "Web Development",
    description: "High-conversion web platforms, SaaS products, and enterprise portals built on cutting-edge frameworks like Astro and React.",
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" /></svg>`,
    link: "/services/web-development"
  },
  {
    title: "UI/UX Design",
    description: "Data-driven, aesthetic interface designs focused on maximizing user engagement, accessibility, and brand identity.",
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" /></svg>`,
    link: "/services/ui-ux-design"
  },
  {
    title: "AI & Machine Learning",
    description: "Integrate intelligent automation, predictive analytics, and custom LLMs directly into your business workflows.",
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" /></svg>`,
    link: "/services/ai-solutions"
  },
  {
    title: "SaaS Development",
    description: "End-to-end architecture and engineering for multi-tenant cloud applications, secure subscription billing, and modular dashboards.",
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>`,
    link: "/services/saas-development"
  }
];
---

<section id="services" class="relative py-24 lg:py-32 bg-brand-dark overflow-hidden">
    <div class="absolute inset-0 opacity-[0.03] bg-[radial-gradient(#ffffff_1px,transparent_1px)] [background-size:24px_24px] pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-6 relative z-10">
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-8">
            <div class="max-w-2xl">
                <h2 class="font-heading text-sm font-bold tracking-widest text-brand-glow uppercase mb-3 flex items-center gap-2">
                    <span class="w-8 h-px bg-brand-glow"></span> Our Services
                </h2>
                <h3 class="font-heading text-4xl md:text-5xl font-bold text-white leading-tight">
                    End-to-End <span class="text-brand-accent">Digital</span> Transformation.
                </h3>
            </div>
            <p class="text-slate-400 text-lg md:max-w-sm">
                From initial strategy to final deployment, we provide the comprehensive technical expertise your business needs to scale globally.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {services.map((service) => (
                <div class="group flex flex-col p-8 rounded-2xl bg-[#0a0f1d] border border-white/[0.05] hover:bg-[#0d1425] hover:border-brand-accent/40 transition-all duration-300">
                    
                    <div class="w-14 h-14 rounded-xl bg-brand-dark border border-white/10 text-brand-accent flex items-center justify-center mb-6 shadow-lg group-hover:scale-110 group-hover:bg-brand-accent group-hover:text-brand-dark transition-all duration-300" set:html={service.icon} />
                    
                    <h4 class="font-heading text-2xl font-bold text-white mb-3">{service.title}</h4>
                    <p class="text-slate-400 leading-relaxed flex-grow mb-6">
                        {service.description}
                    </p>
                    
                    <a href={service.link} class="mt-auto inline-flex items-center text-sm font-semibold text-slate-300 group-hover:text-brand-accent transition-colors w-fit">
                        Learn More 
                        <svg class="w-4 h-4 ml-2 group-hover:translate-x-2 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                        </svg>
                    </a>
                </div>
            ))}
        </div>
    </div>
</section>