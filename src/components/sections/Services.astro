---
// src/components/sections/Services.astro
const coreServices = [
	{
		title: 'Web development',
		href: '/services/web-development',
		description:
			'Give your customers a faster, clearer way to discover your business and use your services. We build responsive websites, web applications and connected business portals.',
	},
	{
		title: 'Mobile app development',
		href: '/services/mobile-development',
		description:
			"Put your service in your customers' hands. We plan mobile journeys, build the supporting systems and help prepare your product for release.",
	},
	{
		title: 'AI and machine learning',
		href: '/services/ai-solutions',
		description:
			'Make business information more useful. We develop tools for document processing, knowledge search, prediction and workflow assistance, with evaluation built into the process.',
	},
];

const supportingServices = [
	{
		title: 'SaaS development',
		href: '/services/saas-development',
		description: 'Subscription products with clear roles, onboarding and room to grow.',
	},
	{
		title: 'Custom software engineering',
		href: '/services/custom-software',
		description: 'Internal tools, workflows and integrations shaped around your operations.',
	},
	{
		title: 'UI/UX design',
		href: '/services/ui-ux-design',
		description: 'User journeys, wireframes, testable prototypes and development-ready interfaces.',
	},
];
---

<section id="services" class="py-20 lg:py-28 bg-brand-dark border-b border-white/5">
	<div class="max-w-7xl mx-auto px-6">
		<div class="max-w-2xl mb-14">
			<h2 class="font-heading text-3xl md:text-4xl font-bold text-white tracking-tight mb-4">
				What do you need to build?
			</h2>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
			{coreServices.map((service) => (
				<article class="interactive-card bg-[#0a0f1d] border border-white/10 hover:border-cyan-400/40 rounded-2xl p-8 flex flex-col justify-between">
					<div>
						<h3 class="font-heading text-xl font-bold text-white mb-3">
							<a href={service.href} class="hover:text-cyan-400 transition-colors duration-150">
								{service.title}
							</a>
						</h3>
						<p class="text-slate-300 text-sm leading-relaxed mb-6 prose-measure">
							{service.description}
						</p>
					</div>
					<a
						href={service.href}
						class="inline-flex items-center text-sm font-semibold text-cyan-400 hover:text-cyan-300 transition-colors duration-150"
					>
						Explore {service.title.toLowerCase()}
						<svg class="w-4 h-4 ml-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
						</svg>
					</a>
				</article>
			))}
		</div>

		<div class="rounded-2xl bg-slate-900/50 border border-white/10 p-6 md:p-8">
			<p class="text-slate-200 font-medium text-sm md:text-base mb-6">
				Need help with a specific stage? Explore SaaS development, custom software engineering and UI/UX design.
			</p>
			<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
				{supportingServices.map((item) => (
					<a
						href={item.href}
						class="interactive-card group block p-5 rounded-xl bg-[#0a0f1d]/80 border border-white/5 hover:border-cyan-400/30"
					>
						<h3 class="text-white font-semibold text-base group-hover:text-cyan-400 transition-colors duration-150 mb-1.5">
							{item.title}
						</h3>
						<p class="text-slate-400 text-xs leading-relaxed">
							{item.description}
						</p>
					</a>
				))}
			</div>
		</div>
	</div>
</section>