---
// src/components/sections/Stats.astro
---

<section class="py-20 bg-brand-accent relative border-y border-white/5">
    <div class="absolute inset-0 bg-[#02040a] opacity-95"></div>
    
    <div class="max-w-7xl mx-auto px-6 relative z-10">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-12 text-center divide-x divide-white/10">
            <div class="flex flex-col items-center">
                <span class="text-4xl md:text-5xl font-heading font-bold text-brand-accent mb-2">99.9%</span>
                <span class="text-slate-400 text-sm font-semibold uppercase tracking-wider">Uptime SLA</span>
            </div>
            <div class="flex flex-col items-center">
                <span class="text-4xl md:text-5xl font-heading font-bold text-brand-accent mb-2">35+</span>
                <span class="text-slate-400 text-sm font-semibold uppercase tracking-wider">Enterprise Deploys</span>
            </div>
            <div class="flex flex-col items-center">
                <span class="text-4xl md:text-5xl font-heading font-bold text-brand-accent mb-2">&lt; 10ms</span>
                <span class="text-slate-400 text-sm font-semibold uppercase tracking-wider">API Latency</span>
            </div>
            <div class="flex flex-col items-center">
                <span class="text-4xl md:text-5xl font-heading font-bold text-brand-accent mb-2">100%</span>
                <span class="text-slate-400 text-sm font-semibold uppercase tracking-wider">Code Ownership</span>
            </div>
        </div>
    </div>
</section>