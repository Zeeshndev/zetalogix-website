---
// src/layouts/BaseLayout.astro
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';

interface BreadcrumbItem {
	name: string;
	url: string;
}

interface ArticleMeta {
	headline: string;
	datePublished: string;
	dateModified?: string;
	authorName: string;
}

interface Props {
	title: string;
	description?: string;
	image?: string;
	type?: 'website' | 'article';
	noindex?: boolean;
	breadcrumbs?: BreadcrumbItem[];
	article?: ArticleMeta;
}

const siteUrl = 'https://zetalogix.com';

const {
	title,
	description = 'Build useful digital products with Zetalogix. Explore web development, mobile apps, custom software and AI solutions for your business.',
	image = '/assets/Logo.webp',
	type = 'website',
	noindex = false,
	breadcrumbs = [],
	article,
} = Astro.props;

const rawPath = Astro.url.pathname;
const normalizedPath = rawPath.length > 1 && rawPath.endsWith('/') ? rawPath.slice(0, -1) : rawPath;
const canonicalURL = new URL(normalizedPath, siteUrl).toString();
const socialImageURL = new URL(image, siteUrl).toString();

const organizationSchema = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	name: 'Zetalogix',
	url: siteUrl,
	logo: `${siteUrl}/assets/Logo.webp`,
	email: 'info@zetalogix.com',
	address: {
		'@type': 'PostalAddress',
		streetAddress: 'Plot #10 G, Mini Commercial, Phase 7, Bahria Town',
		addressLocality: 'Rawalpindi',
		addressCountry: 'PK',
	},
	contactPoint: {
		'@type': 'ContactPoint',
		contactType: 'customer support',
		email: 'info@zetalogix.com',
		availableLanguage: ['English'],
	},
};

const breadcrumbSchema =
	breadcrumbs.length > 0
		? {
				'@context': 'https://schema.org',
				'@type': 'BreadcrumbList',
				itemListElement: breadcrumbs.map((item, index) => ({
					'@type': 'ListItem',
					position: index + 1,
					name: item.name,
					item: new URL(item.url, siteUrl).toString(),
				})),
			}
		: null;

const articleSchema = article
	? {
			'@context': 'https://schema.org',
			'@type': 'Article',
			headline: article.headline,
			datePublished: article.datePublished,
			dateModified: article.dateModified || article.datePublished,
			author: {
				'@type': 'Person',
				name: article.authorName,
			},
			publisher: {
				'@type': 'Organization',
				name: 'Zetalogix',
				logo: {
					'@type': 'ImageObject',
					url: `${siteUrl}/assets/Logo.webp`,
				},
			},
			mainEntityOfPage: canonicalURL,
			image: socialImageURL,
		}
	: null;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/favicon.png?v=2" />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />

		{noindex && <meta name="robots" content="noindex, follow" />}

		<meta property="og:type" content={type} />
		<meta property="og:site_name" content="Zetalogix" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={socialImageURL} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImageURL} />

		<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} is:inline></script>
		{breadcrumbSchema && (
			<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline></script>
		)}
		{articleSchema && (
			<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} is:inline></script>
		)}
	</head>
	<body class="bg-brand-dark text-slate-300 font-sans antialiased selection:bg-brand-accent selection:text-brand-dark">
		<a
			href="#main-content"
			class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[300] focus:px-4 focus:py-2.5 focus:rounded-lg focus:bg-brand-accent focus:text-slate-950 focus:font-semibold focus:shadow-lg"
		>
			Skip to main content
		</a>

		<main id="main-content" tabindex="-1" class="min-h-screen flex flex-col focus:outline-none">
			<slot />
		</main>

		<script>
			const initScrollReveal = () => {
				if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

				const elements = document.querySelectorAll('.reveal');
				if (!elements.length || !('IntersectionObserver' in window)) return;

				document.documentElement.classList.add('js-reveal-ready');

				const observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) {
								entry.target.classList.add('is-visible');
								observer.unobserve(entry.target);
							}
						});
					},
					{ rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
				);

				elements.forEach((el) => observer.observe(el));
			};

			initScrollReveal();
		</script>

		<style is:global>
			:focus-visible {
				outline: 2px solid #22d3ee !important;
				outline-offset: 4px !important;
				border-radius: 4px;
			}

			:focus:not(:focus-visible) {
				outline: none;
			}

			/* Subtle architectural background grid */
			.bg-grid-pattern {
				background-size: 48px 48px;
				background-image: 
					linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
					linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
			}

			/* Progressive enhancement scroll reveal (350-450ms + 12px per Section A.7) */
			html.js-reveal-ready .reveal {
				opacity: 0;
				transform: translateY(12px);
				transition: opacity 420ms cubic-bezier(0.22, 1, 0.36, 1), transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
				will-change: opacity, transform;
			}

			html.js-reveal-ready .reveal.is-visible {
				opacity: 1;
				transform: translateY(0);
			}

			html.js-reveal-ready .reveal-delay-1 {
				transition-delay: 80ms;
			}
			html.js-reveal-ready .reveal-delay-2 {
				transition-delay: 160ms;
			}
			html.js-reveal-ready .reveal-delay-3 {
				transition-delay: 240ms;
			}

			/* Interactive elevation & glow (180-220ms, up to 4px per Section A.7 & B.5) */
			.interactive-card {
				transition: transform 200ms cubic-bezier(0.22, 1, 0.36, 1), border-color 200ms ease, box-shadow 200ms ease, background-color 200ms ease;
			}

			.device-frame-hover {
				transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 220ms ease;
			}

			@media (hover: hover) and (prefers-reduced-motion: no-preference) {
				.interactive-card:hover {
					transform: translateY(-4px);
					box-shadow: 0 20px 40px -15px rgba(34, 211, 238, 0.12);
				}
				.group:hover .device-frame-desktop {
					transform: translateY(-4px);
				}
				.group:hover .device-frame-mobile {
					transform: translate(-4px, -4px);
				}
				.cta-primary:hover {
					transform: translateY(-1px);
					box-shadow: 0 0 28px rgba(34, 211, 238, 0.45);
				}
			}

			.cta-primary {
				transition: background-color 160ms ease, border-color 160ms ease, transform 160ms ease, box-shadow 160ms ease;
				box-shadow: 0 0 18px rgba(34, 211, 238, 0.25);
			}

			.prose-measure {
				max-width: 65ch;
			}

			@media (prefers-reduced-motion: reduce) {
				html {
					scroll-behavior: auto !important;
				}
				*,
				*::before,
				*::after {
					animation-duration: 0.01ms !important;
					animation-iteration-count: 1 !important;
					transition-duration: 0.01ms !important;
					scroll-behavior: auto !important;
				}
				.interactive-card,
				.reveal,
				.device-frame-hover,
				.logo-track,
				.glow-button,
				.cta-primary {
					animation: none !important;
					transition: none !important;
					transform: none !important;
					opacity: 1 !important;
				}
			}
		</style>
	</body>
</html>