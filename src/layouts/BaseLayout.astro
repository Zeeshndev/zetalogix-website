---
// src/layouts/BaseLayout.astro
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';

interface Props {
	title: string;
	description?: string;
    image?: string;
    type?: string;
}

// We set a fallback domain here for Canonical URLs and Social Images
const siteUrl = 'https://zetalogix.com';

const { 
    title, 
    description = "ZetaLogix engineers high-performance web applications, mobile products, and AI solutions for global enterprises and startups.",
    image = "/assets/og-image.jpg", // Make sure to upload a 1200x630px social preview image here later
    type = "website"
} = Astro.props;

// Auto-generate the exact canonical URL to prevent duplicate content penalties from Google
const canonicalURL = new URL(Astro.url.pathname, siteUrl);

// Organization Structured Data (JSON-LD) for rich Google Search Results
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "ZetaLogix",
  "url": siteUrl,
  "logo": `${siteUrl}/assets/Logo.webp`,
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "Customer Service",
    "email": "hello@zetalogix.com",
    "availableLanguage": ["English"]
  },
  "sameAs": [
    "https://www.linkedin.com/company/zetalogix"
  ]
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	    <link rel="icon" type="image/png" href="/favicon.png?v=2" />
		<meta name="generator" content={Astro.generator} />
		
        <!-- Primary Meta Tags -->
		<title>{title}</title>
        <meta name="title" content={title} />
		<meta name="description" content={description} />
        <link rel="canonical" href={canonicalURL} />

        <!-- Open Graph / Facebook / LinkedIn -->
        <meta property="og:type" content={type} />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={new URL(image, siteUrl)} />

        <!-- Twitter -->
        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content={canonicalURL} />
        <meta property="twitter:title" content={title} />
        <meta property="twitter:description" content={description} />
        <meta property="twitter:image" content={new URL(image, siteUrl)} />

        <!-- External Devicon CSS -->
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css" />

        <!-- JSON-LD Structured Data -->
        <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
	</head>
	<body class="bg-brand-dark text-slate-300 font-sans antialiased selection:bg-brand-accent selection:text-brand-dark">
		<main class="min-h-screen flex flex-col">
			<slot /> 
		</main>
	</body>
</html>