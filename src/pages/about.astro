---
// src/pages/about.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/global/Navbar.astro';
import Footer from '../components/global/Footer.astro';

const recognitions = [
  { era: "2023", agency: "Clutch Top 100 Companies", focus: "Global Architecture Focus" },
  { era: "2024", agency: "Top Custom Software Developers", focus: "Scalable Enterprise Engineering" },
  { era: "2025", agency: "Top Web Developers & Tech Agencies", focus: "Astro Ecosystem Specialization" }
];
---

<BaseLayout title="About Us | ZetaLogix">
    <Navbar />
    
    <main class="pt-32 bg-brand-dark text-slate-300 min-h-screen relative overflow-hidden">
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-brand-accent/5 rounded-full blur-[120px] pointer-events-none"></div>

        <div class="max-w-5xl mx-auto px-6 py-12 relative z-10">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center mb-24">
                <div>
                    <h1 class="text-sm font-bold tracking-widest text-brand-accent font-mono uppercase mb-4">Our Narrative</h1>
                    <h2 class="text-3xl md:text-4xl font-bold text-white font-heading mb-6 leading-tight">Revolutionizing the Software Engineering Ecosystem</h2>
                    <p class="text-slate-400 text-base leading-relaxed mb-4">
                        ZetaLogix operates as a premium custom software development agency specializing in modern web ecosystems, cloud applications, cross-platform mobile systems, and intelligent machine learning pipelines.
                    </p>
                    <p class="text-slate-400 text-base leading-relaxed">
                        We balance technology and strategy, converting complex corporate functional objectives into resilient, high-speed codebases built for production workloads.
                    </p>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div class="p-6 rounded-2xl bg-[#0a0f1d] border border-white/5 text-center">
                        <div class="text-3xl font-bold text-brand-accent font-heading mb-2">50+</div>
                        <div class="text-xs text-slate-400 uppercase tracking-wider font-medium">Projects Delivered</div>
                    </div>
                    <div class="p-6 rounded-2xl bg-[#0a0f1d] border border-white/5 text-center">
                        <div class="text-3xl font-bold text-purple-400 font-heading mb-2">20+</div>
                        <div class="text-xs text-slate-400 uppercase tracking-wider font-medium">Tech Architects</div>
                    </div>
                </div>
            </div>

            <div class="bg-[#0a0f1d] border border-white/10 rounded-3xl p-8 md:p-12 mb-24">
                <div class="max-w-3xl">
                    <h2 class="text-sm font-bold tracking-widest text-brand-accent font-mono uppercase mb-4">Value Proposition</h2>
                    <h3 class="text-2xl md:text-3xl font-bold text-white font-heading mb-6">Our Commitment to Enterprise Excellence</h3>
                    <p class="text-slate-400 leading-relaxed mb-6">
                        The global digital market is often flooded with fragile setups that break under heavy user scale or offer rigid interfaces. ZetaLogix was built to solve this problem. 
                    </p>
                    <p class="text-slate-400 leading-relaxed">
                        We ensure complete transparent alignment across our entire pipeline. From the first structural layout mockups to our production server deployments, we focus entirely on asset isolation, data security, and long-term codebase scalability.
                    </p>
                </div>
            </div>

            <div class="mb-24">
                <h2 class="text-2xl font-bold text-white font-heading mb-8 text-center md:text-left">Awards & Recognitions</h2>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    {recognitions.map((item) => (
                        <div class="p-6 rounded-2xl bg-white/[0.02] border border-white/5 hover:border-brand-accent/20 transition-all duration-300 flex items-start gap-4">
                            <span class="text-2xl mt-1">🏆</span>
                            <div>
                                <span class="text-xs text-brand-accent font-mono font-bold block mb-1">{item.era}</span>
                                <h4 class="text-white font-bold text-base leading-snug mb-1">{item.agency}</h4>
                                <p class="text-xs text-slate-500 font-medium">{item.focus}</p>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    </main>

    <Footer />
</BaseLayout>