---
// src/pages/about.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/global/Navbar.astro';
import Footer from '../components/global/Footer.astro';

const principles = [
	{
		title: 'Clarity before complexity',
		description: 'Define the useful outcome before adding features.',
	},
	{
		title: 'Honest trade-offs',
		description: 'Explain the implications of scope, budget, speed and maintenance.',
	},
	{
		title: 'Reviewable progress',
		description: 'Make work visible through agreed milestones and demonstrations.',
	},
	{
		title: 'Responsible handover',
		description: 'Agree access, documentation, ownership and support in writing.',
	},
];
---

<BaseLayout
	title="About Zetalogix | Web, Mobile & AI Development"
	description="Meet the approach behind Zetalogix: practical planning, thoughtful design and software engineering for web, mobile and AI products."
	breadcrumbs={[
		{ name: 'Home', url: '/' },
		{ name: 'About', url: '/about' },
	]}
>
	<Navbar />

	<div class="pt-32 pb-20 bg-brand-dark text-slate-300">
		<div class="max-w-4xl mx-auto px-6">
			<!-- Hero Intro -->
			<header class="mb-16">
				<h1 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight mb-6 leading-tight">
					A software team focused on making your next step clearer.
				</h1>
				<p class="text-slate-300 text-base sm:text-lg leading-relaxed prose-measure">
					Zetalogix brings product design and software development into one conversation. We work with businesses that need to launch a new product, improve an existing platform or make an internal process less complicated.
				</p>
			</header>

			<!-- Section 1 -->
			<section class="mb-16 bg-[#0a0f1d] border border-white/10 rounded-3xl p-8 md:p-10">
				<h2 class="font-heading text-2xl md:text-3xl font-bold text-white mb-4">
					Start with the work people need to do
				</h2>
				<div class="space-y-4 text-slate-300 text-base leading-relaxed prose-measure">
					<p>
						Good software begins with an understanding of its users. We ask how your business operates, where time is lost and what success would look like. Those answers guide the scope, user experience and technical choices.
					</p>
					<p>
						Our core services cover <a href="/services/web-development" class="text-cyan-400 hover:text-cyan-300 underline underline-offset-4">web development</a>, <a href="/services/mobile-development" class="text-cyan-400 hover:text-cyan-300 underline underline-offset-4">mobile applications</a> and <a href="/services/ai-solutions" class="text-cyan-400 hover:text-cyan-300 underline underline-offset-4">applied AI</a>. We also support <a href="/services/saas-development" class="text-cyan-400 hover:text-cyan-300 underline underline-offset-4">SaaS products</a>, <a href="/services/custom-software" class="text-cyan-400 hover:text-cyan-300 underline underline-offset-4">custom business systems</a> and <a href="/services/ui-ux-design" class="text-cyan-400 hover:text-cyan-300 underline underline-offset-4">UI/UX design</a> where those capabilities serve the project.
					</p>
				</div>
			</section>

			<!-- Section 2 -->
			<section class="mb-16">
				<h2 class="font-heading text-2xl md:text-3xl font-bold text-white mb-6">
					How we approach a project
				</h2>
				<div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
					{principles.map((item) => (
						<div class="p-6 rounded-2xl bg-[#0a0f1d] border border-white/10">
							<h3 class="font-heading text-lg font-bold text-white mb-2">
								{item.title}
							</h3>
							<p class="text-slate-300 text-sm leading-relaxed">
								{item.description}
							</p>
						</div>
					))}
				</div>
			</section>

			<!-- Section 3 -->
			<section class="mb-16 bg-slate-900/50 border border-white/10 rounded-3xl p-8 md:p-10">
				<h2 class="font-heading text-2xl md:text-3xl font-bold text-white mb-4">
					Based in Pakistan. Open to working worldwide.
				</h2>
				<p class="text-slate-300 text-base leading-relaxed prose-measure">
					Remote collaboration works best when expectations are explicit. We agree who makes decisions, how feedback is shared and when teams overlap, so location does not become a source of confusion.
				</p>
			</section>

			<!-- Closing CTA -->
			<section class="rounded-3xl border border-cyan-400/20 bg-[#0a0f1d] p-8 md:p-10 text-center">
				<h2 class="font-heading text-2xl md:text-3xl font-bold text-white mb-4">
					Get to know the team behind your project
				</h2>
				<p class="text-slate-300 text-base leading-relaxed max-w-2xl mx-auto mb-8">
					Tell us what you need to build. We can discuss the relevant skills, proposed team and way of working before you commit to a development scope.
				</p>
				<a
					href="/contact"
					data-astro-prefetch="hover"
					class="cta-primary inline-flex items-center justify-center px-8 py-3.5 rounded-full bg-cyan-400 hover:bg-cyan-300 text-slate-950 font-semibold text-sm"
				>
					Talk to Zetalogix
				</a>
			</section>
		</div>
	</div>

	<Footer />
</BaseLayout>