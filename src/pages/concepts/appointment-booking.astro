---
// src/pages/concepts/appointment-booking.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/global/Navbar.astro';
import Footer from '../../components/global/Footer.astro';

const journeyStages = [
	{
		id: 'stage-1',
		step: 'Stage 01',
		title: 'Select a service with clear context',
		summary: 'Present duration, preparation notes, and pricing upfront before asking for a date.',
		uiElements: [
			'Service category filter pills with clear duration labels',
			'Expandable preparation & policy drawer without leaving the screen',
			'Immediate visual indication of next available day',
		],
		engineeringNote:
			'In a production build, service catalog payloads can be cached locally with background revalidation so browsing feels instantaneous even on 3G connections.',
	},
	{
		id: 'stage-2',
		step: 'Stage 02',
		title: 'Choose an available time slot',
		summary: 'Group available slots by morning, afternoon, and evening with explicit time-zone clarity.',
		uiElements: [
			'Horizontal date strip with disabled unavailable dates',
			'Grouped time-slot chips showing explicit local time zone',
			'Temporary slot reservation hold indicator while user completes review',
		],
		engineeringNote:
			'Requires server-side optimistic locking or short-lived hold tokens so two customers do not book the same specialist at the exact same second.',
	},
	{
		id: 'stage-3',
		step: 'Stage 03',
		title: 'Review details before confirmation',
		summary: 'Combine service summary, chosen time, cancellation rules, and contact details on one screen.',
		uiElements: [
			'Single-card booking summary with one-tap edit links back to service or time',
			'Clear cancellation & rescheduling policy disclosure prior to submit',
			'Idempotent confirmation button preventing duplicate submissions on slow networks',
		],
		engineeringNote:
			'Uses an idempotency key per booking attempt so retrying after a dropped mobile connection never creates duplicate appointments.',
	},
];

const edgeCases = [
	{
		scenario: 'Simultaneous Slot Selection',
		handling:
			'If a slot is taken while the user is reviewing, the UI highlights the conflict gracefully and suggests the nearest available times without clearing their form inputs.',
	},
	{
		scenario: 'Time-Zone Mismatch',
		handling:
			'Displays the appointment time in the venue’s local time and clearly notes when the user’s device time zone differs.',
	},
	{
		scenario: 'Interrupted Mobile Connection',
		handling:
			'Preserves selected service and date in local state; disables double-tap submission while awaiting server confirmation.',
	},
	{
		scenario: 'Rescheduling & Cancellations',
		handling:
			'Separates confirmed state from pending changes and enforces cut-off windows defined by business rules.',
	},
];

const validationChecklist = [
	{
		title: 'User research & service hierarchy',
		detail: 'Verify how customers categorize services and what information they need before picking a date.',
	},
	{
		title: 'Working availability & slot-locking system',
		detail: 'Connect to the authoritative calendar database and define hold-expiration timeouts.',
	},
	{
		title: 'Conflict handling & race conditions',
		detail: 'Ensure concurrent requests are resolved atomically on the server.',
	},
	{
		title: 'Time-zone & daylight-saving rules',
		detail: 'Store timestamps in UTC with explicit IANA time-zone identifiers for each location.',
	},
	{
		title: 'Cancellation terms & notifications',
		detail: 'Define email/SMS confirmation triggers, calendar invites (.ics), and reminder schedules.',
	},
	{
		title: 'Accessible interactions & device testing',
		detail: 'Test calendar navigation with screen readers, 200% text zoom, and small mobile viewports.',
	},
];
---

<BaseLayout
	title="Appointment Booking App Concept | Zetalogix"
	description="An original mobile interface concept for selecting a service, finding a time and reviewing an appointment. A design exploration by Zetalogix."
	image="/assets/zetalogix-v1/mobile-development-1200.webp"
	breadcrumbs={[
		{ name: 'Home', url: '/' },
		{ name: 'Our Work', url: '/portfolio' },
		{ name: 'Appointment Booking Concept', url: '/concepts/appointment-booking' },
	]}
>
	<Navbar />

	<!-- Concept Hero -->
	<section class="relative pt-32 pb-20 lg:pt-40 lg:pb-24 bg-brand-dark bg-grid-pattern border-b border-white/10 overflow-hidden">
		<div
			class="absolute -top-20 left-1/4 w-[550px] h-[550px] bg-cyan-500/12 rounded-full blur-[130px] -z-10 pointer-events-none"
			aria-hidden="true"
		></div>

		<div class="max-w-7xl mx-auto px-6 relative z-10">
			<div class="mb-6">
				<a
					href="/portfolio"
					class="inline-flex items-center text-xs font-mono uppercase tracking-wider text-slate-400 hover:text-cyan-400 transition-colors"
				>
					&larr; Back to Our Work &amp; Concepts
				</a>
			</div>

			<!-- Explicit Concept Disclosure Banner -->
			<div class="inline-flex flex-wrap items-center gap-3 p-3 pr-5 rounded-2xl bg-amber-500/10 border border-amber-400/30 mb-8">
				<span class="px-2.5 py-1 rounded-md bg-amber-400 text-slate-950 font-mono text-xs font-bold uppercase">
					Design concept — not client work
				</span>
				<span class="text-xs sm:text-sm text-amber-200">
					This is an illustrative interface study, not a commissioned client project or a functioning booking service.
				</span>
			</div>

			<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center mb-16">
				<div class="lg:col-span-6">
					<span class="font-mono text-xs font-bold uppercase tracking-widest text-cyan-400 block mb-3">
						Concept Study 01 // Mobile Experience
					</span>
					<h1 class="font-heading text-4xl sm:text-5xl lg:text-6xl font-bold text-white tracking-tight mb-6 leading-[1.08]">
						A clearer path from availability to appointment.
					</h1>
					<p class="text-slate-300 text-base sm:text-lg leading-relaxed mb-8 prose-measure">
						An original mobile interface exploration examining how service context, calendar selection, and booking confirmation can work together without unnecessary navigation depth.
					</p>
					<div class="flex flex-wrap items-center gap-4">
						<a
							href="/contact"
							data-astro-prefetch="hover"
							class="cta-primary inline-flex items-center justify-center px-8 py-4 rounded-full bg-cyan-400 hover:bg-cyan-300 text-slate-950 font-bold text-sm"
						>
							Discuss a Booking Product
						</a>
						<a
							href="/services/mobile-development"
							class="inline-flex items-center justify-center px-7 py-4 rounded-full bg-white/[0.04] border border-white/15 hover:border-white/30 text-white font-semibold text-sm transition-colors"
						>
							Explore Mobile Development
						</a>
					</div>
				</div>

				<!-- Framed Hero Concept Artwork -->
				<figure class="lg:col-span-6">
					<div class="device-frame-hover rounded-3xl overflow-hidden border border-white/15 bg-[#0a0f1d] shadow-[0_25px_70px_rgba(0,0,0,0.75)]">
						<div class="h-8 bg-[#0f172a] border-b border-white/10 flex items-center justify-between px-4">
							<div class="flex items-center gap-1.5">
								<span class="w-2.5 h-2.5 rounded-full bg-rose-500/80"></span>
								<span class="w-2.5 h-2.5 rounded-full bg-amber-500/80"></span>
								<span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80"></span>
							</div>
							<span class="text-[11px] font-mono text-slate-400">mobile-development // concept-study</span>
						</div>
						<img
							src="/assets/zetalogix-v1/mobile-development-800.webp"
							srcset="/assets/zetalogix-v1/mobile-development-480.webp 480w, /assets/zetalogix-v1/mobile-development-800.webp 800w, /assets/zetalogix-v1/mobile-development-1200.webp 1200w"
							sizes="(min-width: 1024px) 50vw, 100vw"
							width="1200"
							height="800"
							fetchpriority="high"
							decoding="async"
							alt="Original mobile booking interface concept on two phones."
							class="w-full aspect-[3/2] object-cover"
						/>
						<figcaption class="px-6 py-4 bg-[#070b16] border-t border-white/10 text-xs text-slate-400 leading-relaxed">
							Original AI-assisted mobile interface illustration. Labels and interactions would be designed as live UI during product development.
						</figcaption>
					</div>
				</figure>
			</div>

			<!-- Specification Metadata Strip -->
			<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 p-6 rounded-3xl bg-[#0a0f1d]/90 border border-white/10">
				<div>
					<span class="block text-xs font-mono uppercase tracking-wider text-slate-400 mb-1">Study Focus</span>
					<span class="text-sm sm:text-base font-bold text-white">Service &amp; Slot Selection</span>
				</div>
				<div>
					<span class="block text-xs font-mono uppercase tracking-wider text-slate-400 mb-1">Target Platforms</span>
					<span class="text-sm sm:text-base font-bold text-white">iOS &amp; Android</span>
				</div>
				<div>
					<span class="block text-xs font-mono uppercase tracking-wider text-slate-400 mb-1">Candidate Stack</span>
					<span class="text-sm sm:text-base font-bold text-cyan-400">Flutter / React Native + REST</span>
				</div>
				<div>
					<span class="block text-xs font-mono uppercase tracking-wider text-slate-400 mb-1">Provenance Status</span>
					<span class="text-sm sm:text-base font-bold text-amber-300">Illustrative Design Study</span>
				</div>
			</div>
		</div>
	</section>

	<!-- Section 1: The Product Question & Proposed Direction Comparison -->
	<section class="py-24 bg-brand-dark border-b border-white/10">
		<div class="max-w-7xl mx-auto px-6">
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-stretch">
				<article class="reveal lg:col-span-5 p-8 sm:p-10 rounded-3xl bg-[#0a0f1d] border border-white/10 flex flex-col justify-between">
					<div>
						<span class="inline-block font-mono text-xs font-bold text-cyan-400 uppercase tracking-widest mb-3">
							01 // Core Challenge
						</span>
						<h2 class="font-heading text-2xl sm:text-3xl font-bold text-white mb-4">
							The product question
						</h2>
						<p class="text-slate-200 text-lg leading-relaxed mb-6">
							How could a mobile booking journey help someone understand the available choices without moving through unnecessary screens?
						</p>
						<p class="text-slate-400 text-sm leading-relaxed">
							Many mobile scheduling flows force users to pick a date before knowing if a service is offered, or hide duration and cancellation rules until the final checkout screen—causing drop-offs and back-button loops.
						</p>
					</div>
					<div class="pt-6 mt-6 border-t border-white/10 text-xs font-mono text-rose-300">
						Common failure mode: Deep nested calendars with hidden service constraints.
					</div>
				</article>

				<article class="reveal reveal-delay-1 lg:col-span-7 p-8 sm:p-10 rounded-3xl bg-gradient-to-br from-[#0a0f1d] via-[#0d162c] to-[#0a0f1d] border border-cyan-400/30 flex flex-col justify-between">
					<div>
						<span class="inline-block font-mono text-xs font-bold text-violet-400 uppercase tracking-widest mb-3">
							02 // Design Hypothesis
						</span>
						<h2 class="font-heading text-2xl sm:text-3xl font-bold text-white mb-4">
							The proposed direction
						</h2>
						<p class="text-slate-200 text-lg leading-relaxed mb-6">
							The visual study brings service context, a calendar and booking details into a consistent interface. The intended journey is select a service, choose a time and review the details before confirmation.
						</p>
						<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-4">
							<div class="p-4 rounded-2xl bg-[#050814]/80 border border-white/10">
								<span class="block text-xs font-mono font-bold text-cyan-400 mb-1">Step 1</span>
								<span class="text-sm font-semibold text-white block mb-1">Select Service</span>
								<span class="text-xs text-slate-400">Duration &amp; notes visible upfront</span>
							</div>
							<div class="p-4 rounded-2xl bg-[#050814]/80 border border-white/10">
								<span class="block text-xs font-mono font-bold text-cyan-400 mb-1">Step 2</span>
								<span class="text-sm font-semibold text-white block mb-1">Choose Time</span>
								<span class="text-xs text-slate-400">Filtered to valid specialist slots</span>
							</div>
							<div class="p-4 rounded-2xl bg-[#050814]/80 border border-white/10">
								<span class="block text-xs font-mono font-bold text-cyan-400 mb-1">Step 3</span>
								<span class="text-sm font-semibold text-white block mb-1">Review &amp; Confirm</span>
								<span class="text-xs text-slate-400">Explicit policy &amp; single-tap edit</span>
							</div>
						</div>
					</div>
				</article>
			</div>
		</div>
	</section>

	<!-- Section 2: Interactive 3-Stage Journey Walkthrough + Secondary Visual -->
	<section class="py-24 lg:py-28 bg-[#070b16] border-b border-white/10">
		<div class="max-w-7xl mx-auto px-6">
			<div class="reveal max-w-2xl mb-14">
				<span class="font-mono text-xs font-bold tracking-widest text-cyan-400 uppercase mb-3 flex items-center gap-2">
					<span class="w-8 h-px bg-cyan-400"></span> Screen-by-Screen Architecture
				</span>
				<h2 class="font-heading text-3xl sm:text-4xl font-bold text-white tracking-tight mb-4">
					Structuring the three-step mobile journey
				</h2>
				<p class="text-slate-300 text-base leading-relaxed prose-measure">
					Select each stage below to inspect how the interface hierarchy and supporting backend logic work together.
				</p>
			</div>

			<div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
				<!-- Interactive Stage Tabs -->
				<div class="lg:col-span-7 space-y-6">
					<div class="flex flex-wrap gap-2" role="tablist" aria-label="Booking journey stages">
						{journeyStages.map((stage, idx) => (
							<button
								type="button"
								role="tab"
								aria-selected={idx === 0 ? 'true' : 'false'}
								data-stage-tab={stage.id}
								class={`stage-tab-btn px-5 py-2.5 rounded-full text-xs sm:text-sm font-semibold border transition-colors ${
									idx === 0
										? 'bg-cyan-400 text-slate-950 border-cyan-400'
										: 'bg-[#0a0f1d] text-slate-300 border-white/10 hover:border-white/25'
								}`}
							>
								{stage.step}: {stage.title.split(' ')[0]} {stage.title.split(' ')[1]}
							</button>
						))}
					</div>

					{journeyStages.map((stage, idx) => (
						<div
							data-stage-panel={stage.id}
							class={`p-8 rounded-3xl bg-[#0a0f1d] border border-white/10 ${idx === 0 ? '' : 'hidden'}`}
						>
							<span class="text-xs font-mono font-bold text-cyan-400 uppercase tracking-wider block mb-2">
								{stage.step}
							</span>
							<h3 class="font-heading text-2xl font-bold text-white mb-3">
								{stage.title}
							</h3>
							<p class="text-slate-300 text-base leading-relaxed mb-6">
								{stage.summary}
							</p>

							<h4 class="text-xs font-mono uppercase tracking-wider text-slate-400 mb-3">
								Key Interface Components
							</h4>
							<ul class="space-y-2.5 mb-6">
								{stage.uiElements.map((el) => (
									<li class="flex items-start gap-3 text-sm text-slate-200">
										<span class="w-2 h-2 rounded-full bg-cyan-400 mt-1.5 shrink-0"></span>
										<span>{el}</span>
									</li>
								))}
							</ul>

							<div class="p-4 rounded-2xl bg-[#050814] border border-cyan-400/20">
								<span class="block text-[11px] font-mono uppercase tracking-wider text-cyan-400 mb-1">
									Engineering Implementation Note
								</span>
								<p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
									{stage.engineeringNote}
								</p>
							</div>
						</div>
					))}
				</div>

				<!-- Secondary Visual Slot (concept-booking-flow.webp with automatic fallback) -->
				<figure class="lg:col-span-5">
					<div class="rounded-3xl overflow-hidden border border-white/15 bg-[#0a0f1d] shadow-2xl">
						<div class="h-7 bg-[#0f172a] border-b border-white/10 flex items-center justify-between px-4">
							<span class="text-[11px] font-mono text-slate-400">sequence-view // 3-step-flow</span>
							<span class="text-[11px] font-mono text-cyan-400">Illustrative Sequence</span>
						</div>
						<img
							src="/assets/zetalogix-v1/concept-booking-flow.webp"
							onerror="this.onerror=null;this.src='/assets/zetalogix-v1/mobile-development-800.webp';"
							width="800"
							height="533"
							loading="lazy"
							decoding="async"
							alt="Three-step mobile booking flow illustration."
							class="w-full aspect-[3/2] object-cover"
						/>
						<figcaption class="px-5 py-3.5 bg-[#050814] border-t border-white/10 text-xs text-slate-400 leading-relaxed">
							Conceptual sequence showing progression from service card to calendar slot and final confirmation summary.
						</figcaption>
					</div>
				</figure>
			</div>
		</div>
	</section>

	<!-- Section 3: What a Real Product Would Need Next & Edge Cases -->
	<section class="py-24 bg-brand-dark border-b border-white/10">
		<div class="max-w-7xl mx-auto px-6">
			<div class="reveal max-w-3xl mb-14">
				<span class="font-mono text-xs font-bold tracking-widest text-emerald-400 uppercase mb-3 flex items-center gap-2">
					<span class="w-8 h-px bg-emerald-400"></span> Production Readiness Scope
				</span>
				<h2 class="font-heading text-3xl sm:text-4xl font-bold text-white tracking-tight mb-4">
					What a real product would need next
				</h2>
				<p class="text-slate-200 text-base sm:text-lg leading-relaxed">
					User research, a working availability system, conflict handling, time-zone rules, cancellation terms, accessible interactions and testing on target devices. The concept does not establish these capabilities or claim usability results.
				</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
				{validationChecklist.map((item, idx) => (
					<div class={`reveal reveal-delay-${(idx % 3) + 1} p-6 rounded-2xl bg-[#0a0f1d] border border-white/10`}>
						<span class="block text-xs font-mono font-bold text-cyan-400 mb-2">
							0{idx + 1} // Validation Requirement
						</span>
						<h3 class="font-heading text-lg font-bold text-white mb-2">
							{item.title}
						</h3>
						<p class="text-slate-300 text-sm leading-relaxed">
							{item.detail}
						</p>
					</div>
				))}
			</div>

			<!-- Imperfect Connections & Edge-Case Matrix -->
			<div class="reveal rounded-3xl bg-gradient-to-br from-[#0a0f1d] via-[#0d1528] to-[#0a0f1d] border border-white/15 p-8 sm:p-12">
				<div class="max-w-2xl mb-8">
					<span class="font-mono text-xs font-bold text-violet-400 uppercase tracking-widest block mb-2">
						Resilience &amp; State Handling
					</span>
					<h3 class="font-heading text-2xl sm:text-3xl font-bold text-white">
						Designing for imperfect mobile conditions
					</h3>
				</div>
				<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
					{edgeCases.map((edge) => (
						<div class="p-6 rounded-2xl bg-[#050814]/80 border border-white/10">
							<h4 class="font-heading text-base font-bold text-cyan-400 mb-2">
								{edge.scenario}
							</h4>
							<p class="text-slate-300 text-sm leading-relaxed">
								{edge.handling}
							</p>
						</div>
					))}
				</div>
			</div>
		</div>
	</section>

	<!-- Section 4: Related Service, Guide & Concept Cross-Navigation -->
	<section class="py-20 bg-[#070b16]">
		<div class="max-w-7xl mx-auto px-6">
			<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
				<a
					href="/services/mobile-development"
					class="interactive-card p-7 rounded-3xl bg-[#0a0f1d] border border-white/10 hover:border-cyan-400/40 flex flex-col justify-between"
				>
					<div>
						<span class="text-xs font-mono uppercase tracking-wider text-cyan-400 block mb-2">
							Related Service
						</span>
						<h3 class="font-heading text-xl font-bold text-white mb-2">
							Mobile App Development
						</h3>
						<p class="text-slate-400 text-sm leading-relaxed">
							Explore how we scope, prototype, test, and prepare iOS and Android applications for release.
						</p>
					</div>
					<span class="text-xs font-bold text-cyan-400 mt-6 inline-block">View Service &rarr;</span>
				</a>

				<a
					href="/blog/flutter-for-ios-development-everything-you-need"
					class="interactive-card p-7 rounded-3xl bg-[#0a0f1d] border border-white/10 hover:border-cyan-400/40 flex flex-col justify-between"
				>
					<div>
						<span class="text-xs font-mono uppercase tracking-wider text-violet-400 block mb-2">
							Related Engineering Guide
						</span>
						<h3 class="font-heading text-xl font-bold text-white mb-2">
							Is Flutter Right for Your iOS App?
						</h3>
						<p class="text-slate-400 text-sm leading-relaxed">
							Evaluate shared-code development against platform features, testing matrices, and maintenance costs.
						</p>
					</div>
					<span class="text-xs font-bold text-cyan-400 mt-6 inline-block">Read Article &rarr;</span>
				</a>

				<a
					href="/concepts/team-workspace"
					class="interactive-card p-7 rounded-3xl bg-[#0a0f1d] border border-white/10 hover:border-cyan-400/40 flex flex-col justify-between"
				>
					<div>
						<span class="text-xs font-mono uppercase tracking-wider text-emerald-400 block mb-2">
							Next Product Concept
						</span>
						<h3 class="font-heading text-xl font-bold text-white mb-2">
							Team Workspace Concept
						</h3>
						<p class="text-slate-400 text-sm leading-relaxed">
							Explore our SaaS dashboard study separating everyday project execution from account role administration.
						</p>
					</div>
					<span class="text-xs font-bold text-cyan-400 mt-6 inline-block">Explore Concept &rarr;</span>
				</a>
			</div>

			<div class="rounded-3xl border border-cyan-400/30 bg-gradient-to-br from-[#0d172a] via-[#0a0f1d] to-[#111029] p-8 sm:p-12 flex flex-col md:flex-row items-center justify-between gap-8">
				<div>
					<h2 class="font-heading text-2xl sm:text-3xl font-bold text-white mb-2">
						Planning a mobile booking or scheduling product?
					</h2>
					<p class="text-slate-300 text-sm sm:text-base">
						Tell us the main task your app should help someone complete. We can work backward from that outcome.
					</p>
				</div>
				<a
					href="/contact"
					data-astro-prefetch="hover"
					class="cta-primary shrink-0 inline-flex items-center px-8 py-4 rounded-full bg-cyan-400 hover:bg-cyan-300 text-slate-950 font-bold text-sm"
				>
					Discuss a Booking Product
				</a>
			</div>
		</div>
	</section>

	<Footer />
</BaseLayout>

<script>
	const setupStageTabs = () => {
		const tabs = document.querySelectorAll<HTMLButtonElement>('[data-stage-tab]');
		const panels = document.querySelectorAll<HTMLElement>('[data-stage-panel]');

		tabs.forEach((tab) => {
			tab.addEventListener('click', () => {
				const target = tab.getAttribute('data-stage-tab');
				tabs.forEach((t) => {
					const active = t === tab;
					t.setAttribute('aria-selected', active ? 'true' : 'false');
					t.classList.toggle('bg-cyan-400', active);
					t.classList.toggle('text-slate-950', active);
					t.classList.toggle('border-cyan-400', active);
					t.classList.toggle('bg-[#0a0f1d]', !active);
					t.classList.toggle('text-slate-300', !active);
					t.classList.toggle('border-white/10', !active);
				});
				panels.forEach((panel) => {
					panel.classList.toggle('hidden', panel.getAttribute('data-stage-panel') !== target);
				});
			});
		});
	};

	setupStageTabs();
</script>