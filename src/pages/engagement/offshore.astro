---
// src/pages/engagement/offshore.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/global/Navbar.astro';
import ContactForm from '../../components/sections/ContactForm.astro';
import Footer from '../../components/global/Footer.astro';
---

<BaseLayout title="Offshore Development Center | ZetaLogix Engagement Models">
    <Navbar />
    
    <main class="pt-20 bg-brand-dark text-slate-300">
        
        <section class="max-w-7xl mx-auto px-6 py-24 grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
            <div class="space-y-8 relative z-10">
                <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white leading-tight font-heading">
                    Unlock Global Potential with ZetaLogix's <span class="text-brand-accent">Offshore Development Center</span>
                </h1>
                <p class="text-slate-400 text-lg leading-relaxed max-w-lg">
                    At ZetaLogix, we provide a dedicated Offshore Development Center (ODC) designed to function as an extension of your in-house IT team. Our ODC model ensures cost-effective solutions, enhanced productivity, and access to top-tier global talent.
                </p>
                <div class="flex flex-wrap gap-4">
                    <a href="/contact" class="px-8 py-4 bg-brand-accent text-brand-dark font-bold rounded-lg hover:bg-white transition-colors shadow-[0_0_20px_rgba(34,211,238,0.2)]">
                        Get a Free Quote
                    </a>
                    <a href="tel:+123456789" class="px-8 py-4 bg-[#FF5A1F] text-white font-bold rounded-lg hover:bg-[#e04e18] transition-colors flex items-center gap-2">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
                        Call us!
                    </a>
                </div>
            </div>
            <div class="relative">
                <div class="absolute inset-0 bg-brand-accent/10 blur-[80px] rounded-full pointer-events-none"></div>
                <img 
                    src="https://images.unsplash.com/photo-1600880292203-757bb62b4baf?q=80&w=1200&auto=format&fit=crop" 
                    alt="Offshore development team collaborating" 
                    class="w-full h-auto rounded-3xl shadow-2xl border border-white/5 relative z-10"
                />
            </div>
        </section>

        <section class="py-24 bg-[#0a0f1d] border-t border-white/5">
            <div class="max-w-7xl mx-auto px-6">
                <h2 class="text-3xl md:text-4xl font-bold text-center text-white mb-16 font-heading">Why Opt for Offshore Development Center?</h2>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-10">
                    <div class="flex gap-4">
                        <svg class="w-6 h-6 text-[#FFC107] shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                        <div>
                            <h3 class="text-xl font-bold text-white mb-2">Cost Savings</h3>
                            <p class="text-slate-400 leading-relaxed text-sm">Benefit from reduced operational and labor costs while maintaining high-quality output.</p>
                        </div>
                    </div>
                    <div class="flex gap-4">
                        <svg class="w-6 h-6 text-[#FFC107] shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                        <div>
                            <h3 class="text-xl font-bold text-white mb-2">Flexibility and Scalability</h3>
                            <p class="text-slate-400 leading-relaxed text-sm">Adjust the size and composition of your team easily to match evolving project requirements.</p>
                        </div>
                    </div>
                    <div class="flex gap-4">
                        <svg class="w-6 h-6 text-[#FFC107] shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                        <div>
                            <h3 class="text-xl font-bold text-white mb-2">Focus on Core Business</h3>
                            <p class="text-slate-400 leading-relaxed text-sm">Free up your internal resources to focus on core business activities.</p>
                        </div>
                    </div>
                    <div class="flex gap-4">
                        <svg class="w-6 h-6 text-[#FFC107] shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                        <div>
                            <h3 class="text-xl font-bold text-white mb-2">Risk Mitigation</h3>
                            <p class="text-slate-400 leading-relaxed text-sm">Share risks associated with project development and management.</p>
                        </div>
                    </div>
                    <div class="flex gap-4">
                        <svg class="w-6 h-6 text-[#FFC107] shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                        <div>
                            <h3 class="text-xl font-bold text-white mb-2">Access to Expertise</h3>
                            <p class="text-slate-400 leading-relaxed text-sm">Leverage a team of professionals with specialized skills tailored to your project's needs.</p>
                        </div>
                    </div>
                    <div class="flex gap-4">
                        <svg class="w-6 h-6 text-[#FFC107] shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                        <div>
                            <h3 class="text-xl font-bold text-white mb-2">Faster Time-to-Market</h3>
                            <p class="text-slate-400 leading-relaxed text-sm">Speed up project delivery with a team dedicated exclusively to your development needs.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="py-24 bg-[#03050d]">
            <div class="max-w-7xl mx-auto px-6">
                <h2 class="text-3xl md:text-5xl font-bold text-white mb-16 font-heading text-center md:text-left">
                    Key Advantages Of Our ODC Model
                </h2>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-10">
                    <div>
                        <span class="text-6xl font-light bg-gradient-to-r from-purple-500 to-indigo-500 bg-clip-text text-transparent block mb-1">01</span>
                        <h3 class="text-xl font-bold text-white mb-2">Cost Efficiency</h3>
                        <p class="text-slate-400 text-sm">Reduce operational costs significantly by leveraging the lower cost of offshore development without compromising on quality.</p>
                    </div>
                    <div>
                        <span class="text-6xl font-light bg-gradient-to-r from-purple-500 to-indigo-500 bg-clip-text text-transparent block mb-1">02</span>
                        <h3 class="text-xl font-bold text-white mb-2">Specialized Skills</h3>
                        <p class="text-slate-400 text-sm">Access specialized skills and domain expertise that may be scarce or expensive locally, enhancing the quality of your projects.</p>
                    </div>
                    <div>
                        <span class="text-6xl font-light bg-gradient-to-r from-purple-500 to-indigo-500 bg-clip-text text-transparent block mb-1">03</span>
                        <h3 class="text-xl font-bold text-white mb-2">Scalability</h3>
                        <p class="text-slate-400 text-sm">Easily scale your team up or down based on project needs, ensuring flexibility and agility in resource management.</p>
                    </div>
                    <div>
                        <span class="text-6xl font-light bg-gradient-to-r from-purple-500 to-indigo-500 bg-clip-text text-transparent block mb-1">04</span>
                        <h3 class="text-xl font-bold text-white mb-2">Customizable Solutions</h3>
                        <p class="text-slate-400 text-sm">Tailor the ODC model to fit your specific business requirements, ensuring that you get the exact expertise and support you need.</p>
                    </div>
                    <div>
                        <span class="text-6xl font-light bg-gradient-to-r from-purple-500 to-indigo-500 bg-clip-text text-transparent block mb-1">05</span>
                        <h3 class="text-xl font-bold text-white mb-2">Long-Term Partnership</h3>
                        <p class="text-slate-400 text-sm">Build a long-term partnership with ZetaLogix, fostering a deeper understanding of your business needs and consistent support over time.</p>
                    </div>
                    <div>
                        <span class="text-6xl font-light bg-gradient-to-r from-purple-500 to-indigo-500 bg-clip-text text-transparent block mb-1">06</span>
                        <h3 class="text-xl font-bold text-white mb-2">Round-the-Clock Productivity</h3>
                        <p class="text-slate-400 text-sm">Benefit from different time zones, enabling continuous development and faster project completion.</p>
                    </div>
                </div>
            </div>
        </section>

        <section class="py-24 bg-brand-dark relative">
            <div class="max-w-4xl mx-auto px-6 relative z-10">
                
                <div class="text-center mb-10">
                    <span class="text-[10px] font-bold text-pink-500 tracking-[0.2em] uppercase block mb-3">HOW IT WORKS</span>
                    <h2 class="text-3xl md:text-4xl font-bold text-white font-heading">Our Comprehensive ODC Process</h2>
                </div>

                <div class="max-w-2xl mx-auto bg-[#0a0f1d] border border-white/5 rounded-3xl p-8 md:p-12 shadow-2xl relative">
                    
                    <div class="space-y-8">
                        
                        <div class="flex items-center gap-6">
                            <div class="w-16 h-16 rounded-full border-2 border-purple-500/30 flex items-center justify-center shrink-0">
                                <div class="w-12 h-12 rounded-full bg-gradient-to-br from-purple-600 to-pink-500 flex flex-col items-center justify-center text-white shadow-md">
                                    <span class="text-[8px] font-bold tracking-wider uppercase mb-0.5">Step</span>
                                    <span class="text-lg font-bold leading-none">01</span>
                                </div>
                            </div>
                            <div>
                                <h3 class="text-lg font-bold text-white mb-1">Needs Assessment</h3>
                                <p class="text-slate-400 text-sm leading-snug">We start by comprehensively understanding your specific project requirements, goals, and objectives.</p>
                            </div>
                        </div>

                        <div class="flex items-center gap-6">
                            <div class="w-16 h-16 rounded-full border-2 border-purple-500/30 flex items-center justify-center shrink-0">
                                <div class="w-12 h-12 rounded-full bg-gradient-to-br from-purple-600 to-pink-500 flex flex-col items-center justify-center text-white shadow-md">
                                    <span class="text-[8px] font-bold tracking-wider uppercase mb-0.5">Step</span>
                                    <span class="text-lg font-bold leading-none">02</span>
                                </div>
                            </div>
                            <div>
                                <h3 class="text-lg font-bold text-white mb-1">Infrastructure Setup</h3>
                                <p class="text-slate-400 text-sm leading-snug">Our team sets up the necessary infrastructure, including secure communication channels, development environments, and collaboration tools, to ensure seamless operations.</p>
                            </div>
                        </div>

                        <div class="flex items-center gap-6">
                            <div class="w-16 h-16 rounded-full border-2 border-purple-500/30 flex items-center justify-center shrink-0">
                                <div class="w-12 h-12 rounded-full bg-gradient-to-br from-purple-600 to-pink-500 flex flex-col items-center justify-center text-white shadow-md">
                                    <span class="text-[8px] font-bold tracking-wider uppercase mb-0.5">Step</span>
                                    <span class="text-lg font-bold leading-none">03</span>
                                </div>
                            </div>
                            <div>
                                <h3 class="text-lg font-bold text-white mb-1">Talent Acquisition</h3>
                                <p class="text-slate-400 text-sm leading-snug">We recruit and onboard top-tier talent tailored to your project needs, ensuring they possess the right skills and experience.</p>
                            </div>
                        </div>

                        <div class="flex items-center gap-6">
                            <div class="w-16 h-16 rounded-full border-2 border-purple-500/30 flex items-center justify-center shrink-0">
                                <div class="w-12 h-12 rounded-full bg-gradient-to-br from-purple-600 to-pink-500 flex flex-col items-center justify-center text-white shadow-md">
                                    <span class="text-[8px] font-bold tracking-wider uppercase mb-0.5">Step</span>
                                    <span class="text-lg font-bold leading-none">04</span>
                                </div>
                            </div>
                            <div>
                                <h3 class="text-lg font-bold text-white mb-1">Team Integration</h3>
                                <p class="text-slate-400 text-sm leading-snug">The remote team is seamlessly integrated with your in-house team to facilitate smooth collaboration and communication.</p>
                            </div>
                        </div>

                        <div class="flex items-center gap-6">
                            <div class="w-16 h-16 rounded-full border-2 border-purple-500/30 flex items-center justify-center shrink-0">
                                <div class="w-12 h-12 rounded-full bg-gradient-to-br from-purple-600 to-pink-500 flex flex-col items-center justify-center text-white shadow-md">
                                    <span class="text-[8px] font-bold tracking-wider uppercase mb-0.5">Step</span>
                                    <span class="text-lg font-bold leading-none">05</span>
                                </div>
                            </div>
                            <div>
                                <h3 class="text-lg font-bold text-white mb-1">Project Execution</h3>
                                <p class="text-slate-400 text-sm leading-snug">We manage and execute the project with a focus on efficiency, quality, and timely delivery, following best practices and methodologies.</p>
                            </div>
                        </div>

                        <div class="flex items-center gap-6">
                            <div class="w-16 h-16 rounded-full border-2 border-purple-500/30 flex items-center justify-center shrink-0">
                                <div class="w-12 h-12 rounded-full bg-gradient-to-br from-purple-600 to-pink-500 flex flex-col items-center justify-center text-white shadow-md">
                                    <span class="text-[8px] font-bold tracking-wider uppercase mb-0.5">Step</span>
                                    <span class="text-lg font-bold leading-none">06</span>
                                </div>
                            </div>
                            <div>
                                <h3 class="text-lg font-bold text-white mb-1">Quality Assurance and Testing</h3>
                                <p class="text-slate-400 text-sm leading-snug">Rigorous quality assurance processes and continuous testing ensure that deliverables meet the highest standards.</p>
                            </div>
                        </div>

                        <div class="flex items-center gap-6">
                            <div class="w-16 h-16 rounded-full border-2 border-purple-500/30 flex items-center justify-center shrink-0">
                                <div class="w-12 h-12 rounded-full bg-gradient-to-br from-purple-600 to-pink-500 flex flex-col items-center justify-center text-white shadow-md">
                                    <span class="text-[8px] font-bold tracking-wider uppercase mb-0.5">Step</span>
                                    <span class="text-lg font-bold leading-none">07</span>
                                </div>
                            </div>
                            <div>
                                <h3 class="text-lg font-bold text-white mb-1">Delivery and Deployment</h3>
                                <p class="text-slate-400 text-sm leading-snug">We handle the final delivery and deployment of the project, ensuring everything is in place for a successful launch.</p>
                            </div>
                        </div>

                        <div class="flex items-center gap-6">
                            <div class="w-16 h-16 rounded-full border-2 border-purple-500/30 flex items-center justify-center shrink-0">
                                <div class="w-12 h-12 rounded-full bg-gradient-to-br from-purple-600 to-pink-500 flex flex-col items-center justify-center text-white shadow-md">
                                    <span class="text-[8px] font-bold tracking-wider uppercase mb-0.5">Step</span>
                                    <span class="text-lg font-bold leading-none">08</span>
                                </div>
                            </div>
                            <div>
                                <h3 class="text-lg font-bold text-white mb-1">Ongoing Support and Continuous Improvement</h3>
                                <p class="text-slate-400 text-sm leading-snug">Regular updates, optimizations, and support ensure your project's long-term success and adaptation to changing needs.</p>
                            </div>
                        </div>

                    </div>
                </div>

            </div>
        </section>

        <section class="py-24 bg-[#050814] px-6 border-t border-white/5">
            <div class="max-w-4xl mx-auto bg-[#0a0f1d] rounded-3xl p-12 md:p-16 border border-white/5 text-center shadow-2xl relative overflow-hidden">
                <div class="absolute inset-0 bg-gradient-to-br from-indigo-500/10 to-purple-500/10 pointer-events-none"></div>
                <h2 class="text-3xl md:text-4xl font-bold text-white mb-6 font-heading relative z-10">Set up an ODC with ZetaLogix Today!</h2>
                <p class="text-slate-300 leading-relaxed mb-8 relative z-10 max-w-2xl mx-auto">
                    We support B2B, B2C, C2C & SMEs in their efforts to develop sustainable and efficient IT infrastructure to match the ever-changing e-Business environment.
                </p>
                <a href="/contact" class="inline-block px-8 py-4 bg-[#6200EA] text-white font-bold rounded-lg hover:bg-[#7E57C2] transition-colors shadow-lg relative z-10">
                    Get a Free Quote
                </a>
            </div>
        </section>

        <section class="py-24 bg-brand-dark border-t border-white/5">
            <div class="max-w-4xl mx-auto px-6">
                <h2 class="text-3xl font-bold text-center text-white mb-12 font-heading">Frequently Asked Questions About Our Offshore Development Center Model</h2>
                
                <div class="space-y-4">
                    <details class="group bg-[#0a0f1d] rounded-xl border border-white/5 [&_summary::-webkit-details-marker]:hidden">
                        <summary class="flex cursor-pointer items-center justify-between p-6 font-bold text-white">
                            What is an Offshore Development Center (ODC)?
                            <span class="transition group-open:rotate-180">
                                <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                            </span>
                        </summary>
                        <div class="px-6 pb-6 text-slate-400 text-sm leading-relaxed border-t border-white/5 pt-4 mt-2">
                            An ODC is a remote team that works as an extension of your in-house IT team, providing specialized skills and resources for various projects.
                        </div>
                    </details>

                    <details class="group bg-[#0a0f1d] rounded-xl border border-white/5 [&_summary::-webkit-details-marker]:hidden">
                        <summary class="flex cursor-pointer items-center justify-between p-6 font-bold text-white">
                            How does an ODC benefit my business?
                            <span class="transition group-open:rotate-180">
                                <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                            </span>
                        </summary>
                        <div class="px-6 pb-6 text-slate-400 text-sm leading-relaxed border-t border-white/5 pt-4 mt-2">
                            It offers significant cost savings, access to a vast pool of global talent, flexibility in scaling your operations, and allows your core team to focus entirely on strategic business goals without administrative overhead.
                        </div>
                    </details>

                    <details class="group bg-[#0a0f1d] rounded-xl border border-white/5 [&_summary::-webkit-details-marker]:hidden">
                        <summary class="flex cursor-pointer items-center justify-between p-6 font-bold text-white">
                            What kind of projects can be handled by an ODC?
                            <span class="transition group-open:rotate-180">
                                <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                            </span>
                        </summary>
                        <div class="px-6 pb-6 text-slate-400 text-sm leading-relaxed border-t border-white/5 pt-4 mt-2">
                            ODCs are highly versatile and ideal for long-term projects, continuous enterprise software development, system maintenance, quality assurance, and any projects requiring specialized technical skills that may not be available locally.
                        </div>
                    </details>

                    <details class="group bg-[#0a0f1d] rounded-xl border border-white/5 [&_summary::-webkit-details-marker]:hidden">
                        <summary class="flex cursor-pointer items-center justify-between p-6 font-bold text-white">
                            How do you ensure quality in your ODC services?
                            <span class="transition group-open:rotate-180">
                                <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                            </span>
                        </summary>
                        <div class="px-6 pb-6 text-slate-400 text-sm leading-relaxed border-t border-white/5 pt-4 mt-2">
                            We implement rigorous QA testing protocols, strictly follow agile development methodologies, and maintain clear, transparent communication with regular progress updates to ensure all deliverables meet premium standards.
                        </div>
                    </details>
                    
                    <details class="group bg-[#0a0f1d] rounded-xl border border-white/5 [&_summary::-webkit-details-marker]:hidden">
                        <summary class="flex cursor-pointer items-center justify-between p-6 font-bold text-white">
