---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/global/Navbar.astro';
import Hero from '../components/sections/Hero.astro';
import Services from '../components/sections/Services.astro';
import Projects from '../components/sections/Projects.astro';
import Process from '../components/sections/Process.astro';
import Footer from '../components/global/Footer.astro';

const engagementModels = [
	{
		title: 'Fixed-scope project',
		href: '/engagement/fixed-price',
		description:
			'A defined outcome, agreed deliverables and milestones. Useful when the requirements are sufficiently clear.',
	},
	{
		title: 'Dedicated team',
		href: '/engagement/dedicated-team',
		description: 'Ongoing engineering capacity for a product roadmap that will evolve.',
	},
	{
		title: 'Offshore delivery',
		href: '/engagement/offshore',
		description:
			'A coordinated remote delivery arrangement with agreed roles, communication and access controls.',
	},
];

const featuredArticles = [
	{
		title: 'Where Astro and React Fit in a Web Product',
		category: 'Web Development',
		href: '/blog/why-we-build-enterprise-web-apps',
		description:
			'Understand when static pages, interactive islands and a dedicated application experience make sense for a business website or web product.',
		stem: 'web-development',
		alt: 'Developer reviewing a responsive website in an illustrative workspace.',
	},
	{
		title: 'Is Flutter Right for Your iOS App?',
		category: 'Mobile Development',
		href: '/blog/flutter-for-ios-development-everything-you-need',
		description:
			'Evaluate Flutter for an iOS product by looking at platform features, user experience, testing, maintenance and the needs of your first release.',
		stem: 'mobile-development',
		alt: 'Original mobile booking interface concept on two phones.',
	},
	{
		title: 'Planning a Useful RAG Pilot for Business Documents',
		category: 'AI & Data',
		href: '/blog/implementing-rag-systems',
		description:
			'Plan a document-search AI pilot with clear permissions, representative questions, source checking and evaluation before a wider rollout.',
		stem: 'ai-solutions',
		alt: 'Conceptual illustration of unstructured information becoming organized.',
	},
];
---

<BaseLayout
	title="Web, Mobile & AI Development Services | Zetalogix"
	description="Build useful digital products with Zetalogix. Explore web development, mobile apps, custom software and AI solutions for your business."
>
	<Navbar />

	<Hero />
	<Services />
	<Projects />
	<Process />

	<!-- Engagement Options -->
	<section id="engagement" class="py-20 lg:py-28 bg-brand-dark border-b border-white/5">
		<div class="max-w-7xl mx-auto px-6">
			<div class="max-w-2xl mb-12">
				<h2 class="font-heading text-3xl md:text-4xl font-bold text-white tracking-tight mb-4">
					Choose a way to work together
				</h2>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-10">
				{engagementModels.map((model) => (
					<article class="interactive-card bg-[#0a0f1d] border border-white/10 hover:border-cyan-400/40 rounded-2xl p-7 flex flex-col justify-between">
						<div>
							<h3 class="font-heading text-xl font-bold text-white mb-3">
								<a href={model.href} class="hover:text-cyan-400 transition-colors duration-150">
									{model.title}
								</a>
							</h3>
							<p class="text-slate-300 text-sm leading-relaxed mb-6 prose-measure">
								{model.description}
							</p>
						</div>
						<a
							href={model.href}
							class="inline-flex items-center text-sm font-semibold text-cyan-400 hover:text-cyan-300 transition-colors duration-150"
						>
							Learn more
							<svg class="w-4 h-4 ml-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
							</svg>
						</a>
					</article>
				))}
			</div>

			<div>
				<a
					href="/engagement/fixed-price"
					class="inline-flex items-center px-6 py-3 rounded-full border border-white/15 hover:border-white/30 text-sm font-semibold text-white transition-colors duration-150"
				>
					Compare Engagement Options
				</a>
			</div>
		</div>
	</section>

	<!-- Featured Articles / Insights -->
	<section class="py-20 lg:py-28 bg-brand-dark border-b border-white/5">
		<div class="max-w-7xl mx-auto px-6">
			<div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
				<div class="max-w-2xl">
					<h2 class="font-heading text-3xl md:text-4xl font-bold text-white tracking-tight mb-4">
						Practical notes for better product decisions
					</h2>
					<p class="text-slate-300 text-base leading-relaxed prose-measure">
						Read our guides to choosing a development approach, planning software and evaluating AI features. Each article focuses on decisions that affect delivery and day-to-day use.
					</p>
				</div>
				<a
					href="/blog"
					class="inline-flex items-center text-sm font-semibold text-cyan-400 hover:text-cyan-300 transition-colors duration-150 shrink-0"
				>
					View All Insights
					<svg class="w-4 h-4 ml-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
					</svg>
				</a>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
				{featuredArticles.map((article) => (
					<article class="interactive-card bg-[#0a0f1d] border border-white/10 hover:border-cyan-400/40 rounded-2xl overflow-hidden flex flex-col">
						<div class="aspect-[3/2] w-full bg-slate-900 overflow-hidden border-b border-white/5">
							<img
								src={`/assets/zetalogix-v1/${article.stem}-800.webp`}
								srcset={`/assets/zetalogix-v1/${article.stem}-480.webp 480w, /assets/zetalogix-v1/${article.stem}-800.webp 800w, /assets/zetalogix-v1/${article.stem}-1200.webp 1200w`}
								sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
								width="800"
								height="533"
								loading="lazy"
								decoding="async"
								alt={article.alt}
								class="w-full h-full object-cover"
							/>
						</div>
						<div class="p-6 flex flex-col flex-grow">
							<span class="text-xs font-semibold text-cyan-400 uppercase tracking-wider mb-2">
								{article.category}
							</span>
							<h3 class="font-heading text-lg font-bold text-white mb-2.5">
								<a href={article.href} class="hover:text-cyan-400 transition-colors duration-150">
									{article.title}
								</a>
							</h3>
							<p class="text-slate-300 text-sm leading-relaxed mb-6 flex-grow">
								{article.description}
							</p>
							<a
								href={article.href}
								class="inline-flex items-center text-sm font-semibold text-cyan-400 hover:text-cyan-300 transition-colors duration-150 mt-auto"
							>
								Read article
								<svg class="w-4 h-4 ml-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
								</svg>
							</a>
						</div>
					</article>
				))}
			</div>
		</div>
	</section>

	<!-- Working Across Locations & Closing CTA -->
	<section class="py-20 lg:py-28 bg-[#070b16]">
		<div class="max-w-7xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-2 gap-10 items-stretch">
			<div class="rounded-3xl border border-white/10 bg-[#0a0f1d] p-8 md:p-10 flex flex-col justify-center">
				<h2 class="font-heading text-2xl md:text-3xl font-bold text-white mb-4">
					Working across locations
				</h2>
				<p class="text-slate-300 text-base leading-relaxed prose-measure">
					We are based in Pakistan and work with businesses internationally. We agree communication hours, review routines and delivery responsibilities around the needs of each project.
				</p>
			</div>

			<div class="rounded-3xl border border-cyan-400/20 bg-slate-900/70 p-8 md:p-10 flex flex-col justify-center">
				<h2 class="font-heading text-2xl md:text-3xl font-bold text-white mb-4">
					Start with the problem you want to solve
				</h2>
				<p class="text-slate-300 text-base leading-relaxed mb-8 prose-measure">
					You do not need a finished specification to begin a conversation. Share your idea, current product or operational challenge, and tell us where you would like help.
				</p>
				<div>
					<a
						href="/contact"
						data-astro-prefetch="hover"
						class="cta-primary inline-flex items-center justify-center px-7 py-3.5 rounded-full bg-cyan-400 hover:bg-cyan-300 text-slate-950 font-semibold text-sm"
					>
						Discuss Your Project
					</a>
				</div>
			</div>
		</div>
	</section>

	<Footer />
</BaseLayout>