<script>
	const setupPortfolioFilter = () => {
		const buttons = document.querySelectorAll<HTMLButtonElement>('[data-portfolio-filter]');
		const items = document.querySelectorAll<HTMLElement>('[data-portfolio-item]');

		buttons.forEach((btn) => {
			btn.addEventListener('click', () => {
				const filter = btn.getAttribute('data-portfolio-filter');
				buttons.forEach((b) => {
					const active = b === btn;
					b.classList.toggle('bg-cyan-400', active);
					b.classList.toggle('text-slate-950', active);
					b.classList.toggle('border-cyan-400', active);
					b.classList.toggle('bg-[#0a0f1d]', !active);
					b.classList.toggle('text-slate-300', !active);
					b.classList.toggle('border-white/10', !active);
				});

				items.forEach((item) => {
					const category = item.getAttribute('data-portfolio-item');
					const show = filter === 'all' || category === filter;
					item.classList.toggle('hidden', !show);
				});
			});
		});
	};

	setupPortfolioFilter();
</script>