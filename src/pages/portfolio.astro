---
// src/pages/portfolio.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/global/Navbar.astro';
import Footer from '../components/global/Footer.astro';

const concepts = [
	{
		number: '01',
		filterKey: 'mobile',
		title: 'Appointment Booking Concept',
		badge: 'Design concept — not client work',
		category: 'Mobile Product Study',
		platforms: 'iOS & Android (Shared-Code Architecture)',
		serviceLink: '/services/mobile-development',
		serviceLabel: 'Mobile App Development',
		articleLink: '/blog/flutter-for-ios-development-everything-you-need',
		articleLabel: 'Is Flutter Right for Your iOS App?',
		description: 'A mobile journey for finding a service, choosing an available time and reviewing a booking.',
		question:
			'How could a mobile booking journey help someone understand the available choices without moving through unnecessary screens?',
		direction:
			'The visual study brings service context, a calendar and booking details into a consistent interface. The intended journey is select a service, choose a time and review the details before confirmation.',
		deliverables: [
			'3-step linear booking flow (Service → Slot → Review)',
			'Time-zone aware availability & slot-locking model',
			'Offline-resilient state handling for interrupted networks',
		],
		href: '/concepts/appointment-booking',
		stem: 'mobile-development',
		secondaryImage: '/assets/zetalogix-v1/concept-booking-flow.webp',
		alt: 'Original mobile booking interface concept on two phones.',
		techStack: ['Flutter', 'React Native', 'REST APIs', 'Slot Locking'],
	},
	{
		number: '02',
		filterKey: 'saas',
		title: 'Team Workspace Concept',
		badge: 'Design concept — not client work',
		category: 'SaaS Architecture Study',
		platforms: 'Web Application & Multi-Tenant Admin',
		serviceLink: '/services/saas-development',
		serviceLabel: 'SaaS Development',
		articleLink: '/blog/how-saas-can-transform-the-real-estate-business',
		articleLabel: 'Planning Real Estate SaaS Around Daily Work',
		description: 'A dashboard direction for organizing work, viewing project cards and managing account roles.',
		question:
			'How could a team see important work and manage access without filling the interface with competing controls?',
		direction:
			'The study groups project cards in a primary workspace and places account controls in a separate panel. The visual hierarchy aims to distinguish everyday work from administration.',
		deliverables: [
			'Separated workspace execution & role-permission panels',
			'Role-based access control (RBAC) boundary modeling',
			'Tenant-isolated project views & onboarding empty states',
		],
		href: '/concepts/team-workspace',
		stem: 'saas-development',
		secondaryImage: '/assets/zetalogix-v1/concept-workspace-roles.webp',
		alt: 'Original dashboard concept with project cards and account controls.',
		techStack: ['React', 'TypeScript', 'PostgreSQL', 'RBAC'],
	},
	{
		number: '03',
		filterKey: 'ai',
		title: 'Document Search Concept',
		badge: 'Design concept — not client work',
		category: 'Applied AI & Retrieval Study',
		platforms: 'Internal Knowledge Portal & Evaluation Pipeline',
		serviceLink: '/services/ai-solutions',
		serviceLabel: 'AI & Machine Learning',
		articleLink: '/blog/implementing-rag-systems',
		articleLabel: 'Planning a Useful RAG Pilot for Business Documents',
		description:
			'An illustration of organizing business information for a permission-aware search and review experience.',
		question:
			'How could a user find relevant material while keeping access boundaries and source checking clear?',
		direction:
			'A real product could retrieve approved documents, show relevant passages and let the user inspect the source before acting. The visual illustration represents information becoming more organized; it is not an exact architecture diagram.',
		deliverables: [
			'Permission-filtered document ingestion & passage retrieval',
			'Inline source citations with direct passage inspection',
			'Evaluation harness for unanswerable & ambiguous queries',
		],
		href: '/concepts/document-search',
		stem: 'ai-solutions',
		secondaryImage: '/assets/zetalogix-v1/concept-rag-citations.webp',
		alt: 'Conceptual illustration of unstructured information becoming organized.',
		techStack: ['Python', 'RAG Retrieval', 'Vector Search', 'Source Citations'],
	},
];

const engineeringBridge = [
	{
		step: '01',
		title: 'Workflow & Friction Mapping',
		detail:
			'Before drawing screens, we isolate the exact task users repeat, where handovers fail, and which decisions require clarity.',
	},
	{
		step: '02',
		title: 'Interactive Prototyping & State Design',
		detail:
			'We design the primary journey alongside empty states, loading skeletons, permission blocks, and validation errors.',
	},
	{
		step: '03',
		title: 'Data Boundaries & API Contracts',
		detail:
			'Every interface concept is paired with a clear backend contract—defining who owns the data, how roles are enforced, and how failures recover.',
	},
	{
		step: '04',
		title: 'Scoped Milestone Implementation',
		detail:
			'We build the first useful release in reviewable stages, testing real device behavior, network latency, and operational handover.',
	},
];

const caseStudyStandards = [
	{ label: 'Context & Constraints', detail: 'The business problem, user workflow and technical boundaries.' },
	{ label: 'Verified Contribution', detail: 'Exact engineering and design work performed by Zetalogix.' },
	{ label: 'Architectural Decisions', detail: 'Key trade-offs chosen for maintainability and performance.' },
	{ label: 'Measured Outcomes', detail: 'Documented deliverables and client-approved release evidence.' },
];
---

<BaseLayout
	title="Software Projects & Product Concepts | Zetalogix"
	description="Explore approved Zetalogix project stories and clearly labeled product concepts, including the problem, approach and scope behind each example."
	breadcrumbs={[
		{ name: 'Home', url: '/' },
		{ name: 'Our Work', url: '/portfolio' },
	]}
>
	<Navbar />

	<!-- Split Architectural Hero -->
	<section class="relative pt-32 pb-20 lg:pt-40 lg:pb-28 bg-brand-dark bg-grid-pattern border-b border-white/10 overflow-hidden">
		<div
			class="absolute -top-24 left-1/4 w-[550px] h-[550px] bg-cyan-500/12 rounded-full blur-[130px] -z-10 pointer-events-none"
			aria-hidden="true"
		></div>
		<div
			class="absolute top-1/3 right-10 w-[450px] h-[450px] bg-violet-600/12 rounded-full blur-[130px] -z-10 pointer-events-none"
			aria-hidden="true"
		></div>

		<div class="max-w-7xl mx-auto px-6 relative z-10">
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
				<div class="lg:col-span-7">
					<div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-white/[0.04] border border-cyan-400/30 mb-6">
						<span class="w-2 h-2 rounded-full bg-cyan-400"></span>
						<span class="text-xs font-mono font-bold text-cyan-300 uppercase tracking-widest">
							Our Work &amp; Product Studies
						</span>
					</div>

					<h1 class="font-heading text-4xl sm:text-5xl lg:text-6xl font-bold text-white tracking-tight mb-6 leading-[1.08]">
						A closer look at the products we{' '}
						<span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-sky-300 to-violet-400">
							build and explore.
						</span>
					</h1>

					<p class="text-base sm:text-lg text-slate-300 leading-relaxed mb-8 prose-measure">
						Good work is easier to assess when you can see the context. Our project stories explain the problem, our contribution and the decisions behind the solution. Product concepts are labeled separately and do not represent commissioned client work.
					</p>

					<div class="grid grid-cols-3 gap-4 pt-8 border-t border-white/10">
						<div>
							<span class="block text-xs font-mono uppercase tracking-wider text-cyan-400 mb-1">01 // Mobile</span>
							<span class="text-xs sm:text-sm font-medium text-slate-300">Booking &amp; Field Workflows</span>
						</div>
						<div>
							<span class="block text-xs font-mono uppercase tracking-wider text-violet-400 mb-1">02 // SaaS</span>
							<span class="text-xs sm:text-sm font-medium text-slate-300">Multi-Role Workspaces</span>
						</div>
						<div>
							<span class="block text-xs font-mono uppercase tracking-wider text-emerald-400 mb-1">03 // Applied AI</span>
							<span class="text-xs sm:text-sm font-medium text-slate-300">Permission-Aware RAG</span>
						</div>
					</div>
				</div>

				<!-- Hero Visual Frame (Uses portfolio-architecture.webp with automatic fallback) -->
				<div class="lg:col-span-5">
					<div class="device-frame-hover rounded-3xl overflow-hidden border border-white/15 bg-[#0a0f1d] shadow-[0_25px_70px_rgba(0,0,0,0.75)]">
						<div class="h-8 bg-[#0f172a] border-b border-white/10 flex items-center justify-between px-4">
							<div class="flex items-center gap-1.5">
								<span class="w-2.5 h-2.5 rounded-full bg-rose-500/80"></span>
								<span class="w-2.5 h-2.5 rounded-full bg-amber-500/80"></span>
								<span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80"></span>
							</div>
							<span class="text-[11px] font-mono text-slate-400">zetalogix // product-studies</span>
						</div>
						<img
							src="/assets/zetalogix-v1/portfolio-architecture.webp"
							onerror="this.onerror=null;this.src='/assets/zetalogix-v1/custom-software-800.webp';"
							width="1200"
							height="800"
							fetchpriority="high"
							decoding="async"
							alt="Modular components representing connected business software."
							class="w-full aspect-[3/2] object-cover"
						/>
						<div class="px-5 py-3.5 bg-[#070b16] border-t border-white/10 flex items-center justify-between text-xs text-slate-400">
							<span>Illustrative architecture &amp; interface system</span>
							<span class="font-mono text-cyan-400">3 Concept Studies</span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Product Concepts Showcase with Interactive Domain Filter -->
	<section class="py-24 lg:py-32 bg-brand-dark border-b border-white/10">
		<div class="max-w-7xl mx-auto px-6">
			<div class="reveal flex flex-col lg:flex-row lg:items-end justify-between mb-16 gap-8">
				<div class="max-w-2xl">
					<span class="font-mono text-xs font-bold tracking-widest text-cyan-400 uppercase mb-3 flex items-center gap-2">
						<span class="w-8 h-px bg-cyan-400"></span> Design &amp; Architecture Explorations
					</span>
					<h2 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight mb-4">
						Product concepts
					</h2>
					<p class="text-slate-300 text-base sm:text-lg leading-relaxed prose-measure">
						Original interface studies showing how common business workflows could be designed. These are illustrative concepts, not deployed products or client endorsements.
					</p>
				</div>

				<!-- Interactive Filter Bar -->
				<div class="flex flex-wrap gap-2" role="group" aria-label="Filter product concepts">
					<button
						type="button"
						data-portfolio-filter="all"
						class="portfolio-filter-btn px-4 py-2 rounded-full text-xs sm:text-sm font-semibold bg-cyan-400 text-slate-950 border border-cyan-400 transition-colors"
					>
						All Studies (3)
					</button>
					<button
						type="button"
						data-portfolio-filter="mobile"
						class="portfolio-filter-btn px-4 py-2 rounded-full text-xs sm:text-sm font-semibold bg-[#0a0f1d] text-slate-300 border border-white/10 hover:border-white/25 transition-colors"
					>
						Mobile Apps
					</button>
					<button
						type="button"
						data-portfolio-filter="saas"
						class="portfolio-filter-btn px-4 py-2 rounded-full text-xs sm:text-sm font-semibold bg-[#0a0f1d] text-slate-300 border border-white/10 hover:border-white/25 transition-colors"
					>
						SaaS &amp; Web
					</button>
					<button
						type="button"
						data-portfolio-filter="ai"
						class="portfolio-filter-btn px-4 py-2 rounded-full text-xs sm:text-sm font-semibold bg-[#0a0f1d] text-slate-300 border border-white/10 hover:border-white/25 transition-colors"
					>
						Applied AI &amp; RAG
					</button>
				</div>
			</div>

			<div class="space-y-16">
				{concepts.map((concept, idx) => (
					<article
						data-portfolio-item={concept.filterKey}
						class="reveal group rounded-[2.25rem] bg-[#0a0f1d] border border-white/10 hover:border-cyan-400/35 p-8 md:p-12 shadow-2xl transition-colors duration-200"
					>
						<div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
							<!-- Layered Visual Mockup Column -->
							<div class={`lg:col-span-7 ${idx % 2 === 1 ? 'lg:order-2' : ''}`}>
								<div class="relative w-full aspect-[16/10] flex items-center justify-center">
									<!-- Primary Browser Frame -->
									<div class="device-frame-hover device-frame-desktop absolute top-0 left-0 w-[84%] h-[86%] rounded-2xl overflow-hidden border border-white/15 shadow-[0_25px_60px_rgba(0,0,0,0.7)] bg-[#0f172a]">
										<div class="h-7 w-full bg-[#0f172a] border-b border-white/10 flex items-center justify-between px-4">
											<div class="flex items-center gap-1.5">
												<span class="w-2.5 h-2.5 rounded-full bg-rose-500/80"></span>
												<span class="w-2.5 h-2.5 rounded-full bg-amber-500/80"></span>
												<span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80"></span>
											</div>
											<span class="text-[11px] font-mono text-slate-400">
												study-{concept.number} // {concept.platforms}
											</span>
										</div>
										<img
											src={`/assets/zetalogix-v1/${concept.stem}-800.webp`}
											srcset={`/assets/zetalogix-v1/${concept.stem}-480.webp 480w, /assets/zetalogix-v1/${concept.stem}-800.webp 800w, /assets/zetalogix-v1/${concept.stem}-1200.webp 1200w`}
											sizes="(min-width: 1024px) 50vw, 95vw"
											width="1200"
											height="800"
											loading={idx === 0 ? 'eager' : 'lazy'}
											decoding="async"
											alt={concept.alt}
											class="w-full h-full object-cover object-top"
										/>
									</div>

									<!-- Overlapping Secondary Detail Card -->
									<div class="device-frame-hover device-frame-mobile absolute -bottom-3 right-0 w-[42%] aspect-[3/2] rounded-2xl overflow-hidden border-2 border-cyan-400/30 shadow-[0_30px_60px_rgba(0,0,0,0.9)] bg-[#050814] z-20">
										<img
											src={concept.secondaryImage}
											onerror={`this.onerror=null;this.src='/assets/zetalogix-v1/${concept.stem}-480.webp';`}
											width="480"
											height="320"
											loading="lazy"
											decoding="async"
											alt=""
											class="w-full h-full object-cover object-center"
										/>
									</div>
								</div>
							</div>

							<!-- Expanded Study Details Column -->
							<div class={`lg:col-span-5 ${idx % 2 === 1 ? 'lg:order-1' : ''} flex flex-col justify-center`}>
								<div class="flex flex-wrap items-center gap-2.5 mb-4">
									<span class="px-3 py-1 rounded-md bg-amber-500/10 border border-amber-400/30 text-amber-300 font-mono text-xs font-medium">
										{concept.badge}
									</span>
									<span class="text-xs font-mono font-bold text-cyan-400 uppercase tracking-wider">
										{concept.category}
									</span>
								</div>

								<h3 class="font-heading text-2xl sm:text-3xl lg:text-4xl font-bold text-white mb-3 leading-tight group-hover:text-cyan-400 transition-colors duration-150">
									<a href={concept.href}>{concept.title}</a>
								</h3>

								<p class="text-slate-300 text-base leading-relaxed mb-5">
									{concept.description}
								</p>

								<!-- Question & Proposed Direction Box -->
								<div class="p-5 rounded-2xl bg-[#050814]/90 border border-white/10 space-y-3 mb-6">
									<div>
										<span class="block text-[11px] font-mono uppercase tracking-wider text-cyan-400 mb-1">
											The Product Question
										</span>
										<p class="text-slate-200 text-sm leading-relaxed">
											{concept.question}
										</p>
									</div>
									<div class="pt-3 border-t border-white/10">
										<span class="block text-[11px] font-mono uppercase tracking-wider text-violet-400 mb-1">
											Proposed Direction
										</span>
										<p class="text-slate-300 text-xs sm:text-sm leading-relaxed">
											{concept.direction}
										</p>
									</div>
								</div>

								<!-- Key Study Focus Points -->
								<ul class="space-y-2 mb-6">
									{concept.deliverables.map((item) => (
										<li class="flex items-start gap-2.5 text-xs sm:text-sm text-slate-300">
											<span class="w-1.5 h-1.5 rounded-full bg-cyan-400 mt-2 shrink-0"></span>
											<span>{item}</span>
										</li>
									))}
								</ul>

								<div class="flex flex-wrap gap-2 mb-8">
									{concept.techStack.map((tech) => (
										<span class="px-3 py-1 rounded-full bg-white/[0.04] border border-white/10 text-xs font-mono text-slate-300">
											{tech}
										</span>
									))}
								</div>

								<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-6 border-t border-white/10">
									<a
										href={concept.href}
										class="cta-primary inline-flex items-center justify-center px-6 py-3 rounded-full bg-cyan-400 hover:bg-cyan-300 text-slate-950 font-bold text-sm"
									>
										Explore the Concept
										<svg class="w-4 h-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
										</svg>
									</a>
									<div class="flex flex-col text-xs font-mono text-slate-400 space-y-1">
										<a href={concept.serviceLink} class="hover:text-cyan-400 transition-colors">
											Service: {concept.serviceLabel} &rarr;
										</a>
										<a href={concept.articleLink} class="hover:text-cyan-400 transition-colors">
											Guide: {concept.articleLabel} &rarr;
										</a>
									</div>
								</div>
							</div>
						</div>
					</article>
				))}
			</div>
		</div>
	</section>

	<!-- Architectural Section: How Concepts Become Production Software -->
	<section class="py-24 bg-[#070b16] border-b border-white/10">
		<div class="max-w-7xl mx-auto px-6">
			<div class="reveal max-w-2xl mb-16">
				<span class="font-mono text-xs font-bold tracking-widest text-violet-400 uppercase mb-3 flex items-center gap-2">
					<span class="w-8 h-px bg-violet-400"></span> Engineering Methodology
				</span>
				<h2 class="font-heading text-3xl sm:text-4xl font-bold text-white tracking-tight mb-4">
					How a design concept becomes a working release
				</h2>
				<p class="text-slate-300 text-base leading-relaxed prose-measure">
					An interface study is the starting point for a conversation, not the finished product. When you commission a build, we move through four structured engineering stages.
				</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
				{engineeringBridge.map((item, idx) => (
					<div class={`reveal reveal-delay-${(idx % 3) + 1} p-7 rounded-3xl bg-[#0a0f1d] border border-white/10 flex flex-col justify-between`}>
						<div>
							<span class="font-heading text-4xl font-bold text-cyan-400/20 block mb-4">
								{item.step}
							</span>
							<h3 class="font-heading text-xl font-bold text-white mb-3">
								{item.title}
							</h3>
							<p class="text-slate-300 text-sm leading-relaxed">
								{item.detail}
							</p>
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- Client Projects Section (Required Honest Empty State + Provenance Standard) -->
	<section class="py-24 lg:py-28 bg-brand-dark border-b border-white/10">
		<div class="max-w-7xl mx-auto px-6">
			<div class="reveal rounded-[2.25rem] bg-gradient-to-br from-[#0a0f1d] via-[#0d1528] to-[#0a0f1d] border border-white/15 p-8 sm:p-12 lg:p-14">
				<div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
					<div class="lg:col-span-6">
						<span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-400/10 border border-cyan-400/20 text-xs font-mono text-cyan-300 mb-4">
							Verified Provenance Policy
						</span>
						<h2 class="font-heading text-3xl sm:text-4xl font-bold text-white tracking-tight mb-4">
							Client projects
						</h2>
						<p class="text-slate-200 text-base sm:text-lg leading-relaxed mb-6 prose-measure">
							We are preparing project stories for publication. Contact us to discuss examples relevant to your requirements and what we are permitted to share.
						</p>
						<a
							href="/contact"
							data-astro-prefetch="hover"
							class="inline-flex items-center text-sm font-bold text-cyan-400 hover:text-white transition-colors duration-150"
						>
							Request relevant walkthroughs
							<svg class="w-4 h-4 ml-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
							</svg>
						</a>
					</div>

					<div class="lg:col-span-6 grid grid-cols-1 sm:grid-cols-2 gap-4">
						{caseStudyStandards.map((item, idx) => (
							<div class="p-5 rounded-2xl bg-[#050814]/90 border border-white/10">
								<span class="block text-xs font-mono font-bold text-cyan-400 mb-1.5">
									0{idx + 1} // {item.label}
								</span>
								<p class="text-slate-300 text-xs sm:text-sm leading-relaxed">
									{item.detail}
								</p>
							</div>
						))}
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Closing Conversion Section -->
	<section class="py-24 bg-[#050814] bg-grid-pattern relative overflow-hidden">
		<div class="max-w-4xl mx-auto px-6 text-center relative z-10">
			<div class="reveal rounded-3xl border border-cyan-400/30 bg-gradient-to-br from-[#0d172a] via-[#0a0f1d] to-[#111029] p-8 sm:p-12 shadow-2xl">
				<h2 class="font-heading text-3xl sm:text-4xl font-bold text-white tracking-tight mb-4">
					Have a Similar Product in Mind?
				</h2>
				<p class="text-slate-300 text-base sm:text-lg leading-relaxed max-w-2xl mx-auto mb-8">
					Tell us what you are building, what is getting in the way and what a useful first release would look like. We will help you explore the next step.
				</p>
				<div class="flex flex-col sm:flex-row items-center justify-center gap-4">
					<a
