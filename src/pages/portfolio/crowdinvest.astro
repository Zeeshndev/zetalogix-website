---
// src/pages/portfolio/crowdinvest.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/global/Navbar.astro';
import ContactForm from '../../components/sections/ContactForm.astro';
import Footer from '../../components/global/Footer.astro';

// Tech Stack Categories mapping to standard clean Devicons based on the text provided
const technologies = [
  { name: "PHP", icon: "devicon-php-plain colored" },
  { name: "JavaScript", icon: "devicon-javascript-plain colored" },
  { name: "jQuery", icon: "devicon-jquery-plain colored" },
  { name: "HTML5", icon: "devicon-html5-plain colored" },
  { name: "CSS3", icon: "devicon-css3-plain colored" },
  { name: "MySQL", icon: "devicon-mysql-plain colored" }
];

const infrastructure = [
  { name: "Namecheap VPS", icon: "devicon-linux-plain text-white" } // Generic server icon for VPS
];
---

<BaseLayout title="Tokenized Financial Investment Web App for Crowdinvest | ZetaLogix">
    <Navbar />
    
    <main class="pt-20 bg-brand-dark text-slate-300">
        
        <section class="max-w-7xl mx-auto px-6 py-24 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
            
            <div class="lg:col-span-5 space-y-6">
                <span class="text-xs font-mono font-bold text-brand-accent tracking-widest uppercase block mb-2">Case Study Analysis</span>
                <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white leading-tight font-heading">
                    Tokenized Financial Investment Web Application Platform for Crowdinvest
                </h1>
                <p class="text-slate-400 text-lg leading-relaxed">
                    Learn how ZetaLogix delivered a Tokenized Financial Investment Web application platform for Crowdinvest, from ideation, user flows, and wireframes to High fidelity design, we were able to translate the initial brief from our client to a usable prototype that depicts all the features to be implemented on the platform.
                </p>

                <div class="space-y-4 text-sm md:text-base border-l-4 border-brand-accent pl-6 py-4 bg-[#0a0f1d]/50 rounded-r-xl border-t border-r border-b border-white/5 shadow-lg">
                    <div class="flex flex-col sm:flex-row sm:gap-4">
                        <span class="sm:w-28 shrink-0 font-bold text-white">Domain:</span>
                        <span class="text-slate-400">Fintech</span>
                    </div>
                    <div class="flex flex-col sm:flex-row sm:gap-4">
                        <span class="sm:w-28 shrink-0 font-bold text-white">Timeline:</span>
                        <span class="text-slate-400">May 2020 - September 2021</span>
                    </div>
                    <div class="flex flex-col sm:flex-row sm:gap-4">
                        <span class="sm:w-28 shrink-0 font-bold text-white">Services:</span>
                        <span class="text-slate-400">Project discovery, UX/UI design, Front-End Development, Back-End Development, Admin Development</span>
                    </div>
                    <div class="flex flex-col sm:flex-row sm:gap-4">
                        <span class="sm:w-28 shrink-0 font-bold text-white">Team:</span>
                        <span class="text-slate-400">Software Developers, 1 UX/UI Designer, 1 QA Engineer, 1 Project Manager, 1 DevOps Engineer</span>
                    </div>
                    <div class="flex flex-col sm:flex-row sm:gap-4">
                        <span class="sm:w-28 shrink-0 font-bold text-white">Core Tech:</span>
                        <span class="text-slate-400">PHP, JavaScript, JQuery, HTML, CSS3, MySQL, Namecheap VPS.</span>
                    </div>
                </div>
            </div>

            <div class="lg:col-span-7 relative">
                <div class="absolute inset-0 bg-brand-accent/5 blur-[100px] rounded-full pointer-events-none"></div>
                <img 
                    src="/assets/portfolio/Tokenized/crowdinvest_mockup.png" 
                    alt="Crowdinvest Platform Mockup" 
                    class="w-full h-auto drop-shadow-2xl rounded-xl object-contain relative z-10"
                />
            </div>
        </section>

        <section class="max-w-4xl mx-auto px-6 pb-20">
            <p class="text-xl md:text-2xl font-medium text-white leading-relaxed mb-8 italic text-center">
                "Working with ZetaLogix was a pleasure. The turnaround time was fast and on time. Their communication was professional and courteous. Our foundation members enjoyed the conference calls and the final product was beyond our expectations. We would definitely."
            </p>
            <div class="flex items-center justify-center gap-4">
                <div class="w-14 h-14 rounded-full bg-[#0a0f1d] border-2 border-brand-accent overflow-hidden">
                    <img src="https://images.unsplash.com/photo-1560250097-0b93528c311a?q=80&w=200&auto=format&fit=crop" alt="CEO Avatar" class="w-full h-full object-cover filter grayscale opacity-80" />
                </div>
                <span class="text-slate-400 font-medium">CEO Crowdinvest</span>
            </div>
        </section>

        <section class="py-24 bg-[#050814] border-y border-white/5 relative">
            <div class="max-w-7xl mx-auto px-6 relative z-10">
                
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    
                    <div class="bg-[#0a0f1d] border border-white/5 rounded-2xl p-8 hover:border-white/10 transition-colors shadow-lg">
                        <div class="w-12 h-12 rounded-full bg-[#050814] border border-white/10 flex items-center justify-center mb-6">
                            <svg class="w-6 h-6 text-brand-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
                        </div>
                        <h3 class="text-2xl font-bold text-white font-heading mb-4">Background</h3>
                        <p class="text-slate-400 leading-relaxed text-sm mb-4">
                            CrowdInvest is a Crypto/Affiliate marketing company founded by a group of young visionaries, with the aim of becoming the world's Largest trading network. The Platform has been encrypted to function through the use of a digital currency known as Kcoins (VCN).
                        </p>
                        <p class="text-slate-400 leading-relaxed text-sm mb-4">
                            Kcoins (VCN) is a unique digital currency that our platform uses as an identifiable means of exchange and transcoded to distinguish us from other investment platforms. Kcoins (VCN) can be accumulated and traded for fiat or other Cryptocurrencies within and outside the CrowdInvest community.
                        </p>
                        <p class="text-slate-400 leading-relaxed text-sm">
                            The customer wanted us to build an investment website that would allow investors/users to invest in a digital token that is regulated by trade volume (demand & supply). The website should be able to monitor and indicate to the investors; the value of their present investments, maturity time, and trade volume.
                        </p>
                    </div>

                    <div class="bg-[#0a0f1d] border border-white/5 rounded-2xl p-8 hover:border-white/10 transition-colors shadow-lg">
                        <div class="w-12 h-12 rounded-full bg-[#050814] border border-white/10 flex items-center justify-center mb-6">
                            <svg class="w-6 h-6 text-brand-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
                        </div>
                        <h3 class="text-2xl font-bold text-white font-heading mb-4">Business Challenges</h3>
                        <ul class="space-y-3 text-slate-400 leading-relaxed text-xs list-disc list-outside pl-4 marker:text-brand-accent">
                            <li>Effectively translate the business goals and product user flows into visually appealing and mobile-friendly UX/UI Designs.</li>
                            <li>Develop a token that would be used only within the platform, regulated by the laws of demand and supply.</li>
                            <li>Build a referral system that will auto-generate a unique referral link/code for each user upon registration.</li>
                            <li>Create a wallet system that allows users to store and send virtual tokens.</li>
                            <li>Develop an investment timer that monitors the investment duration and percentage return on investment.</li>
                            <li>Develop and integrate multiple channels for deposits and withdrawals, including blockchain-based protocols.</li>
                            <li>Develop & integrate a series of security protocols like email verification and 2-way authentication protocols.</li>
                            <li>Build a separate multi-admin platform for monitoring and managing the entire system.</li>
                        </ul>
                    </div>

                    <div class="bg-[#0a0f1d] border border-white/5 rounded-2xl p-8 hover:border-brand-accent/30 transition-colors shadow-lg relative overflow-hidden">
                        <div class="absolute inset-0 bg-brand-accent/5 pointer-events-none"></div>
                        <div class="w-12 h-12 rounded-full bg-brand-accent/10 border border-brand-accent/30 flex items-center justify-center mb-6 relative z-10">
                            <svg class="w-6 h-6 text-brand-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                        </div>
                        <h3 class="text-2xl font-bold text-white font-heading mb-4 relative z-10">Value Delivered</h3>
                        <p class="text-slate-300 leading-relaxed text-xs mb-3 relative z-10">
                            Project Ideation; From ideas to concepts and a clear product road map, we were able to help the client define the product, its market, and its users together with the value it offers.
                        </p>
                        <p class="text-slate-300 leading-relaxed text-xs mb-3 relative z-10">
                            We Created a new UI and UX design for all of CrowdInvest platform software, ranging from a mobile responsive web application, admin portals, and a multi-page website. We developed a modern, robust, responsive, and fast-loading web solution.
                        </p>
                        <p class="text-slate-300 leading-relaxed text-xs mb-3 relative z-10">
                            We developed the admin portal, to ease the smooth management and governance of the platform and business in general.
                        </p>
                        <p class="text-slate-300 leading-relaxed text-xs relative z-10">
                            We designed and implemented a valid and hack-proof data synchronization system between the backend, admin, and the user's web application. We implemented HTTPS security encryption protocol, and storage data encryption security to prevent cyber-attacks.
                        </p>
                    </div>

                </div>
            </div>
        </section>

        <section class="max-w-6xl mx-auto px-6 py-24 space-y-32">
            <div class="mb-12">
                <span class="text-xs font-mono font-bold text-brand-accent tracking-widest uppercase block mb-2">Architectural Blueprint</span>
                <h2 class="text-3xl font-bold text-white mb-16 font-heading">Solution Delivered</h2>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
                <div class="order-2 lg:order-1 relative">
                    <div class="absolute inset-0 bg-brand-accent/5 blur-[50px] rounded-full"></div>
                    <img src="/assets/portfolio/Tokenized/crowdinvest_mockup (1).png" alt="Responsive Web Application" class="w-full h-auto drop-shadow-2xl relative z-10 rounded-xl" />
                </div>
                <div class="order-1 lg:order-2 space-y-4">
                    <h3 class="text-2xl font-bold text-white font-heading">Responsive Web Application</h3>
                    <p class="text-slate-400 leading-relaxed text-lg">
                        Our team delivered a responsive web application, which provides the best financial investment experience for crowdinvest users. Web applications are a comparative option to full scale mobile applications since it's faster to launch which would save a whole lot of time if you are looking to launch quickly into the market.
                    </p>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
                <div class="space-y-4">
                    <h3 class="text-2xl font-bold text-white font-heading">Multi-Page Website</h3>
                    <p class="text-slate-400 leading-relaxed text-lg">
                        We designed, developed and delivered a Multi-page website for crowdinvest. We went further to implement Search Engine Optimization for the web pages. This will help the brand to get it's first phase of visibility via cheap long term SEO strategies which we implemented.
                    </p>
                </div>
                <div class="relative">
                    <div class="absolute inset-0 bg-brand-accent/5 blur-[50px] rounded-full"></div>
                    <img src="/assets/portfolio/Tokenized/crowdinvest_web.png" alt="Multi-Page Website" class="w-full h-auto drop-shadow-2xl relative z-10 rounded-xl" />
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
                <div class="order-2 lg:order-1 relative">
                    <div class="absolute inset-0 bg-brand-accent/5 blur-[50px] rounded-full"></div>
                    <img src="/assets/portfolio/Tokenized/crowdinvest_admin.png" alt="Admin Portal" class="w-full h-auto drop-shadow-2xl relative z-10 rounded-xl" />
                </div>
                <div class="order-1 lg:order-2 space-y-4">
                    <h3 class="text-2xl font-bold text-white font-heading">Admin Portal Development</h3>
                    <p class="text-slate-400 leading-relaxed text-lg">
                        Our team delivered a responsive and viable admin portal. Admin portals are great tools and digital infrasturctures that gives platform owners a exclusive control and governance over their respective platforms. Crowdinvest admin portal isn't any different from what an admin portal does.
                    </p>
                </div>
            </div>

        </section>

        <section class="py-24 bg-[#0a0f1d] border-y border-white/5 relative overflow-hidden">
            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[300px] bg-brand-accent/5 blur-[120px] rounded-full pointer-events-none"></div>
            
            <div class="max-w-7xl mx-auto px-6 relative z-10">
                <div class="text-center mb-16">
                    <span class="text-xs font-mono font-bold text-brand-accent tracking-widest uppercase block mb-2">System Stack</span>
                    <h2 class="text-3xl font-bold text-white font-heading">Technologies & Infrastructure</h2>
                </div>
                
                <div class="flex flex-col lg:flex-row gap-16">
                    
                    <div class="flex-1 space-y-8">
                        <h4 class="text-xl font-bold text-white font-heading flex items-center justify-center lg:justify-start gap-3">
                            <span class="w-2 h-2 bg-brand-accent rounded-full"></span>
                            Core Technologies
                        </h4>
                        
                        <div class="flex flex-wrap justify-center lg:justify-start gap-4">
                            {technologies.map(tech => (
                                <div class="flex flex-col items-center justify-center w-[100px] h-[100px] shrink-0 rounded-2xl bg-[#050814] border border-white/5 hover:border-brand-accent/40 hover:-translate-y-1 transition-all shadow-lg cursor-pointer group">
                                    <div class="text-4xl mb-2">
                                        <i class={tech.icon}></i>
                                    </div>
                                    <span class="text-[11px] font-medium text-slate-400 group-hover:text-white transition-colors text-center">{tech.name}</span>
                                </div>
                            ))}
                        </div>
                    </div>

                    <div class="lg:w-[400px] space-y-8">
                        <h4 class="text-xl font-bold text-white font-heading flex items-center justify-center lg:justify-start gap-3">
                            <span class="w-2 h-2 bg-brand-accent rounded-full"></span>
                            Infrastructure
                        </h4>
                        
                        <div class="flex flex-wrap justify-center lg:justify-start gap-4">
                            {infrastructure.map(tech => (
                                <div class="flex flex-col items-center justify-center w-[100px] h-[100px] shrink-0 rounded-2xl bg-[#050814] border border-white/5 hover:border-brand-accent/40 hover:-translate-y-1 transition-all shadow-lg cursor-pointer group">
                                    <div class="text-4xl mb-2">
                                        <i class={tech.icon}></i>
                                    </div>
                                    <span class="text-[11px] font-medium text-slate-400 group-hover:text-white transition-colors text-center leading-tight">{tech.name}</span>
                                </div>
                            ))}
                        </div>
                    </div>

                </div>
            </div>
        </section>

        <section class="py-24 bg-[#050814] border-t border-white/5">
            <div class="max-w-7xl mx-auto px-6">
                <h2 class="text-3xl font-bold text-center text-white mb-16 font-heading">Other projects</h2>
                
                <div class="grid grid-cols-1 gap-16">
                    <div class="bg-[#5B21B6] rounded-3xl p-8 md:p-16 text-white grid grid-cols-1 lg:grid-cols-12 gap-12 items-center shadow-2xl relative overflow-hidden group">
                        <div class="absolute inset-0 bg-black/10 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
                        <div class="lg:col-span-6 space-y-6 relative z-10">
                            <h2 class="font-heading text-3xl md:text-4xl font-bold leading-tight">Wireless Instant Messaging Application for Wiccon</h2>
                            <a href="/portfolio/wiccon" class="inline-flex items-center justify-center px-6 py-3 bg-white/20 border border-white text-white font-bold rounded-xl hover:bg-white hover:text-[#5B21B6] transition-all duration-300">
                                View case study
                            </a>
                        </div>
                        <div class="lg:col-span-6 flex justify-center relative z-10">
                            <img src="/assets/portfolio/Wiconn.png" alt="Wiccon" class="w-full max-h-[350px] object-contain drop-shadow-2xl transform transition-transform duration-700 ease-out group-hover:scale-105" />
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <ContactForm />

    </main>

    <Footer />
</BaseLayout>