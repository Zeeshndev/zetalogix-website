---
// src/pages/portfolio/monnee.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/global/Navbar.astro';
import ContactForm from '../../components/sections/ContactForm.astro';
import Footer from '../../components/global/Footer.astro';

// Tech Stack Categories mapping to standard clean Devicons based on the Monnee stack
const technologies = [
  { name: "Node.js", icon: "devicon-nodejs-plain colored" },
  { name: "Express", icon: "devicon-express-original text-white" },
  { name: "PostgreSQL", icon: "devicon-postgresql-plain colored" },
  { name: "React", icon: "devicon-react-original colored" },
  { name: "Next.js", icon: "devicon-nextjs-original text-white" },
  { name: "Tailwind CSS", icon: "devicon-tailwindcss-plain colored" },
  { name: "Flutter", icon: "devicon-flutter-plain colored" },
  { name: "Jenkins", icon: "devicon-jenkins-line colored" }
];

const infrastructure = [
  { name: "DigitalOcean", icon: "devicon-digitalocean-original colored" }
];
---

<BaseLayout title="Monnee Case Study | ZetaLogix">
    <Navbar />
    
    <main class="pt-20 bg-brand-dark text-slate-300">
        
        <section class="max-w-7xl mx-auto px-6 py-24 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
            
            <div class="lg:col-span-5 space-y-6">
                <span class="text-xs font-mono font-bold text-brand-accent tracking-widest uppercase block mb-2">Case Study Analysis</span>
                <h1 class="text-3xl md:text-4xl font-bold text-white leading-tight font-heading">
                    Fintech Cross-Border and Local Payments for Monnee Inc.
                </h1>
                <p class="text-slate-400 text-base md:text-lg leading-relaxed">
                    Learn how ZetaLogix delivered a Fintech Application that provides cross-border payment solutions including IBANs & NUBAN for Nigerian businesses and individuals. From ideation, user flows, and wireframes to high-fidelity design, we translated the initial brief into a highly secure, usable platform.
                </p>

                <div class="space-y-3 text-sm border-l-4 border-brand-accent pl-6 py-4 bg-[#0a0f1d]/50 rounded-r-xl border-t border-r border-b border-white/5 shadow-lg">
                    <div class="grid grid-cols-1 sm:grid-cols-12 gap-2">
                        <div class="sm:col-span-4 font-bold text-white">Domain:</div>
                        <div class="sm:col-span-8 text-slate-400">Fintech</div>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-12 gap-2">
                        <div class="sm:col-span-4 font-bold text-white">Timeline:</div>
                        <div class="sm:col-span-8 text-slate-400">February 2024 - November 2024</div>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-12 gap-2">
                        <div class="sm:col-span-4 font-bold text-white">Services:</div>
                        <div class="sm:col-span-8 text-slate-400">Project discovery, UX/UI design, Front-End, Back-End, Admin Development</div>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-12 gap-2">
                        <div class="sm:col-span-4 font-bold text-white">Team:</div>
                        <div class="sm:col-span-8 text-slate-400">4 Software Engineers, 1 UX/UI Designer, 1 QA, 1 DevOps, 1 Project Manager</div>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-12 gap-2">
                        <div class="sm:col-span-4 font-bold text-white">Core Tech:</div>
                        <div class="sm:col-span-8 text-slate-400">Node.js, Express, Flutter (Dart), React, Next.js, PostgreSQL, DigitalOcean, Jenkins</div>
                    </div>
                </div>
            </div>

            <div class="lg:col-span-7 relative">
                <div class="rounded-2xl border border-white/10 overflow-hidden bg-[#0a0f1d] shadow-2xl relative z-10 p-2 sm:p-4">
                    <div class="absolute inset-0 bg-gradient-to-tr from-brand-accent/5 to-transparent pointer-events-none"></div>
                    <img 
                        src="/assets/portfolio/Monnee/monee.666c4ea3.png" 
                        alt="Monnee Platform Mockup" 
                        class="w-full h-auto object-cover rounded-xl relative z-10 transform hover:scale-[1.01] transition-transform duration-700 ease-out"
                    />
                </div>
            </div>
        </section>

        <section class="max-w-4xl mx-auto px-6 pb-20">
            <p class="text-xl md:text-2xl font-medium text-white leading-relaxed mb-8 italic text-center">
                "ZetaLogix looks beyond building an app for the sake of building and works in any capacity to see our project's success."
            </p>
            <div class="flex items-center justify-center gap-4">
                <div class="w-14 h-14 rounded-full bg-[#0a0f1d] border-2 border-brand-accent overflow-hidden">
                    <img src="https://images.unsplash.com/photo-1560250097-0b93528c311a?q=80&w=200&auto=format&fit=crop" alt="CEO Avatar" class="w-full h-full object-cover filter grayscale opacity-80" />
                </div>
                <span class="text-slate-400 font-medium">CEO Monnee Inc.</span>
            </div>
        </section>

        <section class="relative py-24 w-full bg-[#050814] overflow-hidden border-y border-white/5">
            <div class="absolute inset-0 z-0 opacity-20">
                <img src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?q=80&w=2000&auto=format&fit=crop" alt="Team collaborating" class="w-full h-full object-cover" />
            </div>
            <div class="absolute inset-0 bg-gradient-to-r from-[#050814] via-[#050814]/90 to-transparent z-0"></div>
            
            <div class="max-w-6xl mx-auto px-6 relative z-10 flex flex-col md:flex-row items-center justify-between gap-12">
                <div class="max-w-2xl">
                    <h2 class="text-3xl md:text-4xl font-bold text-white mb-4 leading-tight font-heading">
                        Do you need an experienced team to build a mobile application and web application?
                    </h2>
                    <p class="text-lg text-slate-400">
                        We make use of the best technologies and best practices to help you launch faster and save cost
                    </p>
                </div>
                <div class="shrink-0">
                    <a href="/contact" class="px-8 py-4 bg-brand-accent text-brand-dark font-bold rounded-lg hover:bg-white transition-colors shadow-[0_0_20px_rgba(34,211,238,0.2)]">
                        Talk to an expert
                    </a>
                </div>
            </div>
        </section>

        <section class="max-w-7xl mx-auto px-6 py-24 space-y-32">
            <div class="mb-12">
                <span class="text-xs font-mono font-bold text-brand-accent tracking-widest uppercase block mb-2">Architectural Blueprint</span>
                <h2 class="text-3xl font-bold text-white mb-16 font-heading">Solution Delivered</h2>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-center">
                <div class="lg:col-span-7 order-2 lg:order-1 relative">
                    <div class="absolute inset-0 bg-brand-accent/5 blur-[50px] rounded-full"></div>
                    <img src="/assets/portfolio/Monnee/monne-sec1.f5bfd1bf.png" alt="Website Development Mockup" class="w-full h-auto drop-shadow-2xl relative z-10 rounded-xl" />
                </div>
                <div class="lg:col-span-5 order-1 lg:order-2 space-y-4">
                    <h3 class="text-2xl font-bold text-white font-heading">Website Development</h3>
                    <p class="text-slate-400 leading-relaxed text-lg">
                        We designed and built a web and mobile-optimized marketing website for the Monnee app, ensuring seamless user onboarding and clear communication of their financial services.
                    </p>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-center">
                <div class="lg:col-span-5 space-y-4">
                    <h3 class="text-2xl font-bold text-white font-heading">Mobile Application Development</h3>
                    <p class="text-slate-400 leading-relaxed text-lg">
                        We designed and built a sleek, smooth mobile application for Monnee. The app prioritizes intuitive navigation, secure transaction handling, and cross-border financial management natively on user devices.
                    </p>
                </div>
                <div class="lg:col-span-7 relative">
                    <div class="absolute inset-0 bg-brand-accent/5 blur-[50px] rounded-full"></div>
                    <img src="/assets/portfolio/Monnee/monee-full.3da3fc8d.png" alt="Mobile App Mockup" class="w-full h-auto drop-shadow-2xl relative z-10 rounded-xl" />
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-center">
                <div class="lg:col-span-7 order-2 lg:order-1 relative">
                    <div class="absolute inset-0 bg-brand-accent/5 blur-[50px] rounded-full"></div>
                    <img src="/assets/portfolio/Monnee/monne-sec3.93ae94a0.png" alt="Web Admin Portal Mockup" class="w-full h-auto drop-shadow-2xl relative z-10 rounded-xl" />
                </div>
                <div class="lg:col-span-5 order-1 lg:order-2 space-y-4">
                    <h3 class="text-2xl font-bold text-white font-heading">Web Admin Portal</h3>
                    <p class="text-slate-400 leading-relaxed text-lg">
                        We built a web application super admin and admin portal that is fast, secured, and responsive on all web, mobile, and tablet screens. This aids admin personnel in monitoring and governing the platform across a range of devices.
                    </p>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-center">
                <div class="lg:col-span-5 space-y-4">
                    <h3 class="text-2xl font-bold text-white font-heading">Responsive Web Application</h3>
                    <p class="text-slate-400 leading-relaxed text-lg">
                        We built a responsive web application that gives the user a unique experience and feel similar to the mobile app. The web application is synchronized to the central backend and relays data to the admin portal, enabling robust control and governance.
                    </p>
                </div>
                <div class="lg:col-span-7 relative">
                    <div class="absolute inset-0 bg-brand-accent/5 blur-[50px] rounded-full"></div>
                    <img src="/assets/portfolio/Monnee/monne-sec4.d3301dcc.png" alt="Responsive Web App Mockup" class="w-full h-auto drop-shadow-2xl relative z-10 rounded-xl" />
                </div>
            </div>

        </section>

        <section class="py-24 bg-[#0a0f1d] border-y border-white/5 relative overflow-hidden">
            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[300px] bg-brand-accent/5 blur-[120px] rounded-full pointer-events-none"></div>
            
            <div class="max-w-7xl mx-auto px-6 relative z-10">
                <div class="text-center mb-16">
                    <span class="text-xs font-mono font-bold text-brand-accent tracking-widest uppercase block mb-2">System Stack</span>
                    <h2 class="text-3xl font-bold text-white font-heading">Technologies & Infrastructure</h2>
                </div>
                
                <div class="flex flex-col lg:flex-row gap-16">
                    
                    <div class="flex-1 space-y-8">
                        <h4 class="text-xl font-bold text-white font-heading flex items-center justify-center lg:justify-start gap-3">
                            <span class="w-2 h-2 bg-brand-accent rounded-full"></span>
                            Core Technologies
                        </h4>
                        
                        <div class="flex flex-wrap justify-center lg:justify-start gap-4">
                            {technologies.map(tech => (
                                <div class="flex flex-col items-center justify-center w-[100px] h-[100px] shrink-0 rounded-2xl bg-[#050814] border border-white/5 hover:border-brand-accent/40 hover:-translate-y-1 transition-all shadow-lg cursor-pointer group">
                                    <div class="text-4xl mb-2">
                                        <i class={tech.icon}></i>
                                    </div>
                                    <span class="text-[11px] font-medium text-slate-400 group-hover:text-white transition-colors text-center">{tech.name}</span>
                                </div>
                            ))}
                        </div>
                    </div>

                    <div class="lg:w-[400px] space-y-8">
                        <h4 class="text-xl font-bold text-white font-heading flex items-center justify-center lg:justify-start gap-3">
                            <span class="w-2 h-2 bg-brand-accent rounded-full"></span>
                            Infrastructure
                        </h4>
                        
                        <div class="flex flex-wrap justify-center lg:justify-start gap-4">
                            {infrastructure.map(tech => (
                                <div class="flex flex-col items-center justify-center w-[100px] h-[100px] shrink-0 rounded-2xl bg-[#050814] border border-white/5 hover:border-brand-accent/40 hover:-translate-y-1 transition-all shadow-lg cursor-pointer group">
                                    <div class="text-4xl mb-2">
                                        <i class={tech.icon}></i>
                                    </div>
                                    <span class="text-[11px] font-medium text-slate-400 group-hover:text-white transition-colors">{tech.name}</span>
                                </div>
                            ))}
                        </div>
                    </div>

                </div>
            </div>
        </section>

        <section class="py-24 bg-[#050814] border-t border-white/5">
            <div class="max-w-7xl mx-auto px-6">
                <h2 class="text-3xl font-bold text-center text-white mb-16 font-heading">Other projects</h2>
                
                <div class="grid grid-cols-1 gap-16">
                    <div class="bg-[#2A5CE6] rounded-3xl p-8 md:p-16 text-white grid grid-cols-1 lg:grid-cols-12 gap-12 items-center shadow-2xl relative overflow-hidden group">
                        <div class="absolute inset-0 bg-black/10 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
                        <div class="lg:col-span-6 space-y-6 relative z-10">
                            <h2 class="font-heading text-3xl md:text-4xl font-bold leading-tight">Digital Assets trading Mobile and web application for Litetrade</h2>
                            <a href="/portfolio/litetrade" class="inline-flex items-center justify-center px-6 py-3 bg-white/20 border border-white text-white font-bold rounded-xl hover:bg-white hover:text-[#2A5CE6] transition-all duration-300">
                                View case study
                            </a>
                        </div>
                        <div class="lg:col-span-6 flex justify-center relative z-10">
                            <img src="/assets/portfolio/Litetrade.png" alt="Litetrade" class="w-full max-h-[350px] object-contain drop-shadow-2xl transform transition-transform duration-700 ease-out group-hover:scale-105" />
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <ContactForm />

    </main>

    <Footer />
</BaseLayout>