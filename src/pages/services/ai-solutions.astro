---
// src/pages/services/ai-solutions.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/global/Navbar.astro';
import Footer from '../../components/global/Footer.astro';
import Cta from '../../components/sections/Cta.astro';

const features = [
  { 
    title: "Custom AI Assistants & LLMs", 
    desc: "We build secure, private conversational agents using Retrieval-Augmented Generation (RAG) so the AI answers questions strictly based on your proprietary corporate data.",
    icon: "M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"
  },
  { 
    title: "Business Process Automation", 
    desc: "Replace manual, error-prone tasks with intelligent workflows. We integrate AI to automatically route tickets, categorize emails, and trigger complex backend actions.",
    icon: "M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
  },
  { 
    title: "Document Intelligence (OCR & NLP)", 
    desc: "Extract structured data from thousands of unstructured PDFs, invoices, and contracts instantly using advanced Natural Language Processing and computer vision.",
    icon: "M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
  },
  { 
    title: "Predictive Machine Learning", 
    desc: "Leverage historical data to forecast trends, predict customer churn, and optimize supply chains. We train models that turn your raw data into predictive business intelligence.",
    icon: "M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z"
  },
  { 
    title: "Recommendation Systems", 
    desc: "Increase revenue and user engagement with highly personalized, AI-driven recommendation engines tailored for e-commerce storefronts and content marketplaces.",
    icon: "M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"
  },
  { 
    title: "MLOps & Secure Deployment", 
    desc: "We don't just build models; we operationalize them. We deploy containerized AI pipelines on AWS/GCP, ensuring low-latency inference and continuous model monitoring.",
    icon: "M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"
  }
];

const pipeline = [
  {
    step: 1,
    title: "Data Audit & Feasibility",
    desc: "We analyze your existing data silos, identify data quality gaps, and map out a secure, compliant strategy to leverage your information for machine learning.",
    active: true
  },
  {
    step: 2,
    title: "Model Selection & Architecture",
    desc: "Depending on your needs, we select the right tools—whether that means fine-tuning an open-source LLM, utilizing OpenAI's APIs securely, or training a custom neural network.",
    active: false
  },
  {
    step: 3,
    title: "Training, RAG & Integration",
    desc: "We build vector databases for accurate information retrieval, train the models, and seamlessly integrate the AI endpoints into your existing web or mobile applications.",
    active: false
  },
  {
    step: 4,
    title: "MLOps & Continuous Learning",
    desc: "Post-deployment, we implement strict monitoring to prevent model drift and hallucinations, ensuring your AI scales safely as new data flows into your system.",
    active: false
  }
];

const faqs = [
  { 
    q: "Will using AI put our proprietary corporate data at risk?", 
    a: "No. Data privacy is our highest priority. We do not use public models that train on your data (like the public ChatGPT). We implement isolated, self-hosted LLMs or enterprise-tier APIs with strict zero-retention policies, ensuring your data never leaves your secure cloud environment." 
  },
  { 
    q: "Do we need millions of data points to use AI?", 
    a: "Not anymore. While traditional machine learning requires massive datasets, modern AI utilizes Retrieval-Augmented Generation (RAG) and pre-trained Foundation Models. We can build a highly accurate internal AI assistant using just your existing company PDFs, databases, and manuals." 
  },
  { 
    q: "Can you integrate AI into our existing, legacy software?", 
    a: "Yes. We build custom API middleware (usually with Python and FastAPI) that sits between your legacy ERP/CRM systems and the AI models, allowing you to add intelligent features without rebuilding your entire IT infrastructure from scratch." 
  },
  { 
    q: "How do you prevent the AI from giving wrong answers (hallucinations)?", 
    a: "We engineer strict 'guardrails' into the system. By combining vector databases (Pinecone/Milvus) with precise prompt engineering and confidence-score thresholds, the AI is constrained to only answer using verified context we provide. If it doesn't know the answer, it is programmed to escalate to a human." 
  }
];
---

<BaseLayout 
    title="AI & Machine Learning Solutions | ZetaLogix"
    description="ZetaLogix engineers secure, enterprise-grade AI solutions including custom LLMs, document intelligence, and predictive machine learning models."
>
    <Navbar />

    <main class="relative z-10 bg-[#02040a]">
        
        {/* 1. Hero Section - Deep Technical Theme */}
        <section class="relative pt-40 pb-24 lg:pt-48 lg:pb-32 overflow-hidden border-b border-white/5">
            <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[600px] bg-purple-600/15 rounded-full blur-[150px] -z-10 pointer-events-none"></div>
            
            {/* Neural Net Matrix Background Effect */}
            <div class="absolute inset-0 opacity-[0.03] bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-white via-transparent to-transparent [background-size:40px_40px] pointer-events-none z-0"></div>

            <div class="max-w-7xl mx-auto px-6 text-center relative z-10">
                <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/5 border border-white/10 mb-8 backdrop-blur-sm">
                    <span class="w-2 h-2 rounded-full bg-purple-500 animate-pulse shadow-[0_0_10px_rgba(168,85,247,0.8)]"></span>
                    <span class="text-xs font-bold text-slate-300 uppercase tracking-widest">Applied Artificial Intelligence</span>
                </div>
                
                <h1 class="font-heading text-5xl md:text-6xl lg:text-7xl font-bold text-white tracking-tight mb-8 leading-tight max-w-5xl mx-auto">
                    Transform Operations with <br class="hidden md:block" />
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-indigo-500">Enterprise AI & Machine Learning.</span>
                </h1>
                
                <p class="text-xl text-slate-400 max-w-3xl mx-auto leading-relaxed mb-12">
                    We securely integrate generative AI, intelligent document processing, and predictive analytics directly into your business workflows, ensuring absolute data privacy.
                </p>

                <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
                    <a href="/contact" class="w-full sm:w-auto px-8 py-4 bg-purple-600 text-white font-bold rounded-full hover:bg-white hover:text-purple-900 transition-all duration-300 shadow-lg hover:shadow-purple-500/25">
                        Discuss Your AI Strategy
                    </a>
                    <a href="#architecture" class="w-full sm:w-auto px-8 py-4 bg-transparent text-white font-semibold rounded-full border border-white/20 hover:bg-white/10 transition-all duration-300">
                        Explore AI Capabilities
                    </a>
                </div>
            </div>
        </section>

        {/* 2. Business Problem & Solution */}
        <section id="architecture" class="py-24 lg:py-32 max-w-7xl mx-auto px-6">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
                <div class="order-2 lg:order-1">
                    <h2 class="font-heading text-sm font-bold tracking-widest text-slate-500 uppercase mb-4">The Challenge</h2>
                    <h3 class="font-heading text-3xl md:text-4xl font-bold text-white mb-6 leading-tight">
                        Public AI tools compromise <br class="hidden md:block" /> your corporate data privacy.
                    </h3>
                    <p class="text-slate-400 leading-relaxed mb-8 text-lg">
                        While off-the-shelf tools like public ChatGPT offer incredible power, pasting sensitive financial data, client records, or proprietary code into them exposes your enterprise to massive security compliance risks and data leakage. 
                    </p>
                    <div class="h-px w-full bg-white/10 my-8"></div>
                    <h2 class="font-heading text-sm font-bold tracking-widest text-purple-400 uppercase mb-4">The ZetaLogix Solution</h2>
                    <p class="text-slate-300 leading-relaxed text-lg">
                        We build entirely private, sovereign AI infrastructure. By utilizing isolated cloud environments, vector databases, and zero-retention enterprise APIs, we allow your team to harness the full power of Large Language Models (LLMs) on your internal data without ever sharing it with the outside world.
                    </p>
                </div>
                <div class="order-1 lg:order-2 relative">
                    <div class="absolute inset-0 bg-gradient-to-tr from-purple-600/20 to-indigo-600/20 rounded-3xl blur-2xl -z-10 translate-x-4 translate-y-4"></div>
                    <div class="bg-[#0a0f1d] border border-white/10 rounded-3xl p-8 shadow-2xl relative z-10">
                        <div class="flex items-center justify-between mb-6 pb-6 border-b border-white/5">
                            <div class="flex items-center gap-3">
                                <div class="w-3 h-3 rounded-full bg-red-500"></div>
                                <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
                                <div class="w-3 h-3 rounded-full bg-green-500"></div>
                            </div>
                            <span class="text-xs font-mono text-slate-500">rag_pipeline.py</span>
                        </div>
                        <pre class="font-mono text-[13px] text-slate-300 overflow-x-auto leading-relaxed"><code><span class="text-purple-400">import</span> torch
<span class="text-purple-400">from</span> langchain.vectorstores <span class="text-purple-400">import</span> Pinecone
<span class="text-purple-400">from</span> langchain.llms <span class="text-purple-400">import</span> PrivateLLM

<span class="text-slate-500"># Initialize strict zero-retention enterprise model</span>
llm = PrivateLLM(
    model_name=<span class="text-orange-300">"llama-3-70b-instruct"</span>,
    deployment=<span class="text-orange-300">"aws_secure_enclave"</span>,
    data_logging=<span class="text-blue-400">False</span>
)

<span class="text-slate-500"># Retrieve proprietary corporate context</span>
vector_db = Pinecone(index_name=<span class="text-orange-300">"internal-docs"</span>)
context = vector_db.similarity_search(user_query)

<span class="text-slate-500"># Generate secure, localized response</span>
response = llm.generate_with_guardrails(
    query=user_query, 
    context=context,
    confidence_threshold=<span class="text-purple-400">0.85</span>
)</code></pre>
                    </div>
                </div>
            </div>
        </section>

        {/* 3. Core Capabilities / Features */}
        <section class="py-24 bg-brand-dark border-y border-white/5">
            <div class="max-w-7xl mx-auto px-6">
                <div class="text-center mb-20 max-w-3xl mx-auto">
                    <h2 class="font-heading text-3xl md:text-4xl font-bold text-white mb-6">AI Engineering Capabilities</h2>
                    <p class="text-slate-400 text-lg">From initial data structuring to deploying intelligent neural networks, we handle the complete AI lifecycle for your enterprise.</p>
                </div>
                
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    {features.map(feature => (
                        <div class="bg-[#0a0f1d] border border-white/5 p-10 rounded-3xl hover:border-purple-500/40 hover:bg-[#0d1425] transition-all duration-500 group">
                            <div class="w-14 h-14 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-purple-400 mb-8 group-hover:scale-110 group-hover:bg-purple-500 group-hover:text-white transition-all duration-300">
                                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={feature.icon} /></svg>
                            </div>
                            <h4 class="font-heading text-xl font-bold text-white mb-4 group-hover:text-purple-400 transition-colors">{feature.title}</h4>
                            <p class="text-slate-400 text-sm leading-relaxed">{feature.desc}</p>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        {/* 4. Structured Tech Stack */}
        <section class="py-24 max-w-7xl mx-auto px-6">
            <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-8">
                <div class="max-w-2xl">
                    <h2 class="font-heading text-3xl md:text-4xl font-bold text-white mb-4">Enterprise AI Stack</h2>
                    <p class="text-slate-400 text-lg">We utilize state-of-the-art machine learning frameworks, vector databases, and scalable cloud infrastructure to power your intelligence.</p>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                {/* ML Frameworks */}
                <div class="p-8 rounded-2xl bg-[#0a0f1d] border border-white/5">
                    <h3 class="text-white font-bold text-lg mb-6 border-b border-white/10 pb-4">ML Frameworks</h3>
                    <ul class="space-y-4">
                        <li class="flex items-center gap-3 text-slate-300"><i class="devicon-pytorch-original colored text-2xl"></i> PyTorch</li>
                        <li class="flex items-center gap-3 text-slate-300"><i class="devicon-tensorflow-original colored text-2xl"></i> TensorFlow</li>
                        <li class="flex items-center gap-3 text-slate-300"><svg class="w-6 h-6 text-yellow-400" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"/><path d="M12 6c-3.31 0-6 2.69-6 6s2.69 6 6 6 6-2.69 6-6-2.69-6-6-6zm0 10c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4z"/></svg> Hugging Face</li>
                        <li class="flex items-center gap-3 text-slate-300"><svg class="w-6 h-6 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" /></svg> LangChain</li>
                    </ul>
                </div>
                {/* Data & Backend */}
                <div class="p-8 rounded-2xl bg-[#0a0f1d] border border-white/5">
                    <h3 class="text-white font-bold text-lg mb-6 border-b border-white/10 pb-4">Data & Backend</h3>
                    <ul class="space-y-4">
                        <li class="flex items-center gap-3 text-slate-300"><i class="devicon-python-plain colored text-2xl"></i> Python</li>
                        <li class="flex items-center gap-3 text-slate-300"><i class="devicon-fastapi-plain colored text-2xl"></i> FastAPI</li>
                        <li class="flex items-center gap-3 text-slate-300"><i class="devicon-pandas-plain colored text-2xl"></i> Pandas / NumPy</li>
                        <li class="flex items-center gap-3 text-slate-300"><i class="devicon-apachespark-original colored text-2xl"></i> Apache Spark</li>
                    </ul>
                </div>
                {/* Vector & DBs */}
                <div class="p-8 rounded-2xl bg-[#0a0f1d] border border-white/5">
                    <h3 class="text-white font-bold text-lg mb-6 border-b border-white/10 pb-4">Vector & DBs</h3>
                    <ul class="space-y-4">
                        <li class="flex items-center gap-3 text-slate-300"><svg class="w-6 h-6 text-purple-400" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg> Pinecone</li>
                        <li class="flex items-center gap-3 text-slate-300"><i class="devicon-postgresql-plain colored text-2xl"></i> pgvector</li>
                        <li class="flex items-center gap-3 text-slate-300"><i class="devicon-mongodb-plain colored text-2xl"></i> MongoDB</li>
                        <li class="flex items-center gap-3 text-slate-300"><i class="devicon-redis-plain colored text-2xl"></i> Redis</li>
                    </ul>
                </div>
                {/* Cloud & MLOps */}
                <div class="p-8 rounded-2xl bg-[#0a0f1d] border border-white/5">
                    <h3 class="text-white font-bold text-lg mb-6 border-b border-white/10 pb-4">Cloud & MLOps</h3>
                    <ul class="space-y-4">
                        <li class="flex items-center gap-3 text-slate-300"><i class="devicon-amazonwebservices-plain-wordmark colored text-3xl"></i> AWS SageMaker</li>
                        <li class="flex items-center gap-3 text-slate-300"><i class="devicon-docker-plain colored text-2xl"></i> Docker</li>
                        <li class="flex items-center gap-3 text-slate-300"><i class="devicon-kubernetes-plain colored text-2xl"></i> Kubernetes</li>
                        <li class="flex items-center gap-3 text-slate-300"><svg class="w-6 h-6 text-yellow-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg> OpenAI / Anthropic</li>
                    </ul>
                </div>
            </div>
        </section>

        {/* 5. Relevant Project Example - AI Integration */}
        <section class="py-24 bg-brand-dark border-y border-white/5">
            <div class="max-w-7xl mx-auto px-6">
                <div class="text-center mb-16">
                    <h2 class="font-heading text-sm font-bold tracking-widest text-purple-400 uppercase mb-3">Case Study Integration</h2>
                    <h3 class="font-heading text-3xl md:text-4xl font-bold text-white mb-4">AI-Driven <span class="text-purple-400">Fintech Intelligence.</span></h3>
                </div>
                
                <div class="bg-[#0a0f1d] border border-white/5 rounded-[2.5rem] p-8 md:p-12 shadow-2xl grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
                    <div class="order-2 lg:order-1">
                        <div class="flex items-center gap-3 text-xs font-bold uppercase tracking-wider mb-6">
                            <span class="text-purple-400">Machine Learning</span>
                            <span class="text-slate-600">•</span>
                            <span class="text-slate-400">Fraud Detection</span>
                        </div>
                        <h4 class="font-heading text-3xl lg:text-4xl font-bold text-white mb-6">Litetrade AI Integration</h4>
                        <p class="text-slate-400 text-lg leading-relaxed mb-8">
                            We engineered an automated Machine Learning pipeline for Litetrade's mobile transaction network. The model analyzes historical trading velocity and user behavior in real-time to flag fraudulent transactions instantly, reducing manual KYC overhead and protecting digital assets without compromising the user experience.
                        </p>
                        <div class="flex flex-wrap gap-3 mb-10">
                            <span class="px-3 py-1 rounded bg-white/5 border border-white/10 text-xs text-slate-300 font-mono">Python</span>
                            <span class="px-3 py-1 rounded bg-white/5 border border-white/10 text-xs text-slate-300 font-mono">TensorFlow</span>
                            <span class="px-3 py-1 rounded bg-white/5 border border-white/10 text-xs text-slate-300 font-mono">AWS SageMaker</span>
                        </div>
                        <a href="/portfolio/litetrade" class="inline-flex px-8 py-4 bg-purple-600 text-white font-bold rounded-full hover:bg-white hover:text-purple-900 transition-all shadow-lg hover:shadow-purple-500/25">
                            View Base Project
                        </a>
                    </div>
                    <div class="order-1 lg:order-2 flex justify-center items-center">
                        <div class="relative w-full max-w-[280px] aspect-[9/19] rounded-[2.5rem] overflow-hidden border-[8px] border-[#1e293b] shadow-[0_0_50px_rgba(168,85,247,0.15)] bg-[#020617] transform hover:-translate-y-2 transition-transform duration-500">
                            <div class="absolute top-0 left-1/2 -translate-x-1/2 w-1/2 h-5 bg-[#1e293b] rounded-b-2xl z-20"></div>
                            {/* Overlaying a purple grid to simulate AI tracking on top of the app */}
                            <div class="absolute inset-0 bg-purple-500/10 mix-blend-overlay z-10 pointer-events-none border border-purple-500/30 rounded-[2rem] grid grid-cols-4 grid-rows-8">
                                <div class="col-start-2 row-start-3 border border-purple-400/50 bg-purple-400/20 animate-pulse"></div>
                                <div class="col-start-3 row-start-6 border border-purple-400/50 bg-purple-400/20 animate-pulse delay-75"></div>
                            </div>
                            <img src="/assets/Litetrade.webp" alt="Litetrade AI Implementation" class="w-full h-full object-cover object-top" loading="lazy" />
                        </div>
                    </div>
                </div>
            </div>
        </section>

        {/* 6. Development Process - Bulletproof Responsive Timeline */}
        <section class="py-24 max-w-5xl mx-auto px-6">
            <h2 class="font-heading text-3xl md:text-4xl font-bold text-white mb-16 text-center">Our AI Engineering Pipeline</h2>
            
            <div class="relative max-w-4xl mx-auto">
                <div class="absolute left-[28px] md:left-1/2 top-0 bottom-0 w-0.5 bg-gradient-to-b from-purple-500 via-purple-500/30 to-transparent md:-translate-x-1/2"></div>
                
                <div class="space-y-12">
                    {pipeline.map((item, index) => (
                        <div class="relative flex flex-col md:flex-row items-start md:items-center justify-between w-full group">
                            
                            <div class={`absolute left-0 md:left-1/2 top-0 md:top-1/2 w-14 h-14 rounded-full border-4 border-[#02040a] font-bold flex items-center justify-center z-10 md:-translate-x-1/2 md:-translate-y-1/2 transition-colors duration-300 ${item.active ? 'bg-purple-500 text-white shadow-[0_0_20px_rgba(168,85,247,0.4)]' : 'bg-[#1e293b] text-white group-hover:bg-purple-500/50'}`}>
                                {item.step}
                            </div>
                            
                            {index % 2 === 0 ? (
                                <>
                                    <div class="w-full pl-20 md:pl-0 md:w-[calc(50%-3rem)] md:text-right md:pr-8">
                                        <div class={`p-8 rounded-3xl bg-[#0a0f1d] border shadow-xl transition-colors duration-300 text-left md:text-right ${item.active ? 'border-purple-500/40' : 'border-white/5 group-hover:border-white/20'}`}>
                                            <h4 class="font-heading text-xl font-bold text-white mb-3">{item.title}</h4>
                                            <p class="text-base text-slate-400 leading-relaxed">{item.desc}</p>
                                        </div>
                                    </div>
                                    <div class="hidden md:block md:w-[calc(50%-3rem)]"></div>
                                </>
                            ) : (
                                <>
                                    <div class="hidden md:block md:w-[calc(50%-3rem)]"></div>
                                    <div class="w-full pl-20 md:pl-0 md:w-[calc(50%-3rem)] md:pl-8 mt-2 md:mt-0">
                                        <div class={`p-8 rounded-3xl bg-[#0a0f1d] border shadow-xl transition-colors duration-300 text-left ${item.active ? 'border-purple-500/40' : 'border-white/5 group-hover:border-white/20'}`}>
                                            <h4 class="font-heading text-xl font-bold text-white mb-3">{item.title}</h4>
                                            <p class="text-base text-slate-400 leading-relaxed">{item.desc}</p>
                                        </div>
                                    </div>
                                </>
                            )}
                        </div>
                    ))}
                </div>
            </div>
        </section>

        {/* 7. Comprehensive FAQs - Smooth Accordion */}
        <section class="py-24 bg-brand-dark border-t border-white/5">
            <div class="max-w-4xl mx-auto px-6">
                <div class="text-center mb-16">
                    <h2 class="font-heading text-3xl md:text-4xl font-bold text-white mb-4">Frequently Asked Questions</h2>
                    <p class="text-slate-400 text-lg">Clear answers regarding data privacy and AI implementation.</p>
                </div>
                
                <div class="space-y-4">
                    {faqs.map((faq, index) => (
                        <div class="faq-item bg-[#0a0f1d] border border-white/5 rounded-2xl overflow-hidden transition-colors hover:border-white/10">
                            <button class="faq-button w-full px-8 py-6 flex items-center justify-between text-left focus:outline-none focus-visible:bg-white/5" aria-expanded="false">
                                <h4 class="font-bold text-white text-lg pr-8 leading-snug">{faq.q}</h4>
                                <div class="shrink-0 relative w-6 h-6 text-purple-400">
                                    <svg class="absolute inset-0 w-6 h-6 transform transition-transform duration-300 icon-vertical" fill="currentColor" viewBox="0 0 24 24"><rect x="11" y="4" width="2" height="16" rx="1"/></svg>
                                    <svg class="absolute inset-0 w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><rect x="4" y="11" width="16" height="2" rx="1"/></svg>
                                </div>
                            </button>
                            <div class="faq-content grid transition-all duration-300">
                                <div class="overflow-hidden">
                                    <p class="text-slate-400 leading-relaxed px-8 pb-6">
                                        {faq.a}
                                    </p>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        {/* 8. Call to Action */}
        <Cta />

    </main>

    <Footer />
</BaseLayout>

<style>
    .faq-content {
        grid-template-rows: 0fr;
    }
    .faq-item.is-open .faq-content {
        grid-template-rows: 1fr;
    }
    .faq-item.is-open .icon-vertical {
        transform: rotate(90deg) scaleY(0);
        opacity: 0;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const faqItems = document.querySelectorAll('.faq-item');
        
        faqItems.forEach(item => {
            const button = item.querySelector('.faq-button');
            if (button) {
                button.addEventListener('click', () => {
                    const isOpen = item.classList.contains('is-open');
                    
                    faqItems.forEach(i => {
                        i.classList.remove('is-open');
                        i.querySelector('.faq-button')?.setAttribute('aria-expanded', 'false');
                    });

                    if (!isOpen) {
                        item.classList.add('is-open');
                        button.setAttribute('aria-expanded', 'true');
                    }
                });
            }
        });
    });
</script>