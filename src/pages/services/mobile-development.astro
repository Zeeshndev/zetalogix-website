---
// src/pages/services/mobile-development.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/global/Navbar.astro';
import TrustBar from '../../components/sections/TrustBar.astro';
import ContactForm from '../../components/sections/ContactForm.astro';
import BottomBanner from '../../components/sections/BottomBanner.astro';
import Footer from '../../components/global/Footer.astro';

// 1. Mobile Sub-Services Data
const mobileServices = [
    {
        title: "Native iOS Development",
        description: "High-performance applications built specifically for the Apple ecosystem using Swift and UIKit/SwiftUI, ensuring flawless execution.",
        icon: "M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" // Smartphone
    },
    {
        title: "Native Android Development",
        description: "Robust, secure Android applications engineered with Kotlin and Jetpack Compose, fully optimized for a vast array of global devices.",
        icon: "M10.5a1.5 1.5 0 113 0 1.5 1.5 0 01-3 0zm4.5 4.5a1.5 1.5 0 113 0 1.5 1.5 0 01-3 0zm-9 0a1.5 1.5 0 113 0 1.5 1.5 0 01-3 0z" // Android nodes alternative
    },
    {
        title: "Cross-Platform Apps",
        description: "Maximize your reach and minimize costs with cross-platform frameworks like React Native and Flutter, sharing a single codebase with near-native speed.",
        icon: "M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" // Loop arrows
    },
    {
        title: "Mobile Commerce & FinTech",
        description: "Secure mobile payment systems integrated with Stripe, Apple Pay, Google Pay, and encrypted multi-factor transaction setups.",
        icon: "M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" // Credit card
    },
    {
        title: "API Integration & Backend",
        description: "We engineer lightning-fast Node.js and Python RESTful/GraphQL APIs to power your mobile app's synchronous cloud features.",
        icon: "M11 4a2 2 0 114 0v1a2 2 0 11-4 0V4zm-6 8a2 2 0 114 0v1a2 2 0 11-4 0v-1zm12 0a2 2 0 114 0v1a2 2 0 11-4 0v-1z" // API tree
    },
    {
        title: "App Store Optimization (ASO)",
        description: "End-to-end guidance through strict Apple App Store and Google Play compliance review gates, alongside search rank optimization.",
        icon: "M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" // Verified check
    }
];

// 2. Specific Tech Stack for Mobile
const mobileTech = [
  { name: "Swift", icon: "devicon-swift-plain colored" },
  { name: "Kotlin", icon: "devicon-kotlin-plain colored" },
  { name: "Flutter", icon: "devicon-flutter-plain colored" },
  { name: "React Native", icon: "devicon-react-original colored" },
  { name: "Firebase", icon: "devicon-firebase-plain colored" },
  { name: "Node.js", icon: "devicon-nodejs-plain colored" },
  { name: "Apple", icon: "devicon-apple-original text-white" }
];

// 3. Mobile Specific FAQs
const faqs = [
  {
    q: "Should I build a Native app or a Cross-Platform application?",
    a: "It depends entirely on your product goals. Native apps (Swift/Kotlin) are best for high-performance graphics, 3D games, or complex hardware integrations. Cross-platform apps (React Native/Flutter) are perfect for 90% of business apps and startups, allowing you to deploy to both iOS and Android simultaneously using a single, cost-effective codebase."
  },
  {
    q: "How do you handle App Store and Google Play submissions?",
    a: "We take care of the entire deployment procedure. We package the binaries, configure the metadata, assets, and privacy policies, and submit the builds directly into your corporate developer consoles, guiding them cleanly through Apple and Google's strict validation reviews."
  },
  {
    q: "Can your mobile applications function offline?",
    a: "Yes. We architect apps with local offline caching layers utilizing SQLite or Realm databases. When a user loses internet connectivity, the application continues to run seamlessly, queuing background synchronization tasks that deploy the moment connection is re-established."
  },
  {
    q: "How do you ensure application security and user data protection?",
    a: "We follow industry-best security guidelines, including end-to-end SSL pinning, biometric authentication integration (FaceID/Fingerprint), secure storage keys for sensitive JWT tokens, and strict obfuscation protocols on compilation to block reverse-engineering attempts."
  }
];
---

<BaseLayout title="Mobile App Development Company | ZetaLogix">
    <Navbar />
    
    <main class="pt-20">
        
        <section class="relative pt-20 pb-32 overflow-hidden bg-brand-dark">
            <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-brand-accent/10 blur-[120px] rounded-full pointer-events-none"></div>
            <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-blue-600/10 blur-[100px] rounded-full pointer-events-none"></div>
            
            <div class="max-w-7xl mx-auto px-6 relative z-10 grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
                <div>
                    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-brand-accent/10 border border-brand-accent/20 text-brand-accent text-sm font-bold tracking-wide uppercase mb-6">
                        <span class="w-2 h-2 rounded-full bg-brand-accent animate-pulse"></span>
                        iOS & Android Architecture
                    </div>
                    <h1 class="font-heading text-5xl md:text-6xl font-bold text-white leading-[1.1] mb-6">
                        Mobile App <span class="text-brand-accent">Development Company</span>
                    </h1>
                    <p class="text-slate-400 text-lg md:text-xl leading-relaxed mb-8 max-w-xl">
                        We build high-performance, fluid mobile applications native to iOS and Android that engage millions of users and scale gracefully.
                    </p>
                    <div class="flex flex-col sm:flex-row gap-4">
                        <a href="#contact" class="px-8 py-4 bg-brand-accent text-brand-dark font-bold rounded-lg hover:bg-white transition-colors duration-300 text-center shadow-[0_0_20px_rgba(34,211,238,0.2)]">
                            Get a Free Quote
                        </a>
                        <a href="#process" class="px-8 py-4 bg-transparent border border-white/20 text-white font-bold rounded-lg hover:bg-white/5 transition-colors duration-300 text-center">
                            Our Process
                        </a>
                    </div>
                </div>
                
                <div class="relative flex justify-center">
                    <div class="absolute inset-0 bg-gradient-to-tr from-brand-dark via-transparent to-transparent z-10 rounded-2xl"></div>
                    <img 
                        src="https://images.unsplash.com/photo-1512941937669-90a1b58e7e9c?q=80&w=1000&auto=format&fit=crop" 
                        alt="Mobile UI/UX Showcase" 
                        class="rounded-3xl border border-white/10 shadow-2xl max-h-[500px] object-cover transform lg:rotate-2 hover:rotate-0 transition-transform duration-700"
                    />
                    
                    <div class="absolute -bottom-6 -right-6 bg-[#0a0f1d] border border-white/10 rounded-xl p-4 shadow-xl flex items-center gap-4 z-20 animate-bounce-slow">
                        <i class="devicon-flutter-plain colored text-4xl"></i>
                        <div>
                            <p class="text-white font-bold text-sm">Flutter / Dart</p>
                            <p class="text-slate-500 text-xs">Single Engine Runtime</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <TrustBar />

        <section class="py-24 bg-brand-dark relative border-t border-white/5">
            <div class="max-w-7xl mx-auto px-6">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
                    <div>
                        <h2 class="font-heading text-sm font-bold tracking-widest text-brand-glow uppercase mb-3">Technical Ecosystem</h2>
                        <h3 class="font-heading text-3xl md:text-4xl font-bold text-white mb-6">
                            What is Modern <span class="text-brand-accent">Mobile Engineering?</span>
                        </h3>
                        <p class="text-slate-400 leading-relaxed mb-6 text-lg">
                            Mobile application engineering has evolved far beyond simple web wraps. Today, building a premium application requires native threading performance, advanced lifecycle runtime management, and responsive local caching architectures.
                        </p>
                        <p class="text-slate-400 leading-relaxed text-lg">
                            Whether operating natively via Swift and Kotlin or sharing unified UI engines like Flutter and React Native, a successful application demands strict device security compliance, asynchronous hardware tracking (GPS, camera layers), and secure offline data capabilities.
                        </p>
                    </div>

                    <div class="bg-gradient-to-br from-[#0a0f1d] to-[#0f172a] border border-white/10 rounded-2xl p-8 md:p-10 shadow-2xl">
                        <h3 class="font-heading text-2xl font-bold text-white mb-4">About Our Mobile Strategy</h3>
                        <p class="text-slate-400 leading-relaxed mb-8">
                            ZetaLogix builds elite mobile products designed for human engagement. We carefully audit your targeted audience demographics, security specifications, and hardware needs before specifying an engineering roadmap.
                        </p>
                        
                        <ul class="space-y-4">
                            <li class="flex items-start gap-4">
                                <div class="w-6 h-6 rounded-full bg-brand-accent/20 flex items-center justify-center shrink-0 mt-1">
                                    <svg class="w-3.5 h-3.5 text-brand-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                                </div>
                                <span class="text-slate-300 font-medium">Native Fluid 60FPS UI Interaction Rendering</span>
                            </li>
                            <li class="flex items-start gap-4">
                                <div class="w-6 h-6 rounded-full bg-brand-accent/20 flex items-center justify-center shrink-0 mt-1">
                                    <svg class="w-3.5 h-3.5 text-brand-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                                </div>
                                <span class="text-slate-300 font-medium">Encrypted Hardware Storage & Biometrics Integration</span>
                            </li>
                            <li class="flex items-start gap-4">
                                <div class="w-6 h-6 rounded-full bg-brand-accent/20 flex items-center justify-center shrink-0 mt-1">
                                    <svg class="w-3.5 h-3.5 text-brand-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                                </div>
                                <span class="text-slate-300 font-medium">Robust Offline SQLite/Realm Caching Systems</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </section>

        <section class="py-24 bg-[#050814] relative border-t border-white/5">
            <div class="max-w-7xl mx-auto px-6">
                
                <div class="text-center max-w-3xl mx-auto mb-20">
                    <h2 class="font-heading text-sm font-bold tracking-widest text-brand-glow uppercase mb-3">Capabilities</h2>
                    <h3 class="font-heading text-4xl md:text-5xl font-bold text-white mb-6">
                        Mobile App <span class="text-brand-accent">Specializations</span>
                    </h3>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    {mobileServices.map(service => (
                        <div class="bg-[#0a0f1d] border border-white/5 rounded-2xl p-8 hover:border-brand-accent/50 hover:-translate-y-2 transition-all duration-300 group shadow-lg">
                            <div class="w-14 h-14 rounded-xl bg-brand-accent/10 flex items-center justify-center mb-6 group-hover:bg-brand-accent transition-colors duration-300">
                                <svg class="w-7 h-7 text-brand-accent group-hover:text-[#0a0f1d] transition-colors duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={service.icon} />
                                </svg>
                            </div>
                            <h4 class="text-xl font-bold text-white mb-4 font-heading">{service.title}</h4>
                            <p class="text-slate-400 leading-relaxed text-sm">{service.description}</p>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <section class="py-24 bg-brand-dark relative border-t border-white/5">
            <div class="max-w-7xl mx-auto px-6">
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-center">
                    <div class="lg:col-span-6 order-2 lg:order-1">
                        <div class="relative rounded-2xl overflow-hidden border border-white/10 shadow-2xl flex justify-center bg-black/20 p-8">
                            <img src="https://images.unsplash.com/photo-1511707171634-5f897ff02aa9?q=80&w=1000&auto=format&fit=crop" alt="Mobile App Mockup" class="max-h-[450px] object-cover rounded-3xl" />
                        </div>
                    </div>
                    <div class="lg:col-span-6 order-1 lg:order-2">
                        <h2 class="font-heading text-sm font-bold tracking-widest text-brand-glow uppercase mb-3">Featured Case Study</h2>
                        <h3 class="font-heading text-3xl md:text-4xl font-bold text-white mb-6">
                            FitTrack Pro: A Cross-Platform <span class="text-brand-accent">Fitness Ecosystem</span>
                        </h3>
                        <p class="text-slate-400 mb-6 leading-relaxed">
                            We designed and engineered a massive, cross-platform health application tracking synchronous biometrics data, offline state metrics caching, and background audio streaming loops without native runtime thread delay.
                        </p>
                        <div class="grid grid-cols-3 gap-6 border-t border-white/5 pt-6">
                            <div>
                                <h4 class="text-brand-accent text-2xl font-bold font-heading">4.9 ★</h4>
                                <p class="text-slate-500 text-xs uppercase tracking-wider font-semibold mt-1">App Store Rating</p>
                            </div>
                            <div>
                                <h4 class="text-brand-accent text-2xl font-bold font-heading">2M+</h4>
                                <p class="text-slate-500 text-xs uppercase tracking-wider font-semibold mt-1">Active Downloads</p>
                            </div>
                            <div>
                                <h4 class="text-brand-accent text-2xl font-bold font-heading">&lt; 16ms</h4>
                                <p class="text-slate-500 text-xs uppercase tracking-wider font-semibold mt-1">Frame Interval</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="py-24 bg-[#050814] relative border-t border-white/5">
            <div class="max-w-7xl mx-auto px-6">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
                    <div>
                        <h2 class="font-heading text-3xl md:text-4xl font-bold text-white mb-6 leading-tight">
                            Engineered for <span class="text-brand-accent">App Store Success</span>
                        </h2>
                        <ul class="space-y-6">
                            <li class="flex gap-4">
                                <div class="w-6 h-6 rounded-full bg-brand-accent/20 flex items-center justify-center shrink-0 mt-1">
                                    <span class="w-2 h-2 rounded-full bg-brand-accent"></span>
                                </div>
                                <div>
                                    <h4 class="text-white font-bold mb-1">Human-Centered Prototyping</h4>
                                    <p class="text-slate-500 text-sm">We construct functional interactive wireframes first to eliminate interaction anomalies and ensure perfect spatial usability guidelines before coding.</p>
                                </div>
                            </li>
                            <li class="flex gap-4">
                                <div class="w-6 h-6 rounded-full bg-brand-accent/20 flex items-center justify-center shrink-0 mt-1">
                                    <span class="w-2 h-2 rounded-full bg-brand-accent"></span>
                                </div>
                                <div>
                                    <h4 class="text-white font-bold mb-1">Rigorous Automated Device Testing</h4>
                                    <p class="text-slate-500 text-sm">Every compilation runs safely through multi-device screen test architectures to verify system visual integrity under extreme constraints.</p>
                                </div>
                            </li>
                        </ul>
                    </div>

                    <div class="relative">
                        <div class="bg-[#0f172a] border border-white/10 rounded-2xl p-6 shadow-2xl overflow-hidden">
                            <div class="flex items-center gap-2 mb-6 border-b border-white/5 pb-4">
                                <div class="w-3 h-3 rounded-full bg-red-500"></div>
                                <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
                                <div class="w-3 h-3 rounded-full bg-green-500"></div>
                                <span class="ml-4 text-xs font-mono text-slate-500">App.tsx</span>
                            </div>
                            <pre is:raw class="text-sm font-mono text-slate-300 overflow-x-auto"><code class="language-tsx">
import React from 'react';
import { SecureStorage, DeviceBiometrics } from 'zetalogix-mobile';

export default function MobileSecureApp() {
  const initializeSecureSession = async () => {
    const isAuthentic = await DeviceBiometrics.verifyUser();
    if (isAuthentic) {
      const token = await SecureStorage.getSecretKey("session_jwt");
      console.log("🔒 Encrypted Session Fully Synchronized");
    }
  };

  return (
    &lt;SecureViewport onLoad={initializeSecureSession} /&gt;
  );
}
                            </code></pre>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="py-20 bg-brand-dark relative border-t border-white/5 text-center">
            <div class="max-w-7xl mx-auto px-6">
                <h3 class="font-heading text-2xl font-bold text-white mb-10">Our Core Mobile Engineering Ecosystem</h3>
                <div class="flex flex-wrap justify-center items-center gap-8 md:gap-16">
                    {mobileTech.map(tech => (
                        <div class="flex flex-col items-center gap-3 opacity-70 hover:opacity-100 hover:scale-110 transition-all duration-300 cursor-pointer" title={tech.name}>
                            <i class={`${tech.icon} text-5xl md:text-6xl`}></i>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <section id="process" class="py-24 bg-[#050814] relative border-t border-white/5">
            <div class="max-w-7xl mx-auto px-6">
                <div class="text-center mb-16">
                    <h2 class="font-heading text-4xl font-bold text-white mb-4">Our Development Timeline</h2>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
                    <div class="bg-[#0a0f1d] border border-white/5 rounded-2xl p-8 relative">
                        <span class="absolute -top-4 -left-4 w-10 h-10 bg-brand-dark border border-white/10 rounded-full flex items-center justify-center text-brand-accent font-bold font-heading shadow-lg z-10">1</span>
                        <h4 class="text-white font-bold mb-2">Technical Framing</h4>
                        <p class="text-slate-500 text-sm">Defining deployment scope, hardware sensor needs, and architecture logic constraints.</p>
                    </div>
                    <div class="bg-[#0a0f1d] border border-white/5 rounded-2xl p-8 relative">
                        <span class="absolute -top-4 -left-4 w-10 h-10 bg-brand-dark border border-white/10 rounded-full flex items-center justify-center text-brand-accent font-bold font-heading shadow-lg z-10">2</span>
                        <h4 class="text-white font-bold mb-2">Spatial Architecture</h4>
                        <p class="text-slate-500 text-sm">Building mobile interactive prototypes focused entirely on thumb-zone usability standards.</p>
                    </div>
                    <div class="bg-gradient-to-b from-[#0f172a] to-[#0a0f1d] border border-brand-accent/30 rounded-2xl p-8 relative">
                        <span class="absolute -top-4 -left-4 w-10 h-10 bg-brand-accent text-[#0a0f1d] rounded-full flex items-center justify-center font-bold font-heading shadow-lg z-10 animate-pulse">3</span>
                        <h4 class="text-white font-bold mb-2">Agile Sprints</h4>
                        <p class="text-slate-400 text-sm">Writing code across parallel workflows, integrating secure database frameworks, and hooking up APIs.</p>
                    </div>
                    <div class="bg-[#0a0f1d] border border-white/5 rounded-2xl p-8 relative">
                        <span class="absolute -top-4 -left-4 w-10 h-10 bg-brand-dark border border-white/10 rounded-full flex items-center justify-center text-brand-accent font-bold font-heading shadow-lg z-10">4</span>
                        <h4 class="text-white font-bold mb-2">Store Launch</h4>
                        <p class="text-slate-500 text-sm">Executing strict end-to-end sandbox tests, compiling production keys, and running store review gates.</p>
                    </div>
                </div>
            </div>
        </section>

        <section class="py-24 bg-brand-dark relative border-t border-white/5">
            <div class="max-w-4xl mx-auto px-6">
                <div class="text-center mb-16">
                    <h2 class="font-heading text-sm font-bold tracking-widest text-brand-glow uppercase mb-3">FAQ</h2>
                    <h3 class="font-heading text-3xl md:text-4xl font-bold text-white">Common Mobile Inquiries</h3>
                </div>

                <div class="flex flex-col gap-4">
                    {faqs.map((faq) => (
                        <div class="bg-[#0a0f1d] border border-white/5 rounded-xl overflow-hidden transition-colors duration-300 faq-item">
                            <button type="button" class="w-full px-6 py-5 text-left flex items-center justify-between font-heading text-lg font-bold text-white focus:outline-none faq-btn">
                                <span>{faq.q}</span>
                                <svg class="w-4 h-4 text-slate-400 transition-transform duration-300 faq-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
                            </button>
                            <div class="max-h-0 overflow-hidden transition-all duration-300 ease-in-out faq-content">
                                <p class="px-6 pb-6 text-slate-400 text-sm md:text-base leading-relaxed border-t border-white/5 pt-4 bg-white/[0.01]">
                                    {faq.a}
                                </p>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <ContactForm />

    </main>

    <BottomBanner />
    <Footer />
</BaseLayout>

<style>
    .animate-bounce-slow { animation: bounce 3s infinite; }
    @keyframes bounce { 0%, 100% { transform: translateY(-5%); } 50% { transform: translateY(5%); } }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const faqItems = document.querySelectorAll('.faq-item');

        faqItems.forEach(item => {
            const btn = item.querySelector('.faq-btn');
            const content = item.querySelector('.faq-content');
            const icon = item.querySelector('.faq-icon');

            if (btn && content && icon) {
                btn.addEventListener('click', () => {
                    const isOpen = content.style.maxHeight && content.style.maxHeight !== '0px';

                    // Close all other open accordion rows
                    document.querySelectorAll('.faq-content').forEach(c => (c as HTMLElement).style.maxHeight = '0px');
                    document.querySelectorAll('.faq-icon').forEach(i => i.classList.remove('rotate-180'));
                    document.querySelectorAll('.faq-item').forEach(wrapper => wrapper.classList.remove('border-brand-accent/30'));

                    if (!isOpen) {
                        (content as HTMLElement).style.maxHeight = content.scrollHeight + 'px';
                        icon.classList.add('rotate-180');
                        item.classList.add('border-brand-accent/30');
                    }
                });
            }
        });
    });
</script>