---
// src/pages/services/mobile-development.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/global/Navbar.astro';
import Footer from '../../components/global/Footer.astro';
import Cta from '../../components/sections/Cta.astro';

const features = [
  { 
    title: "Native iOS & Android", 
    desc: "Uncompromising performance and seamless hardware integration utilizing Swift for iOS and Kotlin for Android to deliver the ultimate user experience.",
    icon: "M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"
  },
  { 
    title: "Cross-Platform Apps", 
    desc: "Accelerate your time-to-market and reduce engineering costs with highly optimized React Native and Flutter frameworks that run flawlessly on both platforms.",
    icon: "M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"
  },
  { 
    title: "Mobile Commerce", 
    desc: "Secure, high-conversion mobile storefronts featuring one-tap checkouts, Apple Pay/Google Wallet integrations, and real-time inventory synchronization.",
    icon: "M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"
  },
  { 
    title: "IoT & Hardware Integration", 
    desc: "We connect your mobile applications to the physical world, utilizing Bluetooth Low Energy (BLE), NFC, and custom hardware APIs for smart devices.",
    icon: "M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"
  },
  { 
    title: "Enterprise Mobility", 
    desc: "Secure internal applications that empower your workforce, featuring offline-first capabilities, MDM compatibility, and end-to-end data encryption.",
    icon: "M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
  },
  { 
    title: "App Store Deployment", 
    desc: "We handle the entire submission process, ensuring your application strictly complies with Apple App Store and Google Play guidelines for rapid approval.",
    icon: "M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"
  }
];

const pipeline = [
  {
    step: 1,
    title: "Discovery & UX Strategy",
    desc: "We map out user journeys, define the technical requirements, and determine whether a native or cross-platform architecture best suits your business goals.",
    active: true
  },
  {
    step: 2,
    title: "Interface Prototyping",
    desc: "Interactive, mobile-first wireframes are crafted to ensure fluid navigation, perfect touch targets, and strict adherence to iOS Human Interface and Material Design guidelines.",
    active: false
  },
  {
    step: 3,
    title: "Agile Development",
    desc: "Our engineers build the application in focused sprints, integrating secure back-end APIs, local device storage, and offline-sync capabilities.",
    active: false
  },
  {
    step: 4,
    title: "Testing & Store Launch",
    desc: "Following rigorous QA testing across multiple physical devices and screen sizes, we manage the seamless deployment of your app to the App Store and Google Play.",
    active: false
  }
];

const faqs = [
  { 
    q: "Should I choose Native or Cross-Platform (React Native) development?", 
    a: "It depends on your product. Cross-platform frameworks like React Native save time and budget by sharing one codebase across iOS and Android, which is perfect for most business apps and marketplaces. Native development (Swift/Kotlin) is recommended if your app relies heavily on intense 3D graphics, complex animations, or highly specific device hardware capabilities." 
  },
  { 
    q: "Will my mobile app work offline?", 
    a: "Yes, if required. We can engineer 'offline-first' architectures using local databases (like SQLite or Realm) that sync automatically with your cloud servers the moment a network connection is restored." 
  },
  { 
    q: "Do you assist with App Store and Google Play approval?", 
    a: "Absolutely. App Store rejections can delay launches for weeks. We build your app in strict compliance with Apple and Google's guidelines, handle the developer account setups, manage the certificate provisioning, and oversee the entire review process until your app is live." 
  },
  { 
    q: "How do you handle app updates and new OS versions?", 
    a: "Through our post-launch maintenance SLAs, we actively monitor your application for performance issues, push over-the-air updates for minor bug fixes, and ensure your app remains fully compatible whenever Apple or Google releases a major OS update." 
  }
];
---

<BaseLayout 
    title="Mobile Application Development | ZetaLogix"
    description="ZetaLogix engineers premium native iOS, Android, and cross-platform mobile applications that deliver flawless user experiences and scale globally."
>
    <Navbar />

    <main class="relative z-10 bg-[#02040a]">
        
        {/* 1. Hero Section - Classic & Authoritative */}
        <section class="relative pt-40 pb-24 lg:pt-48 lg:pb-32 overflow-hidden border-b border-white/5">
            <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[600px] bg-emerald-500/10 rounded-full blur-[150px] -z-10 pointer-events-none"></div>
            <div class="absolute inset-0 opacity-[0.02] bg-[radial-gradient(#ffffff_1px,transparent_1px)] [background-size:32px_32px] pointer-events-none z-0"></div>

            <div class="max-w-7xl mx-auto px-6 text-center relative z-10">
                <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/5 border border-white/10 mb-8 backdrop-blur-sm">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    <span class="text-xs font-bold text-slate-300 uppercase tracking-widest">Mobile Engineering</span>
                </div>
                
                <h1 class="font-heading text-5xl md:text-6xl lg:text-7xl font-bold text-white tracking-tight mb-8 leading-tight max-w-5xl mx-auto">
                    Flawless <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-brand-accent">Mobile Experiences</span><br class="hidden md:block" /> Engineered to Convert.
                </h1>
                
                <p class="text-xl text-slate-400 max-w-3xl mx-auto leading-relaxed mb-12">
                    We architect native and cross-platform mobile applications that combine striking user interfaces with robust backend infrastructure for iOS and Android.
                </p>

                <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
                    <a href="/contact" class="w-full sm:w-auto px-8 py-4 bg-brand-accent text-brand-dark font-bold rounded-full hover:bg-white transition-all duration-300 shadow-lg hover:shadow-brand-accent/20">
                        Discuss Your Mobile App
                    </a>
                    <a href="#architecture" class="w-full sm:w-auto px-8 py-4 bg-transparent text-white font-semibold rounded-full border border-white/20 hover:bg-white/10 transition-all duration-300">
                        Explore Capabilities
                    </a>
                </div>
            </div>
        </section>

        {/* 2. Business Problem & Solution */}
        <section id="architecture" class="py-24 lg:py-32 max-w-7xl mx-auto px-6">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
                <div class="order-2 lg:order-1">
                    <h2 class="font-heading text-sm font-bold tracking-widest text-slate-500 uppercase mb-4">The Challenge</h2>
                    <h3 class="font-heading text-3xl md:text-4xl font-bold text-white mb-6 leading-tight">
                        Poor mobile performance <br class="hidden md:block" /> destroys user retention.
                    </h3>
                    <p class="text-slate-400 leading-relaxed mb-8 text-lg">
                        In the mobile ecosystem, users have zero tolerance for lag, battery drain, or confusing interfaces. Applications built on poor architecture suffer from high uninstall rates, negative store reviews, and ultimately, a catastrophic loss of revenue.
                    </p>
                    <div class="h-px w-full bg-white/10 my-8"></div>
                    <h2 class="font-heading text-sm font-bold tracking-widest text-brand-accent uppercase mb-4">The ZetaLogix Solution</h2>
                    <p class="text-slate-300 leading-relaxed text-lg">
                        We engineer mobile applications that feel instantly responsive. Whether deploying a pure native build or leveraging React Native, we strictly adhere to platform-specific design guidelines, optimize memory usage, and build resilient offline architectures so your app works flawlessly under any condition.
                    </p>
                </div>
                <div class="order-1 lg:order-2 relative">
                    <div class="absolute inset-0 bg-gradient-to-tr from-emerald-500/20 to-brand-accent/20 rounded-3xl blur-2xl -z-10 translate-x-4 translate-y-4"></div>
                    <div class="bg-[#0a0f1d] border border-white/10 rounded-3xl p-8 shadow-2xl relative z-10">
                        <div class="flex items-center gap-3 mb-6 pb-6 border-b border-white/5">
                            <div class="w-3 h-3 rounded-full bg-red-500"></div>
                            <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
                            <div class="w-3 h-3 rounded-full bg-green-500"></div>
                        </div>
                        <pre class="font-mono text-sm text-slate-300 overflow-x-auto"><code><span class="text-brand-accent">import</span> &#123; NativeCore &#125; <span class="text-brand-accent">from</span> '@zetalogix/mobile';

<span class="text-emerald-400">const</span> MobileApplication = () => &#123;
  <span class="text-brand-accent">return</span> (
    &lt;<span class="text-green-400">AppArchitecture</span>
      platform=&#123;<span class="text-orange-300">"iOS_and_Android"</span>&#125;
      fps=&#123;<span class="text-purple-400">60</span>&#125;
      offlineMode=&#123;<span class="text-blue-400">true</span>&#125;
    &gt;
      &lt;<span class="text-green-400">SecureBiometrics</span> /&gt;
      &lt;<span class="text-green-400">RealTimeSync</span> /&gt;
    &lt;/<span class="text-green-400">AppArchitecture</span>&gt;
  );
&#125;;</code></pre>
                    </div>
                </div>
            </div>
        </section>

        {/* 3. Core Capabilities / Features */}
        <section class="py-24 bg-brand-dark border-y border-white/5">
            <div class="max-w-7xl mx-auto px-6">
                <div class="text-center mb-20 max-w-3xl mx-auto">
                    <h2 class="font-heading text-3xl md:text-4xl font-bold text-white mb-6">Mobile Engineering Capabilities</h2>
                    <p class="text-slate-400 text-lg">We deliver end-to-end mobile development services, translating complex business logic into intuitive, handheld experiences.</p>
                </div>
                
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    {features.map(feature => (
                        <div class="bg-[#0a0f1d] border border-white/5 p-10 rounded-3xl hover:border-emerald-500/40 hover:bg-[#0d1425] transition-all duration-500 group">
                            <div class="w-14 h-14 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-emerald-400 mb-8 group-hover:scale-110 group-hover:bg-emerald-500 group-hover:text-[#0a0f1d] transition-all duration-300">
                                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={feature.icon} /></svg>
                            </div>
                            <h4 class="font-heading text-xl font-bold text-white mb-4 group-hover:text-emerald-400 transition-colors">{feature.title}</h4>
                            <p class="text-slate-400 text-sm leading-relaxed">{feature.desc}</p>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        {/* 4. Structured Tech Stack */}
        <section class="py-24 max-w-7xl mx-auto px-6">
            <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-8">
                <div class="max-w-2xl">
                    <h2 class="font-heading text-3xl md:text-4xl font-bold text-white mb-4">Mobile Technology Stack</h2>
                    <p class="text-slate-400 text-lg">We utilize industry-leading mobile frameworks and back-end services to guarantee App Store approval and zero-crash performance.</p>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                {/* Cross-Platform */}
                <div class="p-8 rounded-2xl bg-[#0a0f1d] border border-white/5">
                    <h3 class="text-white font-bold text-lg mb-6 border-b border-white/10 pb-4">Frameworks</h3>
                    <ul class="space-y-4">
                        <li class="flex items-center gap-3 text-slate-300"><i class="devicon-react-original colored text-2xl"></i> React Native</li>
                        <li class="flex items-center gap-3 text-slate-300"><i class="devicon-flutter-plain colored text-2xl"></i> Flutter</li>
                        <li class="flex items-center gap-3 text-slate-300"><i class="devicon-swift-plain colored text-2xl"></i> Swift (iOS)</li>
                        <li class="flex items-center gap-3 text-slate-300"><i class="devicon-kotlin-plain colored text-2xl"></i> Kotlin (Android)</li>
                    </ul>
                </div>
                {/* Backend & APIs */}
                <div class="p-8 rounded-2xl bg-[#0a0f1d] border border-white/5">
                    <h3 class="text-white font-bold text-lg mb-6 border-b border-white/10 pb-4">Backend & APIs</h3>
                    <ul class="space-y-4">
                        <li class="flex items-center gap-3 text-slate-300"><i class="devicon-nodejs-plain colored text-2xl"></i> Node.js</li>
                        <li class="flex items-center gap-3 text-slate-300"><i class="devicon-graphql-plain colored text-2xl"></i> GraphQL</li>
                        <li class="flex items-center gap-3 text-slate-300"><i class="devicon-firebase-plain colored text-2xl"></i> Firebase</li>
                        <li class="flex items-center gap-3 text-slate-300"><i class="devicon-amazonwebservices-plain-wordmark colored text-3xl"></i> AWS AppSync</li>
                    </ul>
                </div>
                {/* Database */}
                <div class="p-8 rounded-2xl bg-[#0a0f1d] border border-white/5">
                    <h3 class="text-white font-bold text-lg mb-6 border-b border-white/10 pb-4">Storage & Auth</h3>
                    <ul class="space-y-4">
                        <li class="flex items-center gap-3 text-slate-300"><i class="devicon-postgresql-plain colored text-2xl"></i> PostgreSQL</li>
                        <li class="flex items-center gap-3 text-slate-300"><i class="devicon-mongodb-plain colored text-2xl"></i> MongoDB</li>
                        <li class="flex items-center gap-3 text-slate-300"><i class="devicon-sqlite-plain colored text-2xl"></i> SQLite</li>
                        <li class="flex items-center gap-3 text-slate-300"><svg class="w-6 h-6 text-brand-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 11c0 3.517-1.009 6.799-2.753 9.571m-3.44-2.04l.054-.09A13.916 13.916 0 008 11a4 4 0 118 0c0 1.017-.07 2.019-.203 3m-2.118 6.844A21.88 21.88 0 0015.171 17m3.839 1.132c.645-2.266.99-4.659.99-7.132A8 8 0 008 4.07M3 15.364c.64-1.319 1-2.8 1-4.364 0-1.457.39-2.823 1.07-4" /></svg> Biometrics/JWT</li>
                    </ul>
                </div>
                {/* Deployment */}
                <div class="p-8 rounded-2xl bg-[#0a0f1d] border border-white/5">
                    <h3 class="text-white font-bold text-lg mb-6 border-b border-white/10 pb-4">Deployment</h3>
                    <ul class="space-y-4">
                        <li class="flex items-center gap-3 text-slate-300"><i class="devicon-apple-original text-white text-2xl"></i> App Store</li>
                        <li class="flex items-center gap-3 text-slate-300"><i class="devicon-android-plain colored text-2xl"></i> Google Play</li>
                        <li class="flex items-center gap-3 text-slate-300"><i class="devicon-github-original text-white text-2xl"></i> Fastlane / CI</li>
                        <li class="flex items-center gap-3 text-slate-300"><svg class="w-6 h-6 text-brand-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg> Crashlytics</li>
                    </ul>
                </div>
            </div>
        </section>

        {/* 5. Relevant Project Example - Litetrade */}
        <section class="py-24 bg-brand-dark border-y border-white/5">
            <div class="max-w-7xl mx-auto px-6">
                <div class="text-center mb-16">
                    <h2 class="font-heading text-sm font-bold tracking-widest text-emerald-400 uppercase mb-3">Case Study</h2>
                    <h3 class="font-heading text-3xl md:text-4xl font-bold text-white mb-4">Proven Mobile <span class="text-emerald-400">Success.</span></h3>
                </div>
                
                <div class="bg-[#0a0f1d] border border-white/5 rounded-[2.5rem] p-8 md:p-12 shadow-2xl grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
                    <div class="order-2 lg:order-1">
                        <div class="flex items-center gap-3 text-xs font-bold uppercase tracking-wider mb-6">
                            <span class="text-emerald-400">Fintech & Crypto</span>
                            <span class="text-slate-600">•</span>
                            <span class="text-slate-400">Mobile & Web App</span>
                        </div>
                        <h4 class="font-heading text-3xl lg:text-4xl font-bold text-white mb-6">Litetrade</h4>
                        <p class="text-slate-400 text-lg leading-relaxed mb-8">
                            We developed the Litetrade mobile application to enable seamless, highly secure digital asset transactions. Users can effortlessly buy and sell crypto, convert airtime to cash, and trade gift cards at top market rates through a fluid native interface.
                        </p>
                        <div class="flex flex-wrap gap-3 mb-10">
                            <span class="px-3 py-1 rounded bg-white/5 border border-white/10 text-xs text-slate-300 font-mono">React Native</span>
                            <span class="px-3 py-1 rounded bg-white/5 border border-white/10 text-xs text-slate-300 font-mono">TypeScript</span>
                            <span class="px-3 py-1 rounded bg-white/5 border border-white/10 text-xs text-slate-300 font-mono">Node.js</span>
                            <span class="px-3 py-1 rounded bg-white/5 border border-white/10 text-xs text-slate-300 font-mono">AWS</span>
                        </div>
                        <a href="/portfolio/litetrade" class="inline-flex px-8 py-4 bg-brand-accent text-brand-dark font-bold rounded-full hover:bg-white transition-all shadow-lg hover:shadow-brand-accent/20">
                            Read Full Case Study
                        </a>
                    </div>
                    <div class="order-1 lg:order-2 flex justify-center items-center">
                        <div class="relative w-full max-w-[280px] aspect-[9/19] rounded-[2.5rem] overflow-hidden border-[8px] border-[#1e293b] shadow-[0_20px_50px_rgba(0,0,0,0.5)] bg-[#020617] transform hover:-translate-y-2 transition-transform duration-500">
                            <div class="absolute top-0 left-1/2 -translate-x-1/2 w-1/2 h-5 bg-[#1e293b] rounded-b-2xl z-20"></div>
                            <img src="/assets/Litetrade.webp" alt="Litetrade Mobile App Interface" class="w-full h-full object-cover object-top" loading="lazy" />
                        </div>
                    </div>
                </div>
            </div>
        </section>

        {/* 6. Development Process - Continuous Timeline UI */}
        <section class="py-24 max-w-5xl mx-auto px-6">
            <h2 class="font-heading text-3xl md:text-4xl font-bold text-white mb-16 text-center">Our Mobile Pipeline</h2>
            
            <div class="relative max-w-4xl mx-auto">
                <div class="absolute left-[28px] md:left-1/2 top-0 bottom-0 w-0.5 bg-gradient-to-b from-brand-accent via-brand-accent/30 to-transparent md:-translate-x-1/2"></div>
                
                <div class="space-y-12">
                    {pipeline.map((item, index) => (
                        <div class="relative flex flex-col md:flex-row items-start md:items-center justify-between w-full group">
                            
                            <div class={`absolute left-0 md:left-1/2 top-0 md:top-1/2 w-14 h-14 rounded-full border-4 border-[#02040a] font-bold flex items-center justify-center z-10 md:-translate-x-1/2 md:-translate-y-1/2 transition-colors duration-300 ${item.active ? 'bg-brand-accent text-brand-dark shadow-[0_0_20px_rgba(34,211,238,0.4)]' : 'bg-[#1e293b] text-white group-hover:bg-brand-accent/50'}`}>
                                {item.step}
                            </div>
                            
                            {index % 2 === 0 ? (
                                <>
                                    <div class="w-full pl-20 md:pl-0 md:w-[calc(50%-3rem)] md:text-right md:pr-8">
                                        <div class={`p-8 rounded-3xl bg-[#0a0f1d] border shadow-xl transition-colors duration-300 text-left md:text-right ${item.active ? 'border-brand-accent/30' : 'border-white/5 group-hover:border-white/20'}`}>
                                            <h4 class="font-heading text-xl font-bold text-white mb-3">{item.title}</h4>
                                            <p class="text-base text-slate-400 leading-relaxed">{item.desc}</p>
                                        </div>
                                    </div>
                                    <div class="hidden md:block md:w-[calc(50%-3rem)]"></div>
                                </>
                            ) : (
                                <>
                                    <div class="hidden md:block md:w-[calc(50%-3rem)]"></div>
                                    <div class="w-full pl-20 md:pl-0 md:w-[calc(50%-3rem)] md:pl-8 mt-2 md:mt-0">
                                        <div class={`p-8 rounded-3xl bg-[#0a0f1d] border shadow-xl transition-colors duration-300 text-left ${item.active ? 'border-brand-accent/30' : 'border-white/5 group-hover:border-white/20'}`}>
                                            <h4 class="font-heading text-xl font-bold text-white mb-3">{item.title}</h4>
                                            <p class="text-base text-slate-400 leading-relaxed">{item.desc}</p>
                                        </div>
                                    </div>
                                </>
                            )}
                        </div>
                    ))}
                </div>
            </div>
        </section>

        {/* 7. Comprehensive FAQs - Smooth Accordion */}
        <section class="py-24 bg-brand-dark border-t border-white/5">
            <div class="max-w-4xl mx-auto px-6">
                <div class="text-center mb-16">
                    <h2 class="font-heading text-3xl md:text-4xl font-bold text-white mb-4">Frequently Asked Questions</h2>
                    <p class="text-slate-400 text-lg">Clear answers regarding our mobile engineering processes.</p>
                </div>
                
                <div class="space-y-4">
                    {faqs.map((faq, index) => (
                        <div class="faq-item bg-[#0a0f1d] border border-white/5 rounded-2xl overflow-hidden transition-colors hover:border-white/10">
                            <button class="faq-button w-full px-8 py-6 flex items-center justify-between text-left focus:outline-none focus-visible:bg-white/5" aria-expanded="false">
                                <h4 class="font-bold text-white text-lg pr-8 leading-snug">{faq.q}</h4>
                                <div class="shrink-0 relative w-6 h-6 text-brand-accent">
                                    <svg class="absolute inset-0 w-6 h-6 transform transition-transform duration-300 icon-vertical" fill="currentColor" viewBox="0 0 24 24"><rect x="11" y="4" width="2" height="16" rx="1"/></svg>
                                    <svg class="absolute inset-0 w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><rect x="4" y="11" width="16" height="2" rx="1"/></svg>
                                </div>
                            </button>
                            <div class="faq-content grid transition-all duration-300">
                                <div class="overflow-hidden">
                                    <p class="text-slate-400 leading-relaxed px-8 pb-6">
                                        {faq.a}
                                    </p>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        {/* 8. Call to Action */}
        <Cta />

    </main>

    <Footer />
</BaseLayout>

<style>
    .faq-content {
        grid-template-rows: 0fr;
    }
    .faq-item.is-open .faq-content {
        grid-template-rows: 1fr;
    }
    .faq-item.is-open .icon-vertical {
        transform: rotate(90deg) scaleY(0);
        opacity: 0;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const faqItems = document.querySelectorAll('.faq-item');
        
        faqItems.forEach(item => {
            const button = item.querySelector('.faq-button');
            if (button) {
                button.addEventListener('click', () => {
                    const isOpen = item.classList.contains('is-open');
                    
                    faqItems.forEach(i => {
                        i.classList.remove('is-open');
                        i.querySelector('.faq-button')?.setAttribute('aria-expanded', 'false');
                    });

                    if (!isOpen) {
                        item.classList.add('is-open');
                        button.setAttribute('aria-expanded', 'true');
                    }
                });
            }
        });
    });
</script>