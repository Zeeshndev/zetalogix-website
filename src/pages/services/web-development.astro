---
// src/pages/services/web-development.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/global/Navbar.astro';
import Footer from '../../components/global/Footer.astro';
import Cta from '../../components/sections/Cta.astro';

const features = [
  { 
    title: "SaaS Platforms", 
    desc: "We engineer multi-tenant architectures featuring secure subscription billing, granular role-based access control (RBAC), and isolated data environments for B2B scalability.",
    icon: "M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"
  },
  { 
    title: "Enterprise Portals", 
    desc: "Custom internal portals designed to streamline corporate operations, centralize HR management, and provide secure, authenticated access to proprietary company data.",
    icon: "M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
  },
  { 
    title: "Marketplace Platforms", 
    desc: "High-traffic, two-sided marketplaces engineered for massive concurrent user loads, featuring escrow payment integrations, real-time messaging, and advanced search algorithms.",
    icon: "M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"
  },
  { 
    title: "Admin Dashboards", 
    desc: "Data-rich, intuitive control panels that aggregate real-time analytics. We build dashboards that turn complex datasets into actionable business intelligence.",
    icon: "M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
  },
  { 
    title: "API Integrations", 
    desc: "Seamless, documented REST and GraphQL API development to connect your web application with third-party software, payment gateways, and legacy enterprise ERPs.",
    icon: "M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
  },
  { 
    title: "Cloud-Native Architecture", 
    desc: "Future-proof foundations utilizing microservices and containerization (Docker/Kubernetes) on AWS, ensuring your application auto-scales effortlessly under heavy load.",
    icon: "M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"
  }
];

const pipeline = [
  {
    step: 1,
    title: "Discovery & Architecture",
    desc: "We meticulously document your business requirements, design the scalable database schema, and finalize the optimal cloud technology stack.",
    active: true
  },
  {
    step: 2,
    title: "UI/UX Prototyping",
    desc: "Interactive wireframes and high-fidelity prototypes are designed and refined for your exact approval before a single line of code is written.",
    active: false
  },
  {
    step: 3,
    title: "Sprint Development",
    desc: "We utilize two-week agile development cycles where secure back-end APIs and responsive front-end interfaces are built, integrated, and reviewed.",
    active: false
  },
  {
    step: 4,
    title: "QA & Cloud Deployment",
    desc: "Rigorous automated testing, security vulnerability scanning, and performance profiling followed by seamless deployment to your production cloud.",
    active: false
  }
];

const faqs = [
  { 
    q: "How long does it take to build a custom enterprise web application?", 
    a: "A standard MVP (Minimum Viable Product) typically takes 8 to 12 weeks. Complex enterprise applications requiring extensive third-party API integrations, custom administrative dashboards, and stringent security compliance can take 4 to 6 months depending on the exact scope." 
  },
  { 
    q: "How do you ensure the security and privacy of our application data?", 
    a: "Security is embedded into our engineering culture. We implement industry-standard encryption (AES-256 for data at rest, TLS 1.3 for data in transit), regular vulnerability scanning, and strict role-based access controls to ensure your application meets global compliance standards like GDPR." 
  },
  { 
    q: "Will my company own the intellectual property and source code?", 
    a: "Yes. ZetaLogix operates with absolute legal transparency. Upon final delivery and settlement of the project, your company receives 100% intellectual property ownership of the production source code and database architecture." 
  },
  { 
    q: "Do you provide post-launch support, hosting, and maintenance?", 
    a: "Absolutely. Launching is just the beginning. We offer dedicated Service Level Agreements (SLAs) for ongoing maintenance, AWS cloud hosting management, uptime monitoring, and continuous feature development as your user base scales." 
  }
];
---

<BaseLayout 
    title="Web Application Development Services | ZetaLogix"
    description="ZetaLogix engineers highly scalable, secure, and custom web applications, SaaS platforms, and enterprise portals for global businesses."
>
    <Navbar />

    <main class="relative z-10 bg-[#02040a]">
        
        {/* 1. Hero Section */}
        <section class="relative pt-40 pb-24 lg:pt-48 lg:pb-32 overflow-hidden border-b border-white/5">
            <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[600px] bg-brand-accent/10 rounded-full blur-[150px] -z-10 pointer-events-none"></div>
            <div class="absolute inset-0 opacity-[0.02] bg-[radial-gradient(#ffffff_1px,transparent_1px)] [background-size:32px_32px] pointer-events-none z-0"></div>

            <div class="max-w-7xl mx-auto px-6 text-center relative z-10">
                <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/5 border border-white/10 mb-8 backdrop-blur-sm">
                    <span class="w-2 h-2 rounded-full bg-brand-accent animate-pulse"></span>
                    <span class="text-xs font-bold text-slate-300 uppercase tracking-widest">Enterprise Engineering</span>
                </div>
                
                <h1 class="font-heading text-5xl md:text-6xl lg:text-7xl font-bold text-white tracking-tight mb-8 leading-tight max-w-5xl mx-auto">
                    Scalable <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-accent to-blue-500">Web Applications</span><br class="hidden md:block" /> Built for Business Growth.
                </h1>
                
                <p class="text-xl text-slate-400 max-w-3xl mx-auto leading-relaxed mb-12">
                    We architect and engineer high-performance SaaS products, custom business portals, and secure enterprise platforms designed to streamline operations and scale globally.
                </p>

                <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
                    <a href="/contact" class="w-full sm:w-auto px-8 py-4 bg-brand-accent text-brand-dark font-bold rounded-full hover:bg-white transition-all duration-300 shadow-lg hover:shadow-brand-accent/20">
                        Discuss Your Web Project
                    </a>
                    <a href="#architecture" class="w-full sm:w-auto px-8 py-4 bg-transparent text-white font-semibold rounded-full border border-white/20 hover:bg-white/10 transition-all duration-300">
                        Explore Our Architecture
                    </a>
                </div>
            </div>
        </section>

        {/* 2. Business Problem & Solution */}
        <section id="architecture" class="py-24 lg:py-32 max-w-7xl mx-auto px-6">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
                <div class="order-2 lg:order-1">
                    <h2 class="font-heading text-sm font-bold tracking-widest text-slate-500 uppercase mb-4">The Challenge</h2>
                    <h3 class="font-heading text-3xl md:text-4xl font-bold text-white mb-6 leading-tight">
                        Generic software restricts <br class="hidden md:block" /> operational scaling.
                    </h3>
                    <p class="text-slate-400 leading-relaxed mb-8 text-lg">
                        Off-the-shelf software forces businesses to adapt their unique workflows to rigid tools. As companies scale, these generic platforms lead to operational bottlenecks, data silos, security vulnerabilities, and fragmented user experiences that severely impact revenue.
                    </p>
                    <div class="h-px w-full bg-white/10 my-8"></div>
                    <h2 class="font-heading text-sm font-bold tracking-widest text-brand-accent uppercase mb-4">The ZetaLogix Solution</h2>
                    <p class="text-slate-300 leading-relaxed text-lg">
                        We build bespoke web architecture tailored exactly to your operational demands. By leveraging modern JavaScript frameworks and cloud-native databases, we deliver lightning-fast, highly secure platforms that adapt to your business—giving you complete ownership and a distinct competitive advantage.
                    </p>
                </div>
                <div class="order-1 lg:order-2 relative">
                    <div class="absolute inset-0 bg-gradient-to-tr from-brand-accent/20 to-blue-600/20 rounded-3xl blur-2xl -z-10 translate-x-4 translate-y-4"></div>
                    <div class="bg-[#0a0f1d] border border-white/10 rounded-3xl p-8 shadow-2xl relative z-10">
                        <div class="flex items-center gap-3 mb-6 pb-6 border-b border-white/5">
                            <div class="w-3 h-3 rounded-full bg-red-500"></div>
                            <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
                            <div class="w-3 h-3 rounded-full bg-green-500"></div>
                        </div>
                        <pre class="font-mono text-sm text-slate-300 overflow-x-auto"><code><span class="text-brand-accent">import</span> &#123; EnterpriseScale &#125; <span class="text-brand-accent">from</span> '@zetalogix/core';

<span class="text-blue-400">const</span> WebApplication = () => &#123;
  <span class="text-brand-accent">return</span> (
    &lt;<span class="text-green-400">SystemArchitecture</span>
      security=&#123;<span class="text-orange-300">"SOC2_Compliant"</span>&#125;
      uptime=&#123;<span class="text-purple-400">99.99</span>&#125;
      performance=&#123;<span class="text-orange-300">"Ultra-Low_Latency"</span>&#125;
    &gt;
      &lt;<span class="text-green-400">CustomWorkflows</span> /&gt;
      &lt;<span class="text-green-400">SeamlessAPIIntegrations</span> /&gt;
    &lt;/<span class="text-green-400">SystemArchitecture</span>&gt;
  );
&#125;;</code></pre>
                    </div>
                </div>
            </div>
        </section>

        {/* 3. Core Capabilities / Features */}
        <section class="py-24 bg-brand-dark border-y border-white/5">
            <div class="max-w-7xl mx-auto px-6">
                <div class="text-center mb-20 max-w-3xl mx-auto">
                    <h2 class="font-heading text-3xl md:text-4xl font-bold text-white mb-6">What We Deliver</h2>
                    <p class="text-slate-400 text-lg">Comprehensive web development services encompassing everything from complex back-end data orchestration to pixel-perfect front-end interfaces.</p>
                </div>
                
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    {features.map(feature => (
                        <div class="bg-[#0a0f1d] border border-white/5 p-10 rounded-3xl hover:border-brand-accent/40 hover:bg-[#0d1425] transition-all duration-500 group">
                            <div class="w-14 h-14 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-brand-accent mb-8 group-hover:scale-110 group-hover:bg-brand-accent group-hover:text-brand-dark transition-all duration-300">
                                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={feature.icon} /></svg>
                            </div>
                            <h4 class="font-heading text-xl font-bold text-white mb-4 group-hover:text-brand-accent transition-colors">{feature.title}</h4>
                            <p class="text-slate-400 text-sm leading-relaxed">{feature.desc}</p>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        {/* 4. Structured Tech Stack */}
        <section class="py-24 max-w-7xl mx-auto px-6">
            <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-8">
                <div class="max-w-2xl">
                    <h2 class="font-heading text-3xl md:text-4xl font-bold text-white mb-4">Enterprise Technology Stack</h2>
                    <p class="text-slate-400 text-lg">We utilize industry-standard, production-tested technologies to ensure your platform is robust, secure, and maintainable.</p>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                <div class="p-8 rounded-2xl bg-[#0a0f1d] border border-white/5">
                    <h3 class="text-white font-bold text-lg mb-6 border-b border-white/10 pb-4">Frontend</h3>
                    <ul class="space-y-4">
                        <li class="flex items-center gap-3 text-slate-300"><i class="devicon-react-original colored text-2xl"></i> React.js</li>
                        <li class="flex items-center gap-3 text-slate-300"><i class="devicon-nextjs-plain text-white text-2xl"></i> Next.js</li>
                        <li class="flex items-center gap-3 text-slate-300"><i class="devicon-vuejs-plain colored text-2xl"></i> Vue.js</li>
                        <li class="flex items-center gap-3 text-slate-300"><i class="devicon-tailwindcss-original colored text-2xl"></i> Tailwind CSS</li>
                    </ul>
                </div>
                <div class="p-8 rounded-2xl bg-[#0a0f1d] border border-white/5">
                    <h3 class="text-white font-bold text-lg mb-6 border-b border-white/10 pb-4">Backend</h3>
                    <ul class="space-y-4">
                        <li class="flex items-center gap-3 text-slate-300"><i class="devicon-nodejs-plain colored text-2xl"></i> Node.js</li>
                        <li class="flex items-center gap-3 text-slate-300"><i class="devicon-python-plain colored text-2xl"></i> Python</li>
                        <li class="flex items-center gap-3 text-slate-300"><i class="devicon-express-original text-white text-2xl"></i> Express</li>
                        <li class="flex items-center gap-3 text-slate-300"><i class="devicon-graphql-plain colored text-2xl"></i> GraphQL</li>
                    </ul>
                </div>
                <div class="p-8 rounded-2xl bg-[#0a0f1d] border border-white/5">
                    <h3 class="text-white font-bold text-lg mb-6 border-b border-white/10 pb-4">Database</h3>
                    <ul class="space-y-4">
                        <li class="flex items-center gap-3 text-slate-300"><i class="devicon-postgresql-plain colored text-2xl"></i> PostgreSQL</li>
                        <li class="flex items-center gap-3 text-slate-300"><i class="devicon-mongodb-plain colored text-2xl"></i> MongoDB</li>
                        <li class="flex items-center gap-3 text-slate-300"><i class="devicon-mysql-plain colored text-2xl"></i> MySQL</li>
                        <li class="flex items-center gap-3 text-slate-300"><i class="devicon-redis-plain colored text-2xl"></i> Redis</li>
                    </ul>
                </div>
                <div class="p-8 rounded-2xl bg-[#0a0f1d] border border-white/5">
                    <h3 class="text-white font-bold text-lg mb-6 border-b border-white/10 pb-4">Infrastructure</h3>
                    <ul class="space-y-4">
                        <li class="flex items-center gap-3 text-slate-300"><i class="devicon-amazonwebservices-plain-wordmark colored text-3xl"></i> AWS</li>
                        <li class="flex items-center gap-3 text-slate-300"><i class="devicon-docker-plain colored text-2xl"></i> Docker</li>
                        <li class="flex items-center gap-3 text-slate-300"><i class="devicon-googlecloud-plain colored text-2xl"></i> Google Cloud</li>
                        <li class="flex items-center gap-3 text-slate-300"><i class="devicon-github-original text-white text-2xl"></i> CI/CD Pipelines</li>
                    </ul>
                </div>
            </div>
        </section>

        {/* 5. Relevant Project Example */}
        <section class="py-24 bg-brand-dark border-y border-white/5">
            <div class="max-w-7xl mx-auto px-6">
                <div class="text-center mb-16">
                    <h2 class="font-heading text-sm font-bold tracking-widest text-brand-glow uppercase mb-3">Case Study</h2>
                    <h3 class="font-heading text-3xl md:text-4xl font-bold text-white mb-4">Proven Web <span class="text-brand-accent">Success.</span></h3>
                </div>
                
                <div class="bg-[#0a0f1d] border border-white/5 rounded-[2.5rem] p-8 md:p-12 shadow-2xl grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
                    <div class="order-2 lg:order-1">
                        <div class="flex items-center gap-3 text-xs font-bold uppercase tracking-wider mb-6">
                            <span class="text-brand-accent">Rental Marketplace</span>
                            <span class="text-slate-600">•</span>
                            <span class="text-slate-400">Web Application</span>
                        </div>
                        <h4 class="font-heading text-3xl lg:text-4xl font-bold text-white mb-6">Rentischeap</h4>
                        <p class="text-slate-400 text-lg leading-relaxed mb-8">
                            We architected and deployed a global accommodation booking platform capable of handling complex short and long-term homestay reservations securely and efficiently across multiple time zones.
                        </p>
                        <div class="flex flex-wrap gap-3 mb-10">
                            <span class="px-3 py-1 rounded bg-white/5 border border-white/10 text-xs text-slate-300 font-mono">React.js</span>
                            <span class="px-3 py-1 rounded bg-white/5 border border-white/10 text-xs text-slate-300 font-mono">Node.js</span>
                            <span class="px-3 py-1 rounded bg-white/5 border border-white/10 text-xs text-slate-300 font-mono">PostgreSQL</span>
                        </div>
                        <a href="/portfolio/rentischeap" class="inline-flex px-8 py-4 bg-brand-accent text-brand-dark font-bold rounded-full hover:bg-white transition-all shadow-lg hover:shadow-brand-accent/20">
                            Read Full Case Study
                        </a>
                    </div>
                    <div class="order-1 lg:order-2 rounded-2xl overflow-hidden border border-white/10 shadow-2xl bg-[#1e293b]">
                        <div class="h-8 w-full bg-[#0f172a] border-b border-white/5 flex items-center px-4 gap-2">
                            <div class="w-2 h-2 rounded-full bg-red-500/80"></div>
                            <div class="w-2 h-2 rounded-full bg-yellow-500/80"></div>
                            <div class="w-2 h-2 rounded-full bg-green-500/80"></div>
                        </div>
                        <img src="/assets/Rentischeap.png" alt="Rentischeap Web App" class="w-full h-auto object-cover" loading="lazy" />
                    </div>
                </div>
            </div>
        </section>

        {/* 6. Development Process - Bulletproof Responsive Timeline */}
        <section class="py-24 max-w-5xl mx-auto px-6">
            <h2 class="font-heading text-3xl md:text-4xl font-bold text-white mb-16 text-center">Our Engineering Pipeline</h2>
            
            <div class="relative max-w-4xl mx-auto">
                {/* Center Line */}
                <div class="absolute left-[28px] md:left-1/2 top-0 bottom-0 w-0.5 bg-gradient-to-b from-brand-accent via-brand-accent/30 to-transparent md:-translate-x-1/2"></div>
                
                <div class="space-y-12">
                    {pipeline.map((item, index) => (
                        <div class="relative flex flex-col md:flex-row items-start md:items-center justify-between w-full group">
                            
                            {/* Number Icon */}
                            <div class={`absolute left-0 md:left-1/2 top-0 md:top-1/2 w-14 h-14 rounded-full border-4 border-[#02040a] font-bold flex items-center justify-center z-10 md:-translate-x-1/2 md:-translate-y-1/2 transition-colors duration-300 ${item.active ? 'bg-brand-accent text-brand-dark shadow-[0_0_20px_rgba(34,211,238,0.4)]' : 'bg-[#1e293b] text-white group-hover:bg-brand-accent/50'}`}>
                                {item.step}
                            </div>
                            
                            {/* Layout: Alternate Left/Right based on Index */}
                            {index % 2 === 0 ? (
                                <>
                                    <div class="w-full pl-20 md:pl-0 md:w-[calc(50%-3rem)] md:text-right md:pr-8">
                                        <div class={`p-8 rounded-3xl bg-[#0a0f1d] border shadow-xl transition-colors duration-300 text-left md:text-right ${item.active ? 'border-brand-accent/30' : 'border-white/5 group-hover:border-white/20'}`}>
                                            <h4 class="font-heading text-xl font-bold text-white mb-3">{item.title}</h4>
                                            <p class="text-base text-slate-400 leading-relaxed">{item.desc}</p>
                                        </div>
                                    </div>
                                    <div class="hidden md:block md:w-[calc(50%-3rem)]"></div>
                                </>
                            ) : (
                                <>
                                    <div class="hidden md:block md:w-[calc(50%-3rem)]"></div>
                                    <div class="w-full pl-20 md:pl-0 md:w-[calc(50%-3rem)] md:pl-8 mt-2 md:mt-0">
                                        <div class={`p-8 rounded-3xl bg-[#0a0f1d] border shadow-xl transition-colors duration-300 text-left ${item.active ? 'border-brand-accent/30' : 'border-white/5 group-hover:border-white/20'}`}>
                                            <h4 class="font-heading text-xl font-bold text-white mb-3">{item.title}</h4>
                                            <p class="text-base text-slate-400 leading-relaxed">{item.desc}</p>
                                        </div>
                                    </div>
                                </>
                            )}
                        </div>
                    ))}
                </div>
            </div>
        </section>

        {/* 7. Comprehensive FAQs - Smooth Accordion */}
        <section class="py-24 bg-brand-dark border-t border-white/5">
            <div class="max-w-4xl mx-auto px-6">
                <div class="text-center mb-16">
                    <h2 class="font-heading text-3xl md:text-4xl font-bold text-white mb-4">Frequently Asked Questions</h2>
                    <p class="text-slate-400 text-lg">Clear answers regarding our web engineering capabilities.</p>
                </div>
                
                <div class="space-y-4">
                    {faqs.map((faq, index) => (
                        <div class="faq-item bg-[#0a0f1d] border border-white/5 rounded-2xl overflow-hidden transition-colors hover:border-white/10">
                            <button class="faq-button w-full px-8 py-6 flex items-center justify-between text-left focus:outline-none focus-visible:bg-white/5" aria-expanded="false">
                                <h4 class="font-bold text-white text-lg pr-8 leading-snug">{faq.q}</h4>
                                <div class="shrink-0 relative w-6 h-6 text-brand-accent">
                                    <svg class="absolute inset-0 w-6 h-6 transform transition-transform duration-300 icon-vertical" fill="currentColor" viewBox="0 0 24 24"><rect x="11" y="4" width="2" height="16" rx="1"/></svg>
                                    <svg class="absolute inset-0 w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><rect x="4" y="11" width="16" height="2" rx="1"/></svg>
                                </div>
                            </button>
                            <div class="faq-content grid transition-all duration-300">
                                <div class="overflow-hidden">
                                    <p class="text-slate-400 leading-relaxed px-8 pb-6">
                                        {faq.a}
                                    </p>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        {/* 8. Call to Action */}
        <Cta />

    </main>

    <Footer />
</BaseLayout>

<style>
    /* CSS Grid Accordion Trick for perfectly smooth height transitions without heavy JS calculations */
    .faq-content {
        grid-template-rows: 0fr;
    }
    .faq-item.is-open .faq-content {
        grid-template-rows: 1fr;
    }
    .faq-item.is-open .icon-vertical {
        transform: rotate(90deg) scaleY(0);
        opacity: 0;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const faqItems = document.querySelectorAll('.faq-item');
        
        faqItems.forEach(item => {
            const button = item.querySelector('.faq-button');
            if (button) {
                button.addEventListener('click', () => {
                    const isOpen = item.classList.contains('is-open');
                    
                    // Close all other accordions for a clean experience
                    faqItems.forEach(i => {
                        i.classList.remove('is-open');
                        i.querySelector('.faq-button')?.setAttribute('aria-expanded', 'false');
                    });

                    // If it wasn't open, open it
                    if (!isOpen) {
                        item.classList.add('is-open');
                        button.setAttribute('aria-expanded', 'true');
                    }
                });
            }
        });
    });
</script>