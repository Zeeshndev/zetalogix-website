---
// src/pages/thank-you.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/global/Navbar.astro';
import Footer from '../components/global/Footer.astro';
---

<BaseLayout title="Thank You | ZetaLogix">
    <Navbar />
    
    <main class="pt-20 bg-brand-dark text-slate-300 min-h-[80vh] flex items-center justify-center relative overflow-hidden">
        
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-brand-accent/10 rounded-full blur-[100px] pointer-events-none"></div>

        <div class="max-w-2xl mx-auto px-6 text-center relative z-10 py-24">
            <div class="w-24 h-24 bg-green-500/10 border border-green-500/20 rounded-full flex items-center justify-center mx-auto mb-8 shadow-[0_0_30px_rgba(34,197,94,0.2)]">
                <svg class="w-12 h-12 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
            </div>

            <h1 class="text-4xl md:text-5xl font-bold text-white mb-6 font-heading">
                Request Received!
            </h1>
            
            <p class="text-lg text-slate-400 leading-relaxed mb-10">
                Thank you for reaching out to ZetaLogix. One of our senior technical consultants will review your project details and get back to you within <span class="text-white font-bold">1 business day</span>.
            </p>

            <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
                <a href="/portfolio" class="px-8 py-4 bg-brand-accent text-brand-dark font-bold rounded-xl hover:bg-white transition-all shadow-[0_0_15px_rgba(34,211,238,0.2)]">
                    View Our Case Studies
                </a>
                <a href="/" class="px-8 py-4 bg-[#121829] border border-white/5 text-white font-bold rounded-xl hover:bg-white/5 transition-all">
                    Return to Homepage
                </a>
            </div>
        </div>
    </main>

    <Footer />
</BaseLayout>