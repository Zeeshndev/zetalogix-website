---
// src/pages/thank-you.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/global/Navbar.astro';
import Footer from '../components/global/Footer.astro';
---

<BaseLayout 
    title="Thank You | ZetaLogix"
    description="Your enquiry has been successfully received by ZetaLogix."
>
    <Navbar />
    
    <main class="pt-20 bg-[#02040a] text-slate-300 min-h-[80vh] flex items-center justify-center relative overflow-hidden z-10">
        
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-brand-accent/10 rounded-full blur-[100px] pointer-events-none"></div>

        <div class="max-w-2xl mx-auto px-6 text-center relative z-10 py-24">
            <div class="w-20 h-20 bg-brand-accent/10 border border-brand-accent/20 text-brand-accent rounded-full flex items-center justify-center mx-auto mb-8 shadow-[0_0_30px_rgba(34,211,238,0.2)]">
                <svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
            </div>

            <h1 class="font-heading text-4xl md:text-5xl font-bold text-white mb-6">
                Request Received!
            </h1>
            
            <p class="text-lg text-slate-400 leading-relaxed mb-10">
                Thank you for reaching out to ZetaLogix. An engineering lead will review your project details and get back to you within <span class="text-white font-bold">1 business day</span> to outline the next steps and execute an NDA.
            </p>

            <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
                <a href="/portfolio" class="px-8 py-4 bg-brand-accent text-brand-dark font-bold rounded-xl hover:bg-white transition-all shadow-lg hover:shadow-brand-accent/20">
                    View Our Case Studies
                </a>
                <a href="/" class="px-8 py-4 bg-white/5 border border-white/10 text-white font-bold rounded-xl hover:bg-white/10 transition-all">
                    Return to Homepage
                </a>
            </div>
        </div>
    </main>

    <Footer />
</BaseLayout>