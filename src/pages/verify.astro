---
// src/pages/verify.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/global/Navbar.astro';
import Footer from '../components/global/Footer.astro';
import certificates from '../data/certificates.json';

// Enforce dynamic Server-Side Rendering (SSR)
export const prerender = false;

// Extract raw parameters
const url = new URL(Astro.request.url);
const allIds = url.searchParams.getAll('id');
let searchId = allIds.find(id => id.trim().length > 0) || '';

// Clean up the search string
searchId = searchId.trim().toUpperCase().replace(/[^A-Z0-9\-]/g, '');

// Query the JSON data ledger
const record = certificates.find(cert => {
    const cleanCertId = cert.id.trim().toUpperCase().replace(/[^A-Z0-9\-]/g, '');
    return cleanCertId === searchId;
});

const standardSearchPerformed = searchId.length > 0;
---

<BaseLayout title="Employment Verification | ZetaLogix">
    <Navbar />
    
    <main class="pt-36 pb-32 bg-[#02040a] min-h-screen text-slate-300 flex items-center justify-center">
        <div class="max-w-2xl w-full mx-auto px-6">
            
            <div class="mb-8">
                <span class="text-[10px] font-mono tracking-widest text-slate-500 uppercase block mb-1">ZetaLogix Human Resources</span>
                <h1 class="text-xl font-bold text-white tracking-tight">Employment Verification System</h1>
                <div class="h-px w-full bg-white/10 mt-4"></div>
            </div>

            {/* CASE 1: Active Record Found */}
            {standardSearchPerformed && record ? (
                <div class="bg-[#05070c] border border-white/10 rounded-xl p-8 shadow-xl">
                    <div class="flex justify-between items-center mb-8 pb-6 border-b border-white/5">
                        <div>
                            <span class="text-[10px] font-mono tracking-wider text-slate-500 uppercase block mb-1">Document Identifier</span>
                            <span class="font-mono text-sm text-white bg-white/5 px-3 py-1 rounded border border-white/10">{record.id}</span>
                        </div>
                        <div class="text-right">
                            <span class="text-[10px] font-mono tracking-wider text-slate-500 uppercase block mb-1">Record Status</span>
                            <span class={`text-xs font-mono font-bold uppercase px-3 py-1 rounded ${
                                record.status.toLowerCase().includes('active') 
                                ? 'bg-green-500/10 text-green-400 border border-green-500/20' 
                                : 'bg-blue-500/10 text-blue-400 border border-blue-500/20'
                            }`}>
                                {record.status}
                            </span>
                        </div>
                    </div>

                    <div class="space-y-6">
                        <div class="grid grid-cols-3 gap-4 py-2 border-b border-white/[0.02]">
                            <span class="text-xs font-mono text-slate-500 uppercase">Full Name</span>
                            <span class="col-span-2 text-sm font-semibold text-white">{record.name}</span>
                        </div>
                        <div class="grid grid-cols-3 gap-4 py-2 border-b border-white/[0.02]">
                            <span class="text-xs font-mono text-slate-500 uppercase">Designation</span>
                            <span class="col-span-2 text-sm text-slate-300">{record.designation}</span>
                        </div>
                        <div class="grid grid-cols-3 gap-4 py-2 border-b border-white/[0.02]">
                            <span class="text-xs font-mono text-slate-500 uppercase">Department</span>
                            <span class="col-span-2 text-sm text-slate-300">{record.department}</span>
                        </div>
                        <div class="grid grid-cols-3 gap-4 py-2 border-b border-white/[0.02]">
                            <span class="text-xs font-mono text-slate-500 uppercase">Tenure Window</span>
                            <span class="col-span-2 text-sm font-mono text-slate-300">{record.startDate} — {record.endDate}</span>
                        </div>
                        <div class="grid grid-cols-3 gap-4 py-2">
                            <span class="text-xs font-mono text-slate-500 uppercase">Last Updated</span>
                            <span class="col-span-2 text-xs text-slate-400 font-mono">{record.lastUpdated}</span>
                        </div>
                    </div>

                    <div class="mt-8 pt-6 border-t border-white/5 flex justify-start">
                        <a href="/" class="text-xs font-mono text-brand-accent hover:text-white transition-colors">← Check Another Record</a>
                    </div>
                </div>
            ) : null}

            {/* CASE 2: Query Executed, but Match Failed */}
            {standardSearchPerformed && !record ? (
                <div class="bg-[#05070c] border border-red-500/20 rounded-xl p-8 shadow-xl">
                    <div class="flex items-center gap-3 text-red-400 mb-4">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
                        <h2 class="text-sm font-mono font-bold uppercase tracking-wider">No Record Found</h2>
                    </div>
                    <p class="text-sm text-slate-400 mb-6 leading-relaxed">The identifier <code class="text-white font-mono bg-white/5 px-1.5 py-0.5 rounded">{searchId}</code> does not match any archived employment records.</p>
                    
                    <a href="/" class="text-xs font-mono text-brand-accent hover:text-white transition-colors">← Try Again</a>
                </div>
            ) : null}

            {/* CASE 3: Initial Terminal Form Input View */}
            {!standardSearchPerformed ? (
                <div class="bg-[#05070c] border border-white/5 rounded-xl p-8 shadow-xl">
                    <form id="verify-form" class="space-y-4">
                        <div>
                            <label for="cert-id" class="text-xs font-mono text-slate-400 uppercase block mb-2">Document ID</label>
                            <input 
                                type="text" 
                                id="cert-id" 
                                required 
                                placeholder="e.g. ZL-2026-XXXX" 
                                class="w-full bg-white/[0.02] border border-white/10 rounded px-4 py-3 text-white font-mono text-sm focus:outline-none focus:border-brand-accent transition-colors"
                            />
                        </div>
                        <button type="submit" class="w-full bg-white text-black font-semibold text-sm py-3 rounded hover:bg-slate-200 transition-colors">
                            Verify Record
                        </button>
                    </form>
                </div>
            ) : null}

            <div class="mt-16 text-center max-w-lg mx-auto space-y-3">
                <p class="text-xs text-slate-400 leading-relaxed font-sans tracking-wide">
                    This portal is intended solely to confirm employment status. For detailed inquiries or manual verification, contact our HR department directly:
                </p>
                <div class="pt-1">
                    <a href="mailto:hr@zetalogix.com" class="text-sm font-mono font-bold text-white bg-white/5 border border-white/10 hover:border-brand-accent hover:text-brand-accent px-4 py-2 rounded transition-all duration-200 shadow-md">
                        hr@zetalogix.com
                    </a>
                </div>
            </div>

        </div>
    </main>

    <Footer />
</BaseLayout>

<script>
    // 1. Force the input lookup element to submit via path structure instead of form mutations
    const form = document.getElementById('verify-form');
    if (form) {
        form.addEventListener('submit', (e) => {
            e.preventDefault();
            const input = document.getElementById('cert-id') as HTMLInputElement;
            if (input && input.value) {
                const cleanId = input.value.trim().toUpperCase();
                window.location.href = '/' + cleanId;
            }
        });
    }

    // 2. Navigation Fix: Append absolute base mapping to return cross-subdomain actions back to main domain
    document.addEventListener('DOMContentLoaded', () => {
        const mainDomain = 'https://zetalogix.com';
        const globalLinks = document.querySelectorAll<HTMLAnchorElement>('header a, nav a, footer a');
        
        globalLinks.forEach(link => {
            const href = link.getAttribute('href');
            if (href && (href.startsWith('/') || href.startsWith('#'))) {
                link.href = mainDomain + (href.startsWith('/') ? href : '/' + href);
            }
        });
    });
</script>