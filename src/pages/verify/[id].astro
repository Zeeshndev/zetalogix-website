---
// src/pages/verify/[id].astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/global/Navbar.astro';
import Footer from '../../components/global/Footer.astro';
import certificates from '../../data/certificates.json';

export const prerender = true;

// Generate a static route for every employee in the JSON file
export function getStaticPaths() {
  return certificates.map((cert) => ({
    params: { id: cert.id },
    props: { cert },
  }));
}

const { cert } = Astro.props;
---

<BaseLayout title={`Document Verification: ${cert.id} | ZetaLogix`}>
    <Navbar />
    
    <main class="pt-32 pb-24 bg-[#02040a] min-h-screen relative flex items-center justify-center">
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-green-500/5 rounded-full blur-[150px] pointer-events-none"></div>

        <div class="max-w-3xl w-full mx-auto px-6 relative z-10">
            
            <div class="bg-[#0a0f1d] border border-white/10 rounded-3xl p-8 md:p-12 shadow-2xl relative overflow-hidden">
                
                <div class="absolute -right-20 -bottom-20 opacity-5 pointer-events-none select-none">
                    <svg class="w-96 h-96" fill="currentColor" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                </div>

                <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6 mb-12 border-b border-white/10 pb-8">
                    <div>
                        <span class="text-[10px] font-mono tracking-widest text-slate-500 uppercase block mb-2">Verification Status</span>
                        <div class="flex items-center gap-3">
                            <div class="w-4 h-4 rounded-full bg-green-500 animate-pulse shadow-[0_0_15px_rgba(34,197,94,0.5)]"></div>
                            <h1 class="text-2xl md:text-3xl font-black text-white tracking-tight uppercase">Official Record</h1>
                        </div>
                    </div>
                    <div class="text-left md:text-right">
                        <span class="text-[10px] font-mono tracking-widest text-slate-500 uppercase block mb-1">Document ID</span>
                        <span class="text-brand-accent font-mono text-lg font-bold bg-brand-accent/10 px-4 py-1.5 rounded-lg border border-brand-accent/20">
                            {cert.id}
                        </span>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
                    <div>
                        <span class="text-xs font-bold text-slate-500 uppercase tracking-wider block mb-1">Employee Name</span>
                        <p class="text-xl font-bold text-white">{cert.name}</p>
                    </div>
                    <div>
                        <span class="text-xs font-bold text-slate-500 uppercase tracking-wider block mb-1">Designation</span>
                        <p class="text-xl font-bold text-white">{cert.designation}</p>
                    </div>
                    <div>
                        <span class="text-xs font-bold text-slate-500 uppercase tracking-wider block mb-1">Department</span>
                        <p class="text-slate-300 font-medium">{cert.department}</p>
                    </div>
                    <div>
                        <span class="text-xs font-bold text-slate-500 uppercase tracking-wider block mb-1">Employment Tenure</span>
                        <p class="text-slate-300 font-medium">{cert.startDate} — {cert.endDate}</p>
                    </div>
                </div>

                <div class="bg-white/[0.02] border border-white/5 rounded-2xl p-6 flex flex-col md:flex-row items-center justify-between gap-6">
                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 rounded-full bg-green-500/20 border border-green-500/30 flex items-center justify-center text-green-500">
                            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                        </div>
                        <div>
                            <p class="text-white font-bold text-sm">Cryptographically Verified</p>
                            <p class="text-slate-500 text-xs">Issued: {cert.issueDate}</p>
                        </div>
                    </div>
                    <div class="text-center md:text-right">
                        <p class="text-slate-400 text-xs italic mb-1">Authorized Signatory</p>
                        <p class="text-white font-bold text-sm">{cert.signatory}</p>
                    </div>
                </div>

            </div>
            
            <p class="text-center text-slate-500 text-xs mt-8 max-w-lg mx-auto leading-relaxed">
                This digital ledger is the only official verification method for ZetaLogix employment records. If the physical document details do not exactly match this secure portal, the document should be considered forged.
            </p>

        </div>
    </main>

    <Footer />
</BaseLayout>